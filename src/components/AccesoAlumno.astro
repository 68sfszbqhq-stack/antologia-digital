---
// Puerta de entrada del alumno al diagnóstico de un módulo.
//
// Decide cuál de estas cuatro cosas ve, en este orden:
//   1. No ha entrado         → le pide matrícula y código
//   2. El módulo está cerrado → se lo dice y no muestra preguntas
//   3. Ya lo contestó         → le muestra su calificación, sin dejarlo repetir
//   4. Todo en orden          → destapa el cuestionario
//
// Si Firebase todavía no está configurado, se hace a un lado y el cuestionario
// funciona como siempre, sin guardar nada. Así el sitio nunca queda roto por
// una configuración a medias.

import { u } from "../lib/url";

interface Props {
  dia: number;
}
const { dia } = Astro.props;
---

<div id="aa" data-dia={dia}>

  <!-- Verificando quién eres -->
  <div id="aa-cargando" class="glass-card rounded-2xl p-8 border border-white/10 mb-8 text-center">
    <div class="inline-block w-6 h-6 border-2 border-cyan-400/30 border-t-cyan-400 rounded-full animate-spin"></div>
    <p class="text-sm text-slate-400 mt-3 font-mono-tech">Verificando tu acceso…</p>
  </div>

  <!-- Identificarse -->
  <div id="aa-login" class="hidden glass-card rounded-2xl p-6 sm:p-8 border border-white/10 mb-8">
    <div class="max-w-md mx-auto">
      <span class="text-xs font-mono-tech text-cyan-400 uppercase tracking-widest block mb-1">// Identifícate</span>
      <h2 class="text-2xl font-bold text-white mb-2">Antes de empezar</h2>
      <p class="text-sm text-slate-400 mb-6">
        Entra con la misma cuenta de Google que usaste en la evaluación de inicio
        de ciclo. Solo tienes que hacerlo una vez: este dispositivo te va a
        recordar en los demás módulos.
      </p>

      <button
        id="aa-google" type="button"
        class="w-full flex items-center justify-center gap-3 rounded-xl bg-white text-slate-800 font-semibold
               px-4 py-3.5 text-sm hover:bg-slate-100 transition disabled:opacity-60"
      >
        <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.6l6.7-6.7C35.6 2.6 30.2 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.8 6.1C12.3 13.2 17.7 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.5 24.6c0-1.6-.1-3.1-.4-4.6H24v9.1h12.7c-.6 3-2.3 5.5-4.8 7.2l7.5 5.8c4.4-4.1 7.1-10.1 7.1-17.5z"/>
          <path fill="#FBBC05" d="M10.4 28.7c-.5-1.5-.8-3-.8-4.7s.3-3.2.8-4.7l-7.8-6.1C.9 16.4 0 20.1 0 24s.9 7.6 2.6 10.8l7.8-6.1z"/>
          <path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.5-5.8c-2.1 1.4-4.8 2.2-8.4 2.2-6.3 0-11.7-3.7-13.6-9.8l-7.8 6.1C6.5 42.6 14.6 48 24 48z"/>
        </svg>
        <span id="aa-google-texto">Entrar con Google</span>
      </button>

      <p id="aa-error-login" class="hidden text-sm text-rose-400 bg-rose-500/10 border border-rose-500/20 rounded-xl px-4 py-3 mt-4"></p>

      <!-- La entrada de siempre, para quien no tenga cuenta de Google. Se deja
           plegada: es la excepción, no el camino normal. -->
      <details class="mt-6 group">
        <summary class="text-xs font-mono-tech text-slate-500 hover:text-slate-300 cursor-pointer list-none flex items-center gap-2">
          <span class="transition-transform group-open:rotate-90">›</span>
          No tengo cuenta de Google
        </summary>

        <form id="aa-form" class="space-y-4 mt-5" novalidate>
          <div>
            <label for="aa-matricula" class="text-xs font-mono-tech text-slate-400 uppercase tracking-wider block mb-1.5">
              Matrícula
            </label>
            <input
              id="aa-matricula" name="matricula" type="text"
              autocomplete="username" inputmode="numeric" autocapitalize="off" spellcheck="false"
              placeholder="2024001"
              class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white font-mono-tech
                     placeholder:text-slate-600 focus:outline-none focus:border-cyan-400/50 focus:bg-white/[0.07] transition"
            />
          </div>

          <div>
            <label for="aa-codigo" class="text-xs font-mono-tech text-slate-400 uppercase tracking-wider block mb-1.5">
              Código de acceso
            </label>
            <input
              id="aa-codigo" name="codigo" type="password"
              autocomplete="current-password" autocapitalize="characters" spellcheck="false"
              placeholder="XXXXXXXX"
              class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white font-mono-tech tracking-[0.2em]
                     placeholder:text-slate-600 placeholder:tracking-normal focus:outline-none focus:border-cyan-400/50 focus:bg-white/[0.07] transition"
            />
            <p class="text-[11px] text-slate-500 mt-1.5">
              No importa si lo escribes con mayúsculas o minúsculas.
            </p>
          </div>

          <button id="aa-entrar" type="submit" class="btn-primary w-full justify-center py-3 text-sm font-semibold">
            Entrar
          </button>
        </form>
      </details>

      <p class="text-[11px] text-slate-600 mt-5 leading-relaxed">
        ¿No te deja entrar? Avísale a tu profesor.
      </p>
    </div>
  </div>

  <!-- Primera vez: de qué grupo eres -->
  <div id="aa-datos" class="hidden glass-card rounded-2xl p-6 sm:p-8 border border-white/10 mb-8">
    <div class="max-w-md mx-auto">
      <span class="text-xs font-mono-tech text-cyan-400 uppercase tracking-widest block mb-1">// Una sola vez</span>
      <h2 class="text-2xl font-bold text-white mb-2">¿Quién eres?</h2>
      <p class="text-sm text-slate-400 mb-6">
        No encontré tus datos de la evaluación de inicio de ciclo, así que te
        los pido una sola vez: tu nombre y tu grupo, para que tus calificaciones
        lleguen a la lista correcta. No te lo voy a volver a preguntar.
      </p>

      <form id="aa-datos-form" class="space-y-4" novalidate>
        <div>
          <label for="aa-nombre" class="text-xs font-mono-tech text-slate-400 uppercase tracking-wider block mb-1.5">
            Nombre completo
          </label>
          <input
            id="aa-nombre" name="nombre" type="text" required
            autocomplete="name" autocapitalize="words" spellcheck="false"
            placeholder="Apellidos y nombre"
            class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white
                   placeholder:text-slate-600 focus:outline-none focus:border-cyan-400/50 focus:bg-white/[0.07] transition"
          />
          <p class="text-[11px] text-slate-500 mt-1.5">
            Como aparece en la lista de asistencia: primero apellidos.
          </p>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div>
            <label for="aa-grado" class="text-xs font-mono-tech text-slate-400 uppercase tracking-wider block mb-1.5">
              Grado
            </label>
            <select
              id="aa-grado" name="grado"
              class="w-full bg-white/5 border border-white/10 rounded-xl px-3 py-3 text-white font-mono-tech
                     focus:outline-none focus:border-cyan-400/50 transition"
            >
              <option value="1º">1º</option>
              <option value="2º">2º</option>
              <option value="3º">3º</option>
            </select>
          </div>

          <div>
            <label for="aa-grupo" class="text-xs font-mono-tech text-slate-400 uppercase tracking-wider block mb-1.5">
              Grupo
            </label>
            <input
              id="aa-grupo" name="grupo" type="text" value="A" maxlength="3"
              autocapitalize="characters" spellcheck="false"
              class="w-full bg-white/5 border border-white/10 rounded-xl px-3 py-3 text-white font-mono-tech uppercase
                     focus:outline-none focus:border-cyan-400/50 transition"
            />
          </div>

          <div>
            <label for="aa-turno" class="text-xs font-mono-tech text-slate-400 uppercase tracking-wider block mb-1.5">
              Turno
            </label>
            <select
              id="aa-turno" name="turno"
              class="w-full bg-white/5 border border-white/10 rounded-xl px-3 py-3 text-white font-mono-tech
                     focus:outline-none focus:border-cyan-400/50 transition"
            >
              <option value="Vesp">Vesp.</option>
              <option value="Mat">Mat.</option>
            </select>
          </div>
        </div>

        <p id="aa-datos-error" class="hidden text-sm text-rose-400 bg-rose-500/10 border border-rose-500/20 rounded-xl px-4 py-3"></p>

        <button id="aa-datos-guardar" type="submit" class="btn-primary w-full justify-center py-3 text-sm font-semibold">
          Continuar
        </button>
      </form>

      <button id="aa-datos-salir" type="button" class="text-xs font-mono-tech text-slate-500 hover:text-rose-400 transition mt-5">
        Esa no es mi cuenta
      </button>
    </div>
  </div>

  <!-- Entró el profesor, no un alumno -->
  <div id="aa-profesor" class="hidden glass-card rounded-2xl p-8 border border-cyan-500/25 mb-8 text-center">
    <div class="text-3xl mb-3">👋</div>
    <h2 class="text-xl font-bold text-white mb-2">Entraste con tu cuenta de profesor</h2>
    <p class="text-sm text-slate-400 max-w-md mx-auto mb-5">
      Aquí es donde tus alumnos contestan el diagnóstico. Sus calificaciones y el
      interruptor de cada módulo están en el panel.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href={u("/profesor")} class="btn-primary px-6 py-2.5 text-xs font-mono-tech">
        Ir al panel
      </a>
      <button id="aa-profesor-salir" type="button" class="text-xs font-mono-tech text-slate-500 hover:text-rose-400 transition">
        Salir de esta cuenta
      </button>
    </div>
  </div>

  <!-- El profesor todavía no abre este módulo -->
  <div id="aa-cerrado" class="hidden glass-card rounded-2xl p-8 border border-amber-500/20 mb-8 text-center">
    <div class="text-3xl mb-3">🔒</div>
    <h2 class="text-xl font-bold text-white mb-2">Este cuestionario aún no está abierto</h2>
    <p class="text-sm text-slate-400 max-w-md mx-auto">
      Tu profesor lo habilita cuando toque la clase de este módulo. Mientras
      tanto puedes leer el resto del material sin problema.
    </p>
  </div>

  <!-- No se pudo verificar (sin conexión, o algo mal configurado) -->
  <div id="aa-error" class="hidden glass-card rounded-2xl p-8 border border-rose-500/25 mb-8 text-center">
    <div class="text-3xl mb-3">⚠️</div>
    <h2 class="text-xl font-bold text-white mb-2">No pude verificar tu acceso</h2>
    <p class="text-sm text-slate-400 max-w-md mx-auto mb-5">
      Puede ser que se haya caído tu conexión. El cuestionario no se muestra
      porque tus respuestas no se podrían guardar.
    </p>
    <button id="aa-reintentar" type="button" class="btn-primary px-6 py-2.5 text-xs font-mono-tech">
      Reintentar
    </button>
  </div>

  <!-- Ya lo contestó -->
  <div id="aa-hecho" class="hidden glass-card rounded-2xl p-8 border border-emerald-500/20 mb-8 text-center">
    <div class="text-3xl mb-3">✅</div>
    <h2 class="text-xl font-bold text-white mb-1">Ya contestaste este diagnóstico</h2>
    <p class="text-sm text-slate-400 mb-6">Solo se permite un intento por módulo.</p>

    <div class="inline-flex items-baseline gap-2 bg-emerald-500/10 border border-emerald-500/25 rounded-2xl px-8 py-5">
      <span id="aa-hecho-puntaje" class="text-4xl font-black text-emerald-400 font-mono-tech">—</span>
      <span class="text-sm text-slate-400 font-mono-tech">aciertos</span>
    </div>
    <p id="aa-hecho-fecha" class="text-xs text-slate-500 font-mono-tech mt-4"></p>

    <!-- Lo atiende el script de [dia].astro (data-action="step"). Solo aparece
         si el intento guardado trae las respuestas con que armar el consejo. -->
    <div id="aa-hecho-analisis" class="hidden mt-6">
      <button type="button" data-action="step" data-step="2" class="btn-primary px-6 py-2.5 text-xs font-mono-tech">
        Ver mi análisis y mi consejo →
      </button>
    </div>
  </div>

  <!-- Barra de sesión: aparece cuando ya entró -->
  <div id="aa-barra" class="hidden flex items-center justify-between gap-4 mb-6 px-4 py-2.5 rounded-xl bg-white/[0.03] border border-white/5">
    <span class="text-xs font-mono-tech text-slate-400 truncate">
      <span class="text-cyan-400">●</span>
      <span id="aa-barra-nombre" class="text-slate-300"></span>
      <span id="aa-barra-grupo" class="text-slate-600"></span>
    </span>
    <button id="aa-salir" type="button" class="text-xs font-mono-tech text-slate-500 hover:text-rose-400 transition flex-shrink-0">
      No soy yo
    </button>
  </div>

  <!-- Aviso de guardado, tras entregar -->
  <div id="aa-guardado" class="hidden mb-6 px-4 py-3 rounded-xl text-sm"></div>
</div>

<script>
  import { firebaseConfigurado, auth } from "../lib/firebase";
  import {
    entrar, entrarConGoogle, sesionPorRedireccion, esCuentaDeGoogle,
    salir, observarSesion, esProfesor, fichaDe, crearMiFicha,
    datosDelDiagnostico, modulosAbiertos,
    intentoPrevio, guardarIntento, mensajeDeError, type Ficha,
  } from "../lib/alumno";
  import type { User } from "firebase/auth";

  // El sitio usa View Transitions, así que al navegar entre módulos el script
  // no se vuelve a ejecutar solo: hay que colgarse de astro:page-load.
  document.addEventListener("astro:page-load", iniciar);

  let dejarDeObservar: (() => void) | null = null;

  function ver(id: string, visible: boolean) {
    document.getElementById(id)?.classList.toggle("hidden", !visible);
  }

  /** El cuestionario vive fuera de este componente, en la propia página. */
  function verQuiz(visible: boolean) {
    document.getElementById("step-1-quiz")?.classList.toggle("hidden", !visible);
  }

  function soloUnEstado(visible: string | null) {
    for (const id of ["aa-cargando", "aa-login", "aa-datos", "aa-profesor", "aa-cerrado", "aa-hecho", "aa-error"]) {
      ver(id, id === visible);
    }
    verQuiz(visible === null);
  }

  function iniciar() {
    const raiz = document.getElementById("aa");
    if (!raiz) return; // no estamos en una página de módulo

    const dia = Number(raiz.dataset.dia);

    // Sin Firebase configurado: el cuestionario se comporta como antes de todo
    // esto. Nada se guarda, pero nada se rompe.
    if (!firebaseConfigurado()) {
      soloUnEstado(null);
      ver("aa-barra", false);
      return;
    }

    // Quien entró por redirección (teléfono viejo, o el enlace abierto dentro
    // de WhatsApp) vuelve aquí con la sesión lista. Sin esto parecería que no
    // entró. No estorba a nadie más: si no venía de una redirección, no hace
    // nada.
    sesionPorRedireccion();

    dejarDeObservar?.();
    dejarDeObservar = observarSesion((u) => decidirQueMostrar(u, dia));
    prepararGoogle();
    prepararFormulario(dia);
    prepararDatos(dia);
    prepararSalir();
    prepararReintentar();
    escucharEntrega(dia);
  }

  // ─── Qué ve el alumno ──────────────────────────────────────────────────────

  async function decidirQueMostrar(u: User | null, dia: number) {
    if (!u) {
      soloUnEstado("aa-login");
      ver("aa-barra", false);
      return;
    }

    soloUnEstado("aa-cargando");

    try {
      const [ficha, abiertos, previo] = await Promise.all([
        fichaDe(u.uid),
        modulosAbiertos(),
        intentoPrevio(u.uid, dia),
      ]);

      // Primera vez de quien entra con Google: todavía no tiene ficha, y sin
      // ficha activa las reglas no le van a aceptar ninguna entrega.
      //
      // Antes de preguntarle nada se buscan sus datos en la evaluación
      // diagnóstica de inicio de ciclo: entró con esta misma cuenta y ya
      // escribió ahí su nombre y su grupo. Si aparecen, la ficha se crea sola y
      // el alumno pasa derecho al cuestionario sin enterarse.
      //
      // Solo se le pregunta a quien no hizo aquella evaluación. Y esto no aplica
      // a la entrada con matrícula y código: esa ficha ya existe, la creó el
      // profesor al darlo de alta.
      // El profesor entra aquí a revisar, no a contestar. Si se le pidieran
      // nombre y grupo acabaría dado de alta en su propia lista.
      if (!ficha && esProfesor(u)) {
        soloUnEstado("aa-profesor");
        ver("aa-barra", false);
        return;
      }

      if (!ficha && esCuentaDeGoogle(u)) {
        const nueva = await fichaAutomatica(u);
        if (!nueva) {
          soloUnEstado("aa-datos");
          ver("aa-barra", false);
          proponerNombre(u);
          return;
        }
        mostrarBarra(nueva);
      } else {
        mostrarBarra(ficha);
      }

      if (previo) {
        soloUnEstado("aa-hecho");
        pintarIntentoPrevio(previo);
        return;
      }

      if (!abiertos.includes(dia)) {
        soloUnEstado("aa-cerrado");
        return;
      }

      soloUnEstado(null);
    } catch {
      // Si no se puede verificar, NO se muestra el cuestionario. Dejarlo pasar
      // suena más amable, pero es peor: el alumno contestaría diez preguntas
      // para que el guardado fallara al final, o entraría a un módulo cerrado.
      // Mejor decirlo de frente y ofrecer reintentar.
      soloUnEstado("aa-error");
    }
  }

  /** Copia los datos del diagnóstico de inicio de ciclo, si los hay. Devuelve
   *  la ficha recién creada, o null si hay que preguntarle al alumno. */
  async function fichaAutomatica(u: User): Promise<Ficha | null> {
    const datos = await datosDelDiagnostico(u);
    if (!datos) return null;
    try {
      return await crearMiFicha(u, datos.nombre, datos.grupo);
    } catch {
      // Si la ficha no se pudo crear sola, se le pregunta. Es peor dejarlo
      // parado frente a un error que no puede resolver.
      return null;
    }
  }

  function mostrarBarra(ficha: Ficha | null) {
    const nombre = document.getElementById("aa-barra-nombre");
    const grupo = document.getElementById("aa-barra-grupo");
    if (nombre) nombre.textContent = ficha?.nombre ?? "Sesión iniciada";
    if (grupo) grupo.textContent = ficha?.grupo ? `· ${ficha.grupo}` : "";
    ver("aa-barra", true);
  }

  function pintarIntentoPrevio(previo: any) {
    const puntaje = document.getElementById("aa-hecho-puntaje");
    if (puntaje) puntaje.textContent = `${previo.aciertos} / ${previo.total}`;

    const fecha = document.getElementById("aa-hecho-fecha");
    if (fecha && previo.enviado?.toDate) {
      fecha.textContent = "Entregado el " + previo.enviado.toDate().toLocaleString("es-MX", {
        day: "numeric", month: "long", year: "numeric", hour: "2-digit", minute: "2-digit",
      });
    }

    // Con las respuestas guardadas, la pestaña de resultados arma el análisis y
    // el consejo igual que el día que contestó. No se entrega nada otra vez: el
    // script de [dia].astro marca el intento como ya entregado.
    const conRespuestas = Array.isArray(previo.respuestas) && previo.respuestas.length === previo.total;
    ver("aa-hecho-analisis", conRespuestas);
    if (conRespuestas) {
      document.dispatchEvent(new CustomEvent("antologia:intento-previo", {
        detail: { respuestas: previo.respuestas },
      }));
    }
  }

  // ─── Entrar y salir ────────────────────────────────────────────────────────

  function prepararFormulario(dia: number) {
    const form = document.getElementById("aa-form") as HTMLFormElement | null;
    const boton = document.getElementById("aa-entrar") as HTMLButtonElement | null;
    const error = document.getElementById("aa-error-login");
    if (!form || form.dataset.listo) return;
    form.dataset.listo = "1";

    form.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      const matricula = (document.getElementById("aa-matricula") as HTMLInputElement).value;
      const codigo = (document.getElementById("aa-codigo") as HTMLInputElement).value;

      if (!matricula.trim() || !codigo.trim()) {
        mostrarError(error, "Escribe tu matrícula y tu código.");
        return;
      }

      if (boton) { boton.disabled = true; boton.textContent = "Entrando…"; }
      error?.classList.add("hidden");

      try {
        await entrar(matricula, codigo);
        // observarSesion se encarga del resto.
      } catch (e) {
        mostrarError(error, mensajeDeError(e));
        (document.getElementById("aa-codigo") as HTMLInputElement).value = "";
      } finally {
        if (boton) { boton.disabled = false; boton.textContent = "Entrar"; }
      }
    });
  }

  function prepararGoogle() {
    const boton = document.getElementById("aa-google") as HTMLButtonElement | null;
    const texto = document.getElementById("aa-google-texto");
    const error = document.getElementById("aa-error-login");
    if (!boton || boton.dataset.listo) return;
    boton.dataset.listo = "1";

    boton.addEventListener("click", async () => {
      boton.disabled = true;
      if (texto) texto.textContent = "Abriendo Google…";
      error?.classList.add("hidden");

      try {
        await entrarConGoogle();
        // Si abrió ventana emergente, observarSesion se encarga del resto.
        // Si se fue por redirección, esta página ya no existe.
      } catch (e) {
        mostrarError(error, mensajeDeError(e));
      } finally {
        boton.disabled = false;
        if (texto) texto.textContent = "Entrar con Google";
      }
    });
  }

  /** Propone el nombre que Google ya conoce, para que el alumno no lo teclee.
   *  Lo puede corregir: en las listas de la escuela van primero los apellidos. */
  function proponerNombre(u: User) {
    const campo = document.getElementById("aa-nombre") as HTMLInputElement | null;
    if (campo && !campo.value.trim()) campo.value = u.displayName ?? "";
  }

  function prepararDatos(dia: number) {
    const form = document.getElementById("aa-datos-form") as HTMLFormElement | null;
    const boton = document.getElementById("aa-datos-guardar") as HTMLButtonElement | null;
    const error = document.getElementById("aa-datos-error");
    const salirse = document.getElementById("aa-datos-salir");

    if (salirse && !salirse.dataset.listo) {
      salirse.dataset.listo = "1";
      salirse.addEventListener("click", async () => {
        await salir();
        location.reload();
      });
    }

    if (!form || form.dataset.listo) return;
    form.dataset.listo = "1";

    form.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      const usuario = auth().currentUser;
      if (!usuario) return;

      const nombre = (document.getElementById("aa-nombre") as HTMLInputElement).value.trim();
      const grado = (document.getElementById("aa-grado") as HTMLSelectElement).value;
      const letra = (document.getElementById("aa-grupo") as HTMLInputElement).value.trim().toUpperCase();
      const turno = (document.getElementById("aa-turno") as HTMLSelectElement).value;

      if (nombre.length < 3) {
        mostrarError(error, "Escribe tu nombre completo.");
        return;
      }
      if (!letra) {
        mostrarError(error, "Escribe la letra de tu grupo.");
        return;
      }

      if (boton) { boton.disabled = true; boton.textContent = "Guardando…"; }
      error?.classList.add("hidden");

      try {
        await crearMiFicha(usuario, nombre, `${grado} ${letra} ${turno}`);
        await decidirQueMostrar(usuario, dia);
      } catch (e) {
        mostrarError(error, mensajeDeError(e));
      } finally {
        if (boton) { boton.disabled = false; boton.textContent = "Continuar"; }
      }
    });
  }

  function mostrarError(el: HTMLElement | null, texto: string) {
    if (!el) return;
    el.textContent = texto;
    el.classList.remove("hidden");
  }

  function prepararReintentar() {
    const boton = document.getElementById("aa-reintentar");
    if (!boton || boton.dataset.listo) return;
    boton.dataset.listo = "1";
    boton.addEventListener("click", () => location.reload());
  }

  function prepararSalir() {
    const delProfesor = document.getElementById("aa-profesor-salir");
    if (delProfesor && !delProfesor.dataset.listo) {
      delProfesor.dataset.listo = "1";
      delProfesor.addEventListener("click", async () => {
        await salir();
        location.reload();
      });
    }

    const boton = document.getElementById("aa-salir");
    if (!boton || boton.dataset.listo) return;
    boton.dataset.listo = "1";
    boton.addEventListener("click", async () => {
      await salir();
      location.reload();
    });
  }

  // ─── Guardar el diagnóstico ────────────────────────────────────────────────

  function escucharEntrega(dia: number) {
    if (document.body.dataset.aaEscuchando) return;
    document.body.dataset.aaEscuchando = "1";

    document.addEventListener("antologia:diagnostico-terminado", (async (ev: CustomEvent) => {
      if (!firebaseConfigurado()) return;

      const aviso = document.getElementById("aa-guardado");
      const usuario = auth().currentUser;
      if (!usuario || !aviso) return;

      aviso.className = "mb-6 px-4 py-3 rounded-xl text-sm bg-white/5 border border-white/10 text-slate-400";
      aviso.textContent = "Guardando tus respuestas…";
      aviso.classList.remove("hidden");

      try {
        await guardarIntento(usuario.uid, { dia, ...ev.detail });
        aviso.className = "mb-6 px-4 py-3 rounded-xl text-sm bg-emerald-500/10 border border-emerald-500/25 text-emerald-300";
        aviso.textContent = "✅ Listo, tus respuestas quedaron registradas.";
      } catch (e) {
        aviso.className = "mb-6 px-4 py-3 rounded-xl text-sm bg-rose-500/10 border border-rose-500/25 text-rose-300";
        aviso.textContent = "⚠️ " + mensajeDeError(e) + " Avísale a tu profesor antes de cerrar la página.";
      }
    }) as EventListener);
  }
</script>
