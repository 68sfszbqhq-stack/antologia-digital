---
import "../styles/global.css";
import ClientRouter from "astro/components/ClientRouter.astro";
import sesiones from "../data/sesiones.json";
import { u } from "../lib/url";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Inicio",
  description = "Plataforma educativa de bachillerato. Aprende con sesiones digitales interactivas.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Roboto+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href={u("/favicon.svg")} />
    <title>{title} | BGOCCVESP Plataforma Digital</title>

    <!--
      REMIENDOS PARA TELÉFONOS VIEJOS.
      ================================
      Esto lo usan alumnos de bachillerato con el teléfono que tienen: gama baja,
      Android viejo, un Chrome que no se actualiza desde hace años. Aquí se
      rellenan a mano las funciones que esos navegadores no traen y que el
      compilador NO puede resolver solo (él arregla la sintaxis, no las funciones
      que falten).

      Va `is:inline` y en el <head> a propósito: así se copia tal cual, sin pasar
      por el empaquetador, y corre ANTES que todo lo demás. Por eso está escrito
      en JavaScript viejo —nada de => ni de const— porque si este archivo usara
      algo moderno moriría justo en los navegadores que viene a rescatar.

      Cuando falta una de estas funciones el navegador no avisa: deja la página
      EN BLANCO. El alumno solo sabe que "no puede entrar".
    -->
    <script is:inline>
      (function () {
        // globalThis — Chrome 71. Lo usan Firebase y pdf.js.
        if (typeof globalThis === 'undefined') {
          Object.defineProperty(Object.prototype, '__gt__', {
            get: function () { return this; }, configurable: true
          });
          __gt__.globalThis = __gt__;
          delete Object.prototype.__gt__;
        }

        // Promise.withResolvers — Chrome 119, de finales de 2023. Es la que más
        // daño hacía: la usa pdf.js, o sea el cuadernillo de primer año.
        if (typeof Promise !== 'undefined' && !Promise.withResolvers) {
          Promise.withResolvers = function () {
            var res, rej;
            var p = new Promise(function (a, b) { res = a; rej = b; });
            return { promise: p, resolve: res, reject: rej };
          };
        }

        // String.prototype.replaceAll — Chrome 85. La usa Firebase.
        if (!String.prototype.replaceAll) {
          String.prototype.replaceAll = function (busca, pone) {
            if (Object.prototype.toString.call(busca) === '[object RegExp]') {
              return this.replace(busca, pone);
            }
            return this.split(busca).join(pone);
          };
        }

        // Array.prototype.at y String.prototype.at — Chrome 92.
        if (!Array.prototype.at) {
          Array.prototype.at = function (i) {
            i = Math.trunc(i) || 0;
            if (i < 0) i += this.length;
            return (i < 0 || i >= this.length) ? undefined : this[i];
          };
        }
        if (!String.prototype.at) {
          String.prototype.at = function (i) {
            i = Math.trunc(i) || 0;
            if (i < 0) i += this.length;
            return (i < 0 || i >= this.length) ? undefined : this.charAt(i);
          };
        }

        // Object.hasOwn — Chrome 93.
        if (!Object.hasOwn) {
          Object.hasOwn = function (o, k) {
            return Object.prototype.hasOwnProperty.call(o, k);
          };
        }

        // structuredClone — Chrome 98. La copia por JSON no sirve para todo,
        // pero sí para lo que este sitio guarda: números, textos y listas.
        if (typeof structuredClone === 'undefined') {
          window.structuredClone = function (v) { return JSON.parse(JSON.stringify(v)); };
        }
      })();
    </script>

    <ClientRouter />
  </head>

  <body class="min-h-screen hero-gradient">

    <!-- ─── HEADER GLASSMORPHISM ─── -->
    <header
      class="glass fixed top-0 left-0 right-0 z-50"
      style="border-bottom: 1px solid rgba(255,255,255,0.05);"
      transition:persist
    >
      <nav class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">

        <!-- Logo -->
        <a href={u("/")} class="flex items-center gap-3 group" aria-label="Inicio BGOCCVESP Plataforma Digital">
          <div
            class="w-8 h-8 rounded-lg border border-cyan-400/50 flex items-center justify-center bg-cyan-400/10 group-hover:bg-cyan-400/20 transition-all duration-300"
            style="box-shadow: 0 0 12px rgba(0,245,255,0.15);"
          >
            <svg
              width="16" height="16" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2"
              class="text-cyan-400"
            >
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
          </div>
          <span class="font-bold text-sm tracking-widest font-mono-tech">
            <span class="gradient-text">BGOCCVESP</span>
            <span class="text-white/40 ml-1 hidden sm:inline">PLATAFORMA DIGITAL</span>
          </span>
        </a>

        <div class="flex items-center gap-3">
          <!-- Atajo a lo que más se usa. En pantalla chica se esconde: ahí todo
               vive dentro del menú, que es justo para lo que existe. -->
          <a href={u("/diagnostico")} class="btn-primary hidden sm:inline-flex" aria-label="Ir a la evaluación diagnóstica">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M9 11l3 3L22 4"></path>
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
            </svg>
            Evaluación
          </a>

          <!-- La hamburguesa está en TODOS los tamaños, no solo en móvil: es el
               índice completo del sitio, y en escritorio no cabría en la barra
               sin volverla ilegible. -->
          <button
            type="button"
            data-menu-abrir
            class="w-10 h-10 rounded-lg border border-white/10 flex items-center justify-center text-slate-300 hover:text-cyan-400 hover:border-cyan-400/40 hover:bg-cyan-400/5 transition-all duration-200"
            aria-label="Abrir el menú"
            aria-expanded="false"
            aria-controls="menu-principal"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <!-- ─── MENÚ DESPLEGABLE ─── -->
    <!--
      Es el índice del sitio entero: la antología por un lado y las evaluaciones
      por otro, que son las dos cosas distintas que se hacen aquí. Los módulos
      van como etiquetas y no como lista larga porque son ocho y así caben de
      un vistazo, sin desplazarse.
    -->
    <div
      id="menu-principal"
      data-menu
      hidden
      class="fixed inset-0 z-[60]"
      transition:persist
    >
      <div data-menu-fondo class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>

      <div
        class="glass absolute top-0 right-0 h-full w-full sm:w-[26rem] overflow-y-auto"
        style="border-left: 1px solid rgba(255,255,255,0.08);"
        role="dialog"
        aria-modal="true"
        aria-label="Menú principal"
      >
        <div class="flex items-center justify-between h-16 px-6" style="border-bottom: 1px solid rgba(255,255,255,0.05);">
          <span class="text-xs font-mono-tech text-slate-500 uppercase tracking-widest">Índice</span>
          <button
            type="button"
            data-menu-cerrar
            class="w-9 h-9 rounded-lg border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:border-white/30 transition"
            aria-label="Cerrar el menú"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="px-6 py-7 space-y-8">

          <!-- Antología -->
          <section>
            <a
              href={u("/#modulos")}
              class="flex items-start gap-3 group mb-4"
            >
              <span class="mt-0.5 w-8 h-8 shrink-0 rounded-lg border border-cyan-400/40 bg-cyan-400/10 flex items-center justify-center">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-cyan-400">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
              </span>
              <span>
                <span class="block font-bold text-white group-hover:text-cyan-400 transition">
                  Antología de Cultura Digital
                </span>
                <span class="block text-xs text-slate-500 mt-0.5">
                  Ocho módulos con lecturas, videos y actividades.
                </span>
              </span>
            </a>

            <div class="flex flex-wrap gap-1.5 pl-11">
              {sesiones.map((m) => (
                <a
                  href={u(`/sesion/${m.dia}`)}
                  class="text-[11px] font-mono-tech px-2.5 py-1.5 rounded-lg bg-white/5 text-slate-300 border border-white/5 hover:border-cyan-400/40 hover:text-cyan-400 hover:bg-cyan-400/5 transition"
                  title={m.titulo}
                >
                  {m.modulo.replace("Módulo ", "")} · {m.titulo}
                </a>
              ))}
            </div>
          </section>

          <!-- Evaluaciones -->
          <section>
            <span class="text-xs font-mono-tech text-slate-600 uppercase tracking-widest block mb-3">
              // Evaluaciones
            </span>

            <div class="space-y-2">
              <a
                href={u("/diagnostico")}
                class="flex items-start gap-3 rounded-xl p-3 border border-white/10 hover:border-cyan-400/40 hover:bg-cyan-400/5 transition group"
              >
                <span class="mt-0.5 w-8 h-8 shrink-0 rounded-lg border border-cyan-400/40 bg-cyan-400/10 flex items-center justify-center">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-cyan-400">
                    <path d="M9 11l3 3L22 4"></path>
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                  </svg>
                </span>
                <span>
                  <span class="block text-sm font-semibold text-white group-hover:text-cyan-400 transition">
                    Evaluación diagnóstica
                  </span>
                  <span class="block text-xs text-slate-500 mt-0.5">
                    Datos, atención, temperamento y la evaluación de tu grado, de corrido.
                  </span>
                </span>
              </a>

              <a
                href={u("/landolt")}
                class="flex items-start gap-3 rounded-xl p-3 border border-white/10 hover:border-violet-400/40 hover:bg-violet-400/5 transition group"
              >
                <span class="mt-0.5 w-8 h-8 shrink-0 rounded-lg border border-violet-400/40 bg-violet-400/10 flex items-center justify-center">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-violet-400">
                    <circle cx="12" cy="12" r="8"></circle>
                    <path d="M12 4v4"></path>
                  </svg>
                </span>
                <span>
                  <span class="block text-sm font-semibold text-white group-hover:text-violet-400 transition">
                    Test de atención
                  </span>
                  <span class="block text-xs text-slate-500 mt-0.5">
                    Solo los Anillos de Landolt, por separado.
                  </span>
                </span>
              </a>

              <a
                href={u("/expediente")}
                class="flex items-start gap-3 rounded-xl p-3 border border-white/10 hover:border-emerald-400/40 hover:bg-emerald-400/5 transition group"
              >
                <span class="mt-0.5 w-8 h-8 shrink-0 rounded-lg border border-emerald-400/40 bg-emerald-400/10 flex items-center justify-center">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-400">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  </svg>
                </span>
                <span>
                  <span class="block text-sm font-semibold text-white group-hover:text-emerald-400 transition">
                    Cuestionario de nuevo ingreso
                  </span>
                  <span class="block text-xs text-slate-500 mt-0.5">
                    Lo contestan los padres, en casa, con un folio.
                  </span>
                </span>
              </a>
            </div>
          </section>

          <!-- Profesor -->
          <section style="border-top: 1px solid rgba(255,255,255,0.05);" class="pt-6">
            <!-- El panel se protege con las reglas de Firestore, no escondiendo
                 el enlace: quien entre sin permiso no ve absolutamente nada. -->
            <div class="flex flex-col gap-2">
              <a href={u("/profesor")} class="text-xs font-mono-tech text-slate-600 hover:text-cyan-400 transition">
                Panel del profesor →
              </a>
              <a href={u("/coordinacion")} class="text-xs font-mono-tech text-slate-600 hover:text-cyan-400 transition">
                Panel de coordinación →
              </a>
            </div>
          </section>
        </div>
      </div>
    </div>

    <!-- ─── MAIN CONTENT ─── -->
    <main class="pt-16">
      <slot />
    </main>

    <!-- ─── FOOTER ─── -->
    <footer style="border-top: 1px solid rgba(255,255,255,0.05);" class="mt-24">
      <div class="max-w-7xl mx-auto px-6 py-10 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div
            class="w-6 h-6 rounded border border-cyan-400/20 flex items-center justify-center"
            style="background: rgba(0,245,255,0.04);"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-cyan-400/40">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
          </div>
          <span class="text-xs font-mono-tech text-slate-700 tracking-wider">BGOCCVESP PLATAFORMA DIGITAL &copy; 2024</span>
        </div>
        <div class="flex items-center gap-5">
          <p class="text-xs text-slate-700 font-mono-tech tracking-wide">
            Construido para mentes inquietas de Puebla, México
          </p>
        </div>
      </div>
    </footer>

    <script>
      /*
       * El menú, sin framework.
       *
       * Dos cuidados que no se ven en el código pero explican su forma:
       *
       *   1. El header y el menú llevan `transition:persist`, así que sobreviven
       *      a los cambios de página. Si se colgaran los escuchas en cada
       *      `astro:page-load`, se acumularían y el menú acabaría abriéndose y
       *      cerrándose varias veces de un solo clic. Por eso se cuelgan UNA vez
       *      del documento, con una bandera, y se usa delegación.
       *   2. Al navegar hay que cerrarlo a mano: como el nodo persiste, quedaría
       *      abierto encima de la página nueva.
       */
      const w = window as any;

      function cerrarMenu() {
        const menu = document.querySelector("[data-menu]") as HTMLElement | null;
        const boton = document.querySelector("[data-menu-abrir]");
        if (!menu) return;
        menu.hidden = true;
        document.body.style.overflow = "";
        boton?.setAttribute("aria-expanded", "false");
      }

      function abrirMenu() {
        const menu = document.querySelector("[data-menu]") as HTMLElement | null;
        const boton = document.querySelector("[data-menu-abrir]");
        if (!menu) return;
        menu.hidden = false;
        // Sin esto, el fondo se sigue desplazando detrás del panel.
        document.body.style.overflow = "hidden";
        boton?.setAttribute("aria-expanded", "true");
        (menu.querySelector("[data-menu-cerrar]") as HTMLElement | null)?.focus();
      }

      if (!w.__menuAntologia) {
        w.__menuAntologia = true;

        document.addEventListener("click", (e) => {
          const t = e.target as HTMLElement;
          if (t.closest("[data-menu-abrir]")) { abrirMenu(); return; }
          if (t.closest("[data-menu-cerrar]") || t.closest("[data-menu-fondo]")) { cerrarMenu(); return; }
          // Un enlace del menú: se cierra solo. Con View Transitions la página
          // cambia sin recargar, así que nadie lo cerraría por nosotros.
          if (t.closest("[data-menu] a")) cerrarMenu();
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") cerrarMenu();
        });

        document.addEventListener("astro:page-load", cerrarMenu);
      }
    </script>

  </body>
</html>
