---
// Diagnóstico integral de inicio de ciclo: datos → atención → temperamento →
// evaluación académica del grado.
//
// Es una sesión sola y seguida, no un menú de pruebas sueltas. El alumno entra
// una vez, elige su grado y sale con todo contestado. Las páginas `/landolt` y
// `/expediente` siguen existiendo para aplicarse por separado cuando hace falta
// solo una de ellas.
//
// Todo es React con client:only porque necesita reloj, clics y almacenamiento
// del navegador: no hay nada que renderizar en el servidor.
import Layout from "../layouts/Layout.astro";
import DiagnosticoIntegral from "../components/DiagnosticoIntegral.jsx";
import { u } from "../lib/url";
---

<Layout
  title="Evaluación diagnóstica"
  description="Evaluación diagnóstica de inicio de ciclo: atención, temperamento y conocimientos previos por grado."
>
  <div class="max-w-3xl mx-auto px-5 sm:px-6 py-10 sm:py-12">

    <nav class="text-xs font-mono-tech text-slate-500 mb-8">
      <a href={u("/")} class="hover:text-cyan-400 transition">Inicio</a>
      <span class="mx-2">/</span>
      <span class="text-slate-400">Evaluación diagnóstica</span>
    </nav>

    <header class="mb-8">
      <span class="text-xs font-mono-tech text-cyan-400 uppercase tracking-widest block mb-2">
        // Inicio de ciclo
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-white mb-4 leading-tight">
        Evaluación diagnóstica
      </h1>
      <p class="text-slate-400 leading-relaxed text-sm sm:text-base">
        Son tres partes seguidas: un test de atención con reloj, un test de
        temperamento sin respuestas correctas y la evaluación de conocimientos
        de tu grado. Toma entre 30 y 45 minutos. Contéstalo de corrido, sin
        salirte de la página.
      </p>
    </header>

    <DiagnosticoIntegral client:only="react" />

    <!--
      LA RED DE SEGURIDAD.
      ====================
      Toda esta página es JavaScript: si el navegador del alumno no logra
      ejecutarlo, no ve un error, ve un HUECO EN BLANCO. Y un hueco en blanco no
      se puede reportar: el alumno solo dice "no me deja entrar", que es
      exactamente lo que estaba pasando.

      Esto vigila y, si a los ocho segundos no se dibujó nada, saca un mensaje
      que sí se entiende y que además dice QUÉ falló, para poder arreglarlo.
    -->
    <div id="respaldo-navegador" hidden class="glass-card rounded-2xl p-6 border border-amber-400/40">
      <h2 class="text-lg font-bold text-amber-300 mb-2">Tu navegador no pudo abrir la evaluación</h2>
      <p class="text-sm text-slate-300 leading-relaxed mb-4">
        Casi siempre es porque el navegador está desactualizado, o porque abriste
        el enlace dentro de WhatsApp. Prueba esto, en orden:
      </p>
      <ol class="text-sm text-slate-400 leading-relaxed space-y-2 mb-5 list-decimal pl-5">
        <li>
          Si llegaste desde WhatsApp, toca los tres puntos de arriba y elige
          <strong class="text-slate-200">«Abrir en el navegador»</strong>.
        </li>
        <li>
          Abre <strong class="text-slate-200">Chrome</strong> y actualízalo desde
          la Play Store si te lo pide.
        </li>
        <li>Intenta desde otro teléfono o desde una computadora de la escuela.</li>
      </ol>
      <p class="text-xs text-slate-500 leading-relaxed">
        Si nada funciona, muéstrale esto a tu profesor:
      </p>
      <p id="respaldo-detalle" class="text-[11px] font-mono-tech text-slate-600 mt-2 break-words"></p>
    </div>

    <script is:inline>
      /* Escrito en JavaScript viejo a propósito: si esto usara algo moderno
         moriría justo en los navegadores que viene a rescatar. */
      (function () {
        var motivo = '';

        window.addEventListener('error', function (e) {
          if (!motivo) motivo = (e && e.message) ? e.message : 'error al cargar';
        });
        window.addEventListener('unhandledrejection', function (e) {
          if (!motivo && e && e.reason) motivo = String(e.reason).slice(0, 200);
        });

        setTimeout(function () {
          var isla = document.querySelector('astro-island');
          // Si la isla de React pintó algo, todo bien: no se hace nada.
          if (isla && isla.children.length > 0) return;

          var caja = document.getElementById('respaldo-navegador');
          if (!caja) return;
          caja.hidden = false;

          var d = document.getElementById('respaldo-detalle');
          if (d) {
            d.textContent =
              (motivo || 'la página no cargó') +
              ' — ' + navigator.userAgent;
          }
        }, 8000);
      })();
    </script>

  </div>
</Layout>
