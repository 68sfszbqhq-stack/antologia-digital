---
// Diagnóstico integral de inicio de ciclo: datos → atención → temperamento →
// evaluación académica del grado.
//
// Es una sesión sola y seguida, no un menú de pruebas sueltas. El alumno entra
// una vez, elige su grado y sale con todo contestado. Las páginas `/landolt` y
// `/expediente` siguen existiendo para aplicarse por separado cuando hace falta
// solo una de ellas.
//
// Todo es React con client:only porque necesita reloj, clics y almacenamiento
// del navegador: no hay nada que renderizar en el servidor.
import Layout from "../layouts/Layout.astro";
import DiagnosticoIntegral from "../components/DiagnosticoIntegral.jsx";
import { u } from "../lib/url";
---

<Layout
  title="Evaluación diagnóstica"
  description="Evaluación diagnóstica de inicio de ciclo: atención, temperamento y conocimientos previos por grado."
>
  <div class="max-w-3xl mx-auto px-5 sm:px-6 py-10 sm:py-12">

    <nav class="text-xs font-mono-tech text-slate-500 mb-8">
      <a href={u("/")} class="hover:text-cyan-400 transition">Inicio</a>
      <span class="mx-2">/</span>
      <span class="text-slate-400">Evaluación diagnóstica</span>
    </nav>

    <header class="mb-8">
      <span class="text-xs font-mono-tech text-cyan-400 uppercase tracking-widest block mb-2">
        // Inicio de ciclo
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-white mb-4 leading-tight">
        Evaluación diagnóstica
      </h1>
      <p class="text-slate-400 leading-relaxed text-sm sm:text-base">
        Son tres partes seguidas: un test de atención con reloj, un test de
        temperamento sin respuestas correctas y la evaluación de conocimientos
        de tu grado. Toma entre 30 y 45 minutos. Contéstalo de corrido, sin
        salirte de la página.
      </p>
    </header>

    <DiagnosticoIntegral client:only="react" />

  </div>
</Layout>
