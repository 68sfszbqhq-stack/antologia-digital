---
import Layout from "../layouts/Layout.astro";
import sesiones from "../data/sesiones.json";
import { u } from "../lib/url";

// Color mappings for Cultura Digital categories
const categoryColors: Record<string, { border: string; text: string; bg: string; glow: string }> = {
  "Hardware & Software":      { border: "border-cyan-500/40",    text: "text-cyan-400",    bg: "bg-cyan-500/10",    glow: "card-glow-cyan" },
  "Licencias & Redes":        { border: "border-violet-500/40",  text: "text-violet-400",  bg: "bg-violet-500/10",  glow: "card-glow-violet" },
  "Sociedad & Ética":         { border: "border-amber-500/40",   text: "text-amber-400",   bg: "bg-amber-500/10",   glow: "card-glow-violet" },
  "Software Libre":           { border: "border-emerald-500/40", text: "text-emerald-400", bg: "bg-emerald-500/10", glow: "card-glow-cyan" },
  "Seguridad & IA":           { border: "border-rose-500/40",    text: "text-rose-400",    bg: "bg-rose-500/10",    glow: "card-glow-violet" },
  "Ciudadanía Digital":       { border: "border-teal-500/40",    text: "text-teal-400",    bg: "bg-teal-500/10",    glow: "card-glow-cyan" },
  "Pensamiento Algorítmico":  { border: "border-blue-500/40",    text: "text-blue-400",    bg: "bg-blue-500/10",    glow: "card-glow-cyan" },
  "Lógica de Programación":   { border: "border-purple-500/40",  text: "text-purple-400",  bg: "bg-purple-500/10",  glow: "card-glow-violet" },
};

function getColor(cat: string) {
  return categoryColors[cat] ?? { border: "border-cyan-500/40", text: "text-cyan-400", bg: "bg-cyan-500/10", glow: "card-glow-cyan" };
}

function resourceTypeIcon(tipo: string): string {
  if (tipo === "YouTube") {
    return `<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="inline-block"><path d="M23 7s-.3-1.9-1.2-2.7c-1.1-1.2-2.4-1.2-3-1.3C16.2 3 12 3 12 3s-4.2 0-6.8.1c-.6.1-1.9.1-3 1.3C1.3 5.1 1 7 1 7S.7 9.1.7 11.2v1.9c0 2.1.3 4.2.3 4.2s.3 1.9 1.2 2.7c1.1 1.2 2.6 1.1 3.3 1.2C7.2 21.4 12 21.4 12 21.4s4.2 0 6.8-.2c.6-.1 1.9-.1 3-1.3.9-.8 1.2-2.7 1.2-2.7s.3-2.1.3-4.2v-1.9C23.3 9.1 23 7 23 7zM9.7 15.5V8.4l8.1 3.6-8.1 3.5z"/></svg>`;
  }
  if (tipo === "Lectura") {
    return `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="inline-block"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>`;
  }
  return `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="inline-block"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>`;
}
---

<Layout title="Cultura Digital" description="Antología Educativa de Cultura Digital para Bachillerato. Módulos 1.1 al 1.8: Hardware, Software Libre, Ética, Algoritmos y Seguridad.">

  <!-- ─── HERO ─── -->
  <section class="relative overflow-hidden hero-gradient grid-dot-bg min-h-[85vh] flex items-center">

    <!-- Ambient glows -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full opacity-[0.08]" style="background: radial-gradient(circle, #00f5ff 0%, transparent 70%); filter: blur(70px);"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full opacity-[0.08]" style="background: radial-gradient(circle, #a855f7 0%, transparent 70%); filter: blur(70px);"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-6 py-28 text-center">

      <!-- Eyebrow Tag -->
      <div class="inline-flex items-center gap-2.5 mb-6 px-4 py-2 rounded-full glass border border-cyan-400/30">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse inline-block"></span>
        <span class="text-xs font-mono-tech text-cyan-400 tracking-widest uppercase">Asignatura · Cultura Digital</span>
      </div>

      <!-- Main Title -->
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-black tracking-tight leading-none mb-6">
        <span class="block text-white">Antología Digital</span>
        <span class="block gradient-text mt-2">Módulos 1.1 — 1.8</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-base md:text-xl text-slate-400 max-w-3xl mx-auto mb-10 leading-relaxed font-light">
        Plataforma tecnológica interactiva para estudiantes de bachillerato. Desde la evolución del hardware y el software libre, hasta el impacto social de las Big Tech, la ciberseguridad y el pensamiento algorítmico.
      </p>

      <!-- CTA Action buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="#modulos" class="btn-primary text-base px-7 py-3.5">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          Explorar Módulos
        </a>
        <a
          href="#modulos"
          class="text-sm font-semibold text-slate-400 hover:text-white transition-colors duration-200 flex items-center gap-2 px-4 py-3"
        >
          Ver mapa curricular
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Metrics / Features bar -->
      <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
        {[
          { value: "8", label: "Módulos" },
          { value: "40+", label: "Temas Clave" },
          { value: "24+", label: "Recursos Interactivos" },
          { value: "5", label: "Fases Formativas" },
        ].map((stat) => (
          <div class="glass-card rounded-xl p-4 border border-white/5">
            <div class="text-2xl md:text-3xl font-black gradient-text">{stat.value}</div>
            <div class="text-xs text-slate-500 font-mono-tech mt-1 tracking-wide uppercase">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── MODULES GRID ─── -->
  <section id="modulos" class="max-w-7xl mx-auto px-6 py-20">

    <!-- Section header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12">
      <div>
        <p class="text-xs font-mono-tech text-cyan-400 tracking-widest uppercase mb-2">// Contenido del Programa</p>
        <h2 class="text-3xl md:text-4xl font-black text-white">Módulos de Cultura Digital</h2>
      </div>
      <p class="text-sm text-slate-500 max-w-md">
        Haz clic en cualquier módulo para acceder a sus lecturas, videos explicativos, actividades formativas y transversales.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6">
      {sesiones.map((modulo) => {
        const color = getColor(modulo.categoria);
        const youtubeCount = modulo.recursos.filter(r => r.tipo === "YouTube").length;
        const lecturaCount = modulo.recursos.filter(r => r.tipo === "Lectura").length;
        const actividadCount = modulo.recursos.filter(r => r.tipo === "Actividad").length;
        return (
          <a
            href={u(`/sesion/${modulo.dia}`)}
            class={`glass-card rounded-2xl p-7 border transition-all duration-300 group cursor-pointer block hover:-translate-y-1 ${color.border} ${color.glow}`}
            aria-label={`Ir al ${modulo.modulo}: ${modulo.titulo}`}
          >
            <!-- Top Row: Module Badge & Category -->
            <div class="flex items-center justify-between gap-3 mb-4">
              <div class="flex items-center gap-3">
                <span class={`font-black font-mono-tech text-xs px-3 py-1.5 rounded-lg border ${color.bg} ${color.text} ${color.border}`}>
                  {modulo.modulo}
                </span>
                <span class="text-xs font-mono-tech text-slate-500 uppercase tracking-wider">
                  {modulo.categoria}
                </span>
              </div>
              <div class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center opacity-40 group-hover:opacity-100 group-hover:border-cyan-400/50 group-hover:bg-cyan-400/10 transition-all duration-300">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#00f5ff" stroke-width="2.5">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
            </div>

            <!-- Title -->
            <h3 class="text-xl font-bold text-white leading-snug mb-3 group-hover:text-cyan-400 transition-colors duration-200">
              {modulo.titulo}
            </h3>

            <!-- Purpose -->
            <p class="text-xs md:text-sm text-slate-400 leading-relaxed mb-6 line-clamp-3">
              {modulo.proposito}
            </p>

            <!-- Topics Preview Tags -->
            <div class="mb-6">
              <span class="text-[10px] font-mono-tech text-slate-600 uppercase tracking-widest block mb-2">// Temas Clave</span>
              <div class="flex flex-wrap gap-1.5">
                {modulo.temas.slice(0, 4).map((tema) => (
                  <span class="text-[11px] font-mono-tech px-2.5 py-1 rounded bg-white/5 text-slate-300 border border-white/5">
                    {tema}
                  </span>
                ))}
                {modulo.temas.length > 4 && (
                  <span class="text-[11px] font-mono-tech px-2 py-1 rounded bg-white/5 text-cyan-400/80 border border-white/5">
                    +{modulo.temas.length - 4} más
                  </span>
                )}
              </div>
            </div>

            <!-- Footer Meta -->
            <div class="flex items-center justify-between pt-4 border-t border-white/5 text-xs font-mono-tech">
              <!-- Resource Pills -->
              <div class="flex items-center gap-3">
                {youtubeCount > 0 && (
                  <span class="flex items-center gap-1 text-red-400/90">
                    <Fragment set:html={resourceTypeIcon("YouTube")} />
                    {youtubeCount} video
                  </span>
                )}
                {lecturaCount > 0 && (
                  <span class="flex items-center gap-1 text-sky-400/90">
                    <Fragment set:html={resourceTypeIcon("Lectura")} />
                    {lecturaCount} lectura
                  </span>
                )}
                {actividadCount > 0 && (
                  <span class="flex items-center gap-1 text-emerald-400/90">
                    <Fragment set:html={resourceTypeIcon("Actividad")} />
                    {actividadCount} actividad
                  </span>
                )}
              </div>

              <!-- Duration -->
              <span class="text-slate-500">
                {modulo.duracion}
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

</Layout>
