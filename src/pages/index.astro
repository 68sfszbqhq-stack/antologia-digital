---
// Portada: bienvenida y avisos, nada más.
//
// Las materias ya no viven aquí sino en el menú hamburguesa (Layout.astro),
// cada una en su propia página. Los avisos salen de src/data/avisos.ts.
import Layout from "../layouts/Layout.astro";
import { avisos, type Etiqueta } from "../data/avisos";
import { u } from "../lib/url";

const coloresEtiqueta: Record<Etiqueta, string> = {
  "General":               "text-cyan-400 bg-cyan-500/10 border-cyan-500/30",
  "Cultura Digital":       "text-violet-400 bg-violet-500/10 border-violet-500/30",
  "Lengua y Comunicación": "text-amber-400 bg-amber-500/10 border-amber-500/30",
  "Evaluaciones":          "text-emerald-400 bg-emerald-500/10 border-emerald-500/30",
};

// UTC a propósito: "2026-09-10" leído en hora local podría caer el día 9.
const formatoFecha = new Intl.DateTimeFormat("es-MX", {
  day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
});

// Si una fecha viene mal escrita, que falle al construir con un mensaje claro
// y no que se publique "Invalid Date" en la portada.
const lista = avisos
  .map((a) => {
    const d = new Date(`${a.fecha}T00:00:00Z`);
    if (Number.isNaN(d.getTime())) {
      throw new Error(`Aviso "${a.titulo}": la fecha debe ir como AAAA-MM-DD (llegó "${a.fecha}").`);
    }
    return { ...a, d };
  })
  .sort((a, b) => Number(!!b.fijado) - Number(!!a.fijado) || b.d.getTime() - a.d.getTime());

const esExterno = (href: string) => /^https?:\/\//.test(href);
---

<Layout title="Inicio" description="BGOCCVESP Plataforma Digital: avisos de la escuela y material de Cultura Digital y Lengua y Comunicación.">

  <!-- ─── BIENVENIDA ─── -->
  <section class="relative overflow-hidden hero-gradient grid-dot-bg">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full opacity-[0.08]" style="background: radial-gradient(circle, #00f5ff 0%, transparent 70%); filter: blur(70px);"></div>
      <div class="absolute bottom-0 right-1/4 w-96 h-96 rounded-full opacity-[0.08]" style="background: radial-gradient(circle, #a855f7 0%, transparent 70%); filter: blur(70px);"></div>
    </div>

    <div class="relative max-w-4xl mx-auto px-6 pt-24 pb-20 text-center">
      <div class="inline-flex items-center gap-2.5 mb-6 px-4 py-2 rounded-full glass border border-cyan-400/30">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse inline-block"></span>
        <span class="text-xs font-mono-tech text-cyan-400 tracking-widest uppercase">Bienvenida</span>
      </div>

      <h1 class="text-5xl md:text-7xl font-black tracking-tight leading-none mb-6">
        <span class="block text-white">BGOCCVESP</span>
        <span class="block gradient-text text-2xl md:text-4xl tracking-widest mt-4">PLATAFORMA DIGITAL</span>
      </h1>

      <p class="text-base md:text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed font-light">
        Qué gusto tenerte aquí. En esta página se publican los avisos de la
        escuela, y en el menú encuentras el material de tus materias:
        Cultura Digital y Lengua y Comunicación.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <!-- Abre el mismo menú del encabezado: el script de Layout.astro
             escucha cualquier elemento con data-menu-abrir. -->
        <button type="button" data-menu-abrir class="btn-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          Ver mis materias
        </button>
        <a href="#avisos" class="text-sm font-semibold text-slate-400 hover:text-cyan-400 transition px-4 py-2">
          Leer los avisos ↓
        </a>
      </div>
    </div>
  </section>

  <!-- ─── AVISOS ─── -->
  <section id="avisos" class="max-w-3xl mx-auto px-6 py-16 scroll-mt-20">
    <div class="mb-10">
      <p class="text-xs font-mono-tech text-cyan-400 tracking-widest uppercase mb-2">// Avisos de la escuela</p>
      <h2 class="text-3xl md:text-4xl font-black text-white">Anuncios</h2>
    </div>

    {lista.length === 0 ? (
      <p class="glass-card rounded-2xl p-8 text-center text-slate-500">
        Por ahora no hay avisos publicados.
      </p>
    ) : (
      <div class="space-y-5">
        {lista.map((a) => (
          <article class={`glass-card rounded-2xl p-6 md:p-7 border ${a.fijado ? "border-cyan-500/40" : "border-white/5"}`}>
            <div class="flex flex-wrap items-center gap-2 mb-3 text-xs font-mono-tech">
              {a.fijado && (
                <span class="px-2 py-1 rounded border text-cyan-300 bg-cyan-400/10 border-cyan-400/40 uppercase tracking-wider">
                  Fijado
                </span>
              )}
              {a.etiqueta && (
                <span class={`px-2 py-1 rounded border ${coloresEtiqueta[a.etiqueta]}`}>
                  {a.etiqueta}
                </span>
              )}
              <time datetime={a.fecha} class="text-slate-500">{formatoFecha.format(a.d)}</time>
            </div>

            <h3 class="text-xl font-bold text-white leading-snug mb-3">{a.titulo}</h3>

            <div class="space-y-3 text-sm md:text-base text-slate-400 leading-relaxed">
              {a.texto.split(/\n\s*\n/).map((parrafo) => <p>{parrafo}</p>)}
            </div>

            {a.enlace && (
              <a
                href={u(a.enlace.href)}
                class="inline-flex items-center gap-1.5 mt-5 text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition"
                {...(esExterno(a.enlace.href) ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                {a.enlace.texto}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            )}
          </article>
        ))}
      </div>
    )}
  </section>

</Layout>
