---
// Introducción a Lengua y Comunicación: presentación para proyectar en clase.
//
// Retoma los dos libros que el grupo ya leyó (Los cuatro acuerdos, de Miguel
// Ruiz, e Influencia, de Robert Cialdini) y los amarra con los temas de la
// antología. Es un archivo fijo, así que tiene prioridad sobre [tema].astro;
// no usar "introduccion" como slug de un tema.
//
// Se maneja con flechas, espacio o los botones; "F" o el botón la pone en
// pantalla completa. El script se cuelga de astro:page-load (View Transitions).
import Layout from "../../layouts/Layout.astro";
import { u } from "../../lib/url";

const acuerdos = [
  {
    n: 1,
    titulo: "Sé impecable con tus palabras",
    significa:
      "Di lo que de verdad piensas y cumple lo que dices. No uses tus palabras para dañar a otros… ni a ti.",
    ejemplo:
      "Reenvías un sticker burlándote de un compañero «solo de broma». En un minuto ya está en 40 celulares y no hay forma de borrarlo.",
    cambia:
      "Si cumples tu palabra, la gente te cree. Y tu voz interior deja de sabotearte: «soy malo para exponer» se vuelve «todavía no domino exponer».",
  },
  {
    n: 2,
    titulo: "No te tomes nada personalmente",
    significa:
      "Lo que otros dicen y hacen habla más de ellos (su día, su carácter, sus problemas) que de ti.",
    ejemplo:
      "Tu amiga te deja en visto y piensas «está enojada conmigo». Quizá se quedó sin datos, estaba en examen o simplemente estaba cansada.",
    cambia:
      "Menos dramas. Puedes escuchar una crítica a tu trabajo sin sentir que te atacan a ti, y respondes en lugar de reaccionar.",
  },
  {
    n: 3,
    titulo: "No hagas suposiciones",
    significa:
      "Cuando no sabes algo, pregunta. Llenar los huecos con lo que imaginas es el origen de casi todos los malentendidos.",
    ejemplo:
      "El profe pide «un trabajo para el lunes» y nadie pregunta la extensión. La mitad entrega una hoja y la otra mitad diez.",
    cambia:
      "Una pregunta a tiempo te ahorra horas de trabajo repetido y muchos pleitos. Preguntar no es verse tonto: es comunicarse bien.",
  },
  {
    n: 4,
    titulo: "Haz siempre lo máximo que puedas",
    significa:
      "Tu máximo cambia según el día: no es igual descansado que enfermo. Lo importante es dar lo que hoy sí puedes.",
    ejemplo:
      "Dormiste cuatro horas. Tu máximo de hoy es entregar la tarea completa aunque no quede perfecta, no rendirte ni desvelarte otra vez.",
    cambia:
      "Te quitas la culpa y también la flojera. Este acuerdo sostiene a los otros tres: nadie los cumple perfecto, pero sí se practican.",
  },
];

const principios = [
  { nombre: "Reciprocidad", idea: "Sentimos que debemos devolver lo que nos dan.", ejemplo: "La muestra gratis del súper; «te pasé la tarea, ahora préstame tu cuenta»." },
  { nombre: "Compromiso y coherencia", idea: "Si ya dijimos «sí» a algo chico, nos cuesta decir «no» a algo grande.", ejemplo: "«¿Me ayudas con una pregunta?»… y acabas haciendo todo el trabajo." },
  { nombre: "Prueba social", idea: "Si muchos lo hacen, suponemos que está bien.", ejemplo: "El reto viral peligroso; «el más vendido»; los likes." },
  { nombre: "Simpatía", idea: "Le decimos que sí a quien nos cae bien o se parece a nosotros.", ejemplo: "El influencer que «es igualito a ti» y te recomienda un producto." },
  { nombre: "Autoridad", idea: "Obedecemos a quien parece experto.", ejemplo: "La bata blanca en el anuncio; la cuenta con palomita azul." },
  { nombre: "Escasez", idea: "Lo que se acaba nos parece más valioso.", ejemplo: "«Solo quedan 2», «la oferta termina en 10 minutos»." },
  { nombre: "Unidad", idea: "Le creemos más a los «nuestros».", ejemplo: "«Entre paisanos nos ayudamos», «somos del mismo equipo»." },
];

const temasRelacionados = [
  { slug: "asertividad", titulo: "Asertividad", liga: "Acuerdo 1: decir lo que piensas sin herir." },
  { slug: "retroalimentacion", titulo: "Dar y recibir retroalimentación", liga: "Acuerdo 2: la crítica es sobre el trabajo, no sobre ti." },
  { slug: "el-arte-de-preguntar", titulo: "El arte de preguntar", liga: "Acuerdo 3: preguntar en vez de suponer." },
  { slug: "barreras-psicologicas", titulo: "Barreras psicológicas", liga: "Suposiciones y prejuicios que deforman el mensaje." },
  { slug: "adaptacion-a-la-audiencia", titulo: "Adaptación a la audiencia", liga: "Cialdini: convencer con ética, conociendo al público." },
  { slug: "ciberseguridad-basica", titulo: "Ciberseguridad básica", liga: "Cialdini: los fraudes usan urgencia, autoridad y unidad." },
];
---

<Layout title="Introducción · Lengua y Comunicación" description="Presentación de inicio de Lengua y Comunicación: Los cuatro acuerdos de Miguel Ruiz e Influencia de Robert Cialdini, con ejemplos de la vida diaria.">

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10">

    <nav class="text-xs font-mono-tech text-slate-500 mb-6">
      <a href={u("/")} class="hover:text-cyan-400 transition">Inicio</a>
      <span class="mx-2">/</span>
      <a href={u("/lengua-y-comunicacion")} class="hover:text-cyan-400 transition">Lengua y Comunicación</a>
      <span class="mx-2">/</span>
      <span class="text-slate-400">Introducción</span>
    </nav>

    <div data-deck class="deck relative rounded-3xl border border-white/10 bg-slate-950/80 overflow-hidden">

      <!-- 1 · Portada -->
      <article class="slide" data-slide>
        <p class="kicker text-amber-400">Lengua y Comunicación · Introducción</p>
        <h1 class="titulo-grande">La comunicación empieza por dentro</h1>
        <p class="texto mt-6 max-w-3xl text-slate-300">
          Antes de entrar a la antología, volvamos a los dos libros que ya leímos:
        </p>
        <div class="grid sm:grid-cols-2 gap-4 mt-6">
          <div class="tarjeta border-amber-500/40">
            <p class="text-amber-400 font-black text-xl md:text-2xl">Los cuatro acuerdos</p>
            <p class="text-slate-400 mt-1">Miguel Ruiz</p>
          </div>
          <div class="tarjeta border-sky-500/40">
            <p class="text-sky-400 font-black text-xl md:text-2xl">Influencia</p>
            <p class="text-slate-400 mt-1">Robert Cialdini</p>
          </div>
        </div>
        <p class="texto mt-8 text-slate-400 italic">
          ¿Cuántas veces al día te hablas a ti mismo? ¿Y cuántas veces te convencen sin que lo notes?
        </p>
      </article>

      <!-- 2 · Por qué estos dos -->
      <article class="slide" data-slide>
        <p class="kicker text-slate-400">¿Por qué estos dos libros?</p>
        <h2 class="titulo">Dos lados de la misma moneda</h2>
        <div class="grid md:grid-cols-2 gap-5 mt-8">
          <div class="tarjeta border-amber-500/40">
            <p class="text-amber-400 font-bold uppercase tracking-wider text-sm">Miguel Ruiz</p>
            <p class="text-white font-black text-2xl md:text-3xl mt-2">Cómo uso mis palabras</p>
            <p class="texto text-slate-300 mt-3">Contigo y con los demás: lo que dices, lo que te dices y lo que das por hecho.</p>
          </div>
          <div class="tarjeta border-sky-500/40">
            <p class="text-sky-400 font-bold uppercase tracking-wider text-sm">Robert Cialdini</p>
            <p class="text-white font-black text-2xl md:text-3xl mt-2">Cómo usan las palabras conmigo</p>
            <p class="texto text-slate-300 mt-3">Los «atajos» que hacen que digamos que sí, casi sin pensarlo.</p>
          </div>
        </div>
        <p class="texto mt-8 text-white font-semibold">
          Comunicarse bien es las dos cosas: cuidar lo que digo y darme cuenta de lo que me hacen hacer.
        </p>
      </article>

      <!-- 3 · Los cuatro acuerdos, vista general -->
      <article class="slide" data-slide>
        <p class="kicker text-amber-400">Miguel Ruiz · Los cuatro acuerdos (1997)</p>
        <h2 class="titulo">Cuatro acuerdos contigo mismo</h2>
        <div class="grid sm:grid-cols-2 gap-4 mt-8">
          {acuerdos.map((a) => (
            <div class="tarjeta border-amber-500/30 flex items-center gap-4">
              <span class="numero">{a.n}</span>
              <p class="text-white font-bold text-lg md:text-2xl leading-snug">{a.titulo}</p>
            </div>
          ))}
        </div>
        <p class="texto mt-8 text-slate-400">
          Ruiz, escritor mexicano, los presenta como sabiduría tolteca. No es un estudio
          científico: es una guía para pensar cómo nos hablamos. Su idea central es que
          desde niños aceptamos «acuerdos» (creencias sobre nosotros) que podemos cambiar.
        </p>
      </article>

      <!-- 4–7 · Un acuerdo por diapositiva -->
      {acuerdos.map((a) => (
        <article class="slide" data-slide>
          <p class="kicker text-amber-400">Acuerdo {a.n} de 4</p>
          <h2 class="titulo">{a.titulo}</h2>
          <p class="texto mt-4 text-slate-300 max-w-4xl">{a.significa}</p>
          <div class="grid md:grid-cols-2 gap-5 mt-8">
            <div class="tarjeta border-white/15">
              <p class="etiqueta text-slate-400">Ejemplo</p>
              <p class="texto text-white mt-2">{a.ejemplo}</p>
            </div>
            <div class="tarjeta border-amber-500/40 bg-amber-500/5">
              <p class="etiqueta text-amber-400">Qué puede cambiar en tu vida</p>
              <p class="texto text-white mt-2">{a.cambia}</p>
            </div>
          </div>
        </article>
      ))}

      <!-- 8 · Influencia, qué es -->
      <article class="slide" data-slide>
        <p class="kicker text-sky-400">Robert Cialdini · Influencia (1984)</p>
        <h2 class="titulo">¿Por qué decimos que sí?</h2>
        <div class="grid md:grid-cols-3 gap-4 mt-8">
          <div class="tarjeta border-sky-500/30">
            <p class="etiqueta text-sky-400">Quién es</p>
            <p class="texto text-white mt-2">Psicólogo social. Para escribir el libro también se metió a aprender cómo trabajan vendedores, publicistas y recaudadores.</p>
          </div>
          <div class="tarjeta border-sky-500/30">
            <p class="etiqueta text-sky-400">Qué descubrió</p>
            <p class="texto text-white mt-2">Usamos atajos mentales para decidir rápido. Casi siempre nos ayudan… pero quien los conoce puede activarlos a propósito.</p>
          </div>
          <div class="tarjeta border-sky-500/30">
            <p class="etiqueta text-sky-400">Cuántos son</p>
            <p class="texto text-white mt-2">Seis principios en el libro original. En la edición ampliada de 2021 agregó un séptimo: la unidad.</p>
          </div>
        </div>
      </article>

      <!-- 9 · Los siete principios -->
      <article class="slide" data-slide>
        <p class="kicker text-sky-400">Influencia · los siete principios</p>
        <h2 class="titulo">Los atajos que te hacen decir «sí»</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 mt-6">
          {principios.map((p, i) => (
            <div class="tarjeta-chica border-sky-500/30">
              <p class="text-sky-400 font-black">{i + 1}. {p.nombre}</p>
              <p class="text-white text-sm md:text-base mt-1 leading-snug">{p.idea}</p>
              <p class="text-slate-400 text-xs md:text-sm mt-2 leading-snug">Ej.: {p.ejemplo}</p>
            </div>
          ))}
        </div>
      </article>

      <!-- 10 · Por qué te importa -->
      <article class="slide" data-slide>
        <p class="kicker text-sky-400">Influencia · qué puede cambiar en tu vida</p>
        <h2 class="titulo">Si conoces el truco, decides tú</h2>
        <div class="grid md:grid-cols-2 gap-5 mt-8">
          <div class="tarjeta border-rose-500/40 bg-rose-500/5">
            <p class="etiqueta text-rose-400">Para defenderte</p>
            <p class="texto text-white mt-2">
              «Hola, soy tu tío, cambié de número. Urge que me deposites, ahorita te explico».
              Ese fraude junta <b>unidad</b> (soy de tu familia) y <b>escasez</b> (urge).
              Detenerte cinco segundos y preguntarte «¿quiero esto o me están apurando?»
              te protege de estafas, compras impulsivas y presión del grupo.
            </p>
          </div>
          <div class="tarjeta border-emerald-500/40 bg-emerald-500/5">
            <p class="etiqueta text-emerald-400">Para convencer con ética</p>
            <p class="texto text-white mt-2">
              Los mismos principios sirven para bien: citar una fuente seria es <b>autoridad</b>,
              mostrar que otros ya lo probaron es <b>prueba social</b>. La regla de Cialdini:
              úsalos solo cuando sean verdad. Inventar escasez o autoridad es manipular.
            </p>
          </div>
        </div>
      </article>

      <!-- 11 · Puente con la antología -->
      <article class="slide" data-slide>
        <p class="kicker text-slate-400">Lo que viene</p>
        <h2 class="titulo">Estos libros ya están en la antología</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-6">
          {temasRelacionados.map((t) => (
            <a href={u(`/lengua-y-comunicacion/${t.slug}`)} class="tarjeta-chica border-white/15 hover:border-amber-400/60 transition block">
              <p class="text-white font-bold">{t.titulo}</p>
              <p class="text-slate-400 text-sm mt-1 leading-snug">{t.liga}</p>
            </a>
          ))}
        </div>
      </article>

      <!-- 12 · Cierre -->
      <article class="slide" data-slide>
        <p class="kicker text-amber-400">En parejas · 10 minutos</p>
        <h2 class="titulo">Ahora tú</h2>
        <ol class="space-y-4 mt-8 texto text-white list-none">
          <li class="flex gap-4"><span class="numero">1</span><span>¿Qué acuerdo te cuesta más cumplir? Cuenta una situación real de esta semana.</span></li>
          <li class="flex gap-4"><span class="numero">2</span><span>Recuerda la última vez que aceptaste o compraste algo sin pensarlo. ¿Qué principio de Cialdini te activaron?</span></li>
          <li class="flex gap-4"><span class="numero">3</span><span>Toma un mensaje que hayas mandado hoy y reescríbelo siendo «impecable con tus palabras».</span></li>
        </ol>
      </article>

      <!-- 13 · Fuentes -->
      <article class="slide" data-slide>
        <p class="kicker text-slate-400">Fuentes</p>
        <h2 class="titulo">Para leer más</h2>
        <ul class="space-y-4 mt-8 texto text-slate-300">
          <li class="referencia">Ruiz, M. (1997). <i>The four agreements: A practical guide to personal freedom</i>. Amber-Allen Publishing. [En español: <i>Los cuatro acuerdos</i>.]</li>
          <li class="referencia">Cialdini, R. B. (1984). <i>Influence: The psychology of persuasion</i>. William Morrow. [En español: <i>Influencia: la psicología de la persuasión</i>.]</li>
          <li class="referencia">Cialdini, R. B. (2021). <i>Influence, new and expanded: The psychology of persuasion</i>. Harper Business.</li>
        </ul>
        <a href={u("/lengua-y-comunicacion")} class="inline-block mt-10 text-amber-400 font-bold hover:underline">Ir a los temas de la antología →</a>
      </article>

      <!-- Controles -->
      <div class="controles">
        <button type="button" data-anterior class="boton" aria-label="Diapositiva anterior">←</button>
        <span data-contador class="font-mono-tech text-xs text-slate-400 min-w-[4rem] text-center">1 / 1</span>
        <button type="button" data-siguiente class="boton" aria-label="Diapositiva siguiente">→</button>
        <button type="button" data-completa class="boton" aria-label="Pantalla completa" title="Pantalla completa (F)">⛶</button>
      </div>
      <div class="barra"><div data-progreso class="barra-relleno"></div></div>
    </div>

    <p class="text-xs text-slate-500 mt-4 text-center">
      Avanza con las flechas del teclado o la barra espaciadora. Tecla <b>F</b>: pantalla completa.
    </p>
  </section>

</Layout>

<style>
  .deck { aspect-ratio: 16 / 9; }
  .deck:fullscreen { aspect-ratio: auto; width: 100vw; height: 100vh; border-radius: 0; border: 0; background: #020617; }
  .slide {
    position: absolute; inset: 0;
    padding: clamp(1.25rem, 3.5vw, 3.5rem) clamp(1.25rem, 5vw, 5rem) 4rem;
    overflow-y: auto;
    display: none; flex-direction: column; justify-content: center;
  }
  .slide.activa { display: flex; animation: entra 0.35s ease-out; }
  @keyframes entra { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .slide.activa { animation: none; } }

  /* En teléfono el 16:9 no alcanza: la diapositiva crece con su contenido. */
  @media (max-width: 767px) {
    .deck:not(:fullscreen) { aspect-ratio: auto; }
    .deck:not(:fullscreen) .slide { position: relative; inset: auto; justify-content: flex-start; min-height: 70vh; }
  }

  .kicker { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; }
  .titulo-grande { font-size: clamp(2rem, 5.5vw, 4.5rem); font-weight: 900; color: white; line-height: 1.05; margin-top: 0.75rem; }
  .titulo { font-size: clamp(1.6rem, 4vw, 3.25rem); font-weight: 900; color: white; line-height: 1.1; margin-top: 0.5rem; }
  .texto { font-size: clamp(1rem, 1.6vw, 1.35rem); line-height: 1.5; }
  .etiqueta { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .tarjeta { border-width: 1px; border-radius: 1rem; padding: clamp(1rem, 2vw, 1.5rem); background-color: rgba(255,255,255,0.02); }
  .tarjeta-chica { border-width: 1px; border-radius: 0.9rem; padding: 0.9rem 1rem; background-color: rgba(255,255,255,0.02); }
  .numero {
    flex-shrink: 0; width: 2.75rem; height: 2.75rem; border-radius: 9999px;
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 900; font-size: 1.25rem; color: #0f172a; background: #fbbf24;
  }
  .referencia { padding-left: 2rem; text-indent: -2rem; }

  .controles { position: absolute; right: 1rem; bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; z-index: 10; }
  @media (max-width: 767px) { .deck:not(:fullscreen) .controles { position: static; justify-content: center; padding: 0.75rem 0 1.25rem; } }
  .boton {
    width: 2.5rem; height: 2.5rem; border-radius: 0.6rem; border: 1px solid rgba(255,255,255,0.15);
    color: #e2e8f0; background: rgba(15,23,42,0.85); font-size: 1.1rem;
  }
  .boton:hover { border-color: rgba(251,191,36,0.6); color: #fbbf24; }
  .boton:disabled { opacity: 0.3; cursor: default; }
  .barra { position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: rgba(255,255,255,0.05); }
  .barra-relleno { height: 100%; width: 0; background: #fbbf24; transition: width 0.3s; }
</style>

<script>
  let actual = 0;

  function mostrar(deck: HTMLElement, i: number) {
    const slides = deck.querySelectorAll<HTMLElement>("[data-slide]");
    actual = Math.max(0, Math.min(i, slides.length - 1));
    slides.forEach((s, j) => s.classList.toggle("activa", j === actual));
    deck.querySelector("[data-contador]")!.textContent = `${actual + 1} / ${slides.length}`;
    (deck.querySelector("[data-progreso]") as HTMLElement).style.width = `${((actual + 1) / slides.length) * 100}%`;
    (deck.querySelector("[data-anterior]") as HTMLButtonElement).disabled = actual === 0;
    (deck.querySelector("[data-siguiente]") as HTMLButtonElement).disabled = actual === slides.length - 1;
    slides[actual].scrollTop = 0;
  }

  function completa(deck: HTMLElement) {
    if (document.fullscreenElement) document.exitFullscreen();
    else deck.requestFullscreen?.().catch(() => {});
  }

  document.addEventListener("astro:page-load", () => {
    const deck = document.querySelector<HTMLElement>("[data-deck]");
    if (!deck) return;
    mostrar(deck, 0);
    deck.querySelector("[data-anterior]")!.addEventListener("click", () => mostrar(deck, actual - 1));
    deck.querySelector("[data-siguiente]")!.addEventListener("click", () => mostrar(deck, actual + 1));
    deck.querySelector("[data-completa]")!.addEventListener("click", () => completa(deck));
  });

  // Una sola vez para todo el sitio; solo actúa si la página tiene presentación.
  document.addEventListener("keydown", (e) => {
    const deck = document.querySelector<HTMLElement>("[data-deck]");
    if (!deck || e.metaKey || e.ctrlKey || e.altKey) return;
    const destino = e.target as HTMLElement;
    if (destino.closest("input, textarea, select, [contenteditable]")) return;
    if (["ArrowRight", "PageDown", " "].includes(e.key)) { e.preventDefault(); mostrar(deck, actual + 1); }
    else if (["ArrowLeft", "PageUp"].includes(e.key)) { e.preventDefault(); mostrar(deck, actual - 1); }
    else if (e.key === "Home") mostrar(deck, 0);
    else if (e.key === "End") mostrar(deck, Infinity);
    else if (e.key === "f" || e.key === "F") completa(deck);
  });
</script>
