function bar(){
  const i=typeof S.stage==='number'?S.stage:-1;
  const steps=SECS.map((s,k)=>`<span class="${k===i?'on':k<i||S.stage==='res'?'done':''}">${k+1} ${s.nombre.split(' ')[0]}</span>`).join('');
  const clk=i>=0?`<span class="clock ${S.left[i]<=60?'low':''}" id="clk" aria-live="off">⏱ ${fmt(S.left[i])}</span>`:'';
  return `<div class="bar"><div class="steps">${steps}</div>${clk}</div>`;
