#psico .disc th:first-child{text-align:left}#psico .disc td{padding:4px;border-top:1px solid var(--line)}#psico .disc td.w{width:100%}
#psico .cell{display:grid;place-items:center;cursor:pointer;padding:2px}
#psico .lik{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;margin-top:10px;max-width:440px}
