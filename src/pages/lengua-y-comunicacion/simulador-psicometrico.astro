---
// Simulador de pruebas psicométricas para Lengua y Comunicación.
// Práctica para procesos de selección: personalidad (estilo DISC), razonamiento,
// integridad y situaciones laborales, con reloj por sección y pronóstico al final.
// Las preguntas son originales (no se copian pruebas comerciales).
// No guarda nada en Firebase: todo pasa en el navegador del alumno.
// El script es is:inline y se cuelga de astro:page-load por las View Transitions.
import Layout from '../../layouts/Layout.astro';
import { u } from '../../lib/url';
import '../../styles/taller-lengua.css';
---
<Layout title="Simulador psicométrico · Lengua y Comunicación" description="Practica las pruebas psicométricas de los procesos de selección y descubre cómo te iría.">
  <div class="taller-shell">
    <nav class="taller-breadcrumb" aria-label="Ubicación"><a href={u('/')}>Inicio</a><span aria-hidden="true"> / </span><a href={u('/lengua-y-comunicacion')}>Lengua y Comunicación</a><span aria-hidden="true"> / </span><span>Simulador psicométrico</span></nav>
    <header class="taller-heading">
      <p class="taller-eyebrow">PRÁCTICA · PROCESOS DE SELECCIÓN</p>
      <h1>Simulador de pruebas psicométricas</h1>
      <p>Muchas empresas y escuelas aplican estas pruebas antes de contratar. Aquí practicas las cuatro más comunes en 25 minutos Al terminar, tus respuestas le llegan a tu profesor.</p>
    </header>
    <section id="psico"><div id="psico-app"><p class="taller-footnote">Cargando el simulador…</p></div></section>
  </div>
</Layout>

<style is:global>
#psico{--paper:#0f1726;--sheet:#121b2c;--ink:#e2e8f0;--muted:#a2adc0;--line:#2b3549;--omr:#fbbf24;--pencil:#fde68a;--good:#4ade80;--warn:#fbbf24;--bad:#f87171;
--display:inherit;--body:inherit;--mono:'Roboto Mono',ui-monospace,monospace;color:var(--ink);line-height:1.55;font-size:16px;scroll-margin-top:72px}
#psico *{box-sizing:border-box}
#psico h2,#psico h3{text-wrap:balance;margin:0;line-height:1.2;color:#f8fafc}
#psico h2{font-size:1.6rem;font-weight:800}#psico h3{font-size:1.1rem;font-weight:700}#psico p{margin:0}
#psico .lbl{font:600 .7rem/1.2 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--omr)}
#psico .muted{color:var(--muted)}#psico .stack{display:flex;flex-direction:column;gap:16px}
#psico .bar{position:sticky;top:64px;z-index:5;background:#0b1220;padding:12px 4px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
#psico .steps{display:flex;gap:6px;flex-wrap:wrap}
#psico .steps span{font:600 .68rem/1 var(--mono);padding:6px 8px;border:1px solid var(--line);border-radius:6px;color:var(--muted)}
#psico .steps span.on{border-color:var(--omr);color:var(--omr)}#psico .steps span.done{background:#1d2a3f;color:var(--ink)}
#psico .clock{font:600 1.1rem/1 var(--mono);font-variant-numeric:tabular-nums}#psico .clock.low{color:var(--bad)}
#psico .sheet{background:var(--sheet);border:1px solid var(--line);border-radius:16px;padding:clamp(18px,4vw,30px);margin-top:20px}
#psico .head{display:flex;flex-direction:column;gap:8px}
#psico .item{padding:18px 0;border-top:1px dashed var(--line);display:grid;grid-template-columns:2.4rem minmax(0,1fr);gap:4px 10px}
#psico .item:first-of-type{border-top:0}
#psico .num{font:600 .85rem/1.8 var(--mono);color:var(--omr)}
#psico .q .big{font:600 1.5rem/1.3 var(--mono);letter-spacing:.06em;color:#fde68a;margin-top:6px}
#psico .opts{display:flex;flex-direction:column;gap:6px;margin-top:10px}
#psico .opt{display:flex;align-items:center;gap:10px;cursor:pointer;padding:5px 6px;border-radius:8px}
#psico .opt:hover{background:#182235}
#psico input[type=radio]{position:absolute;opacity:0;width:1px;height:1px}
#psico .o{flex:none;display:inline-grid;place-items:center;width:34px;height:22px;border:1.5px solid var(--omr);border-radius:50%;font:600 .72rem/1 var(--mono);color:var(--omr)}
#psico input:checked+.o{background:var(--omr);color:#101827}
#psico input:focus-visible+.o{outline:3px solid #fcd34d;outline-offset:3px}
#psico .disc{width:100%;border-collapse:collapse;margin-top:6px}
#psico .disc th{font:600 .66rem/1 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--omr);text-align:center;padding:4px}
#psico .disc th:first-child{text-align:left}#psico .disc td{padding:4px;border-top:1px solid var(--line)}#psico .disc td.w{width:100%}
#psico .cell{display:grid;place-items:center;cursor:pointer;padding:2px}
