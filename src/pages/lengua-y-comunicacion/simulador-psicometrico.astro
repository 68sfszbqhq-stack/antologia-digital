</style>

<script>
  // Puente entre el simulador (is:inline, no puede importar) y Firebase.
  // Igual que los módulos: el alumno entra con Google y se usa su ficha de
  // /alumnos. Si no tiene ficha, se busca en su diagnóstico de inicio; si
  // tampoco, el simulador le pide nombre y grupo una sola vez.
  import { addDoc, collection, serverTimestamp } from "firebase/firestore";
  import { db, firebaseConfigurado } from "../../lib/firebase";

  const w = window as any;
  const alumno = () => import("../../lib/alumno");
  let quitar: null | (() => void) = null;

  function avisar(estado: any) {
    w.psicoUsuario = estado;
    document.dispatchEvent(new CustomEvent("psico:sesion"));
  }

  w.psicoEntrar = async () => {
    const { entrarConGoogle } = await alumno();
    await entrarConGoogle();
  };
  w.psicoSalir = async () => {
    const { salir } = await alumno();
    await salir();
  };
  w.psicoCrearFicha = async (nombre: string, grupo: string) => {
    const a = await alumno();
    const u = w.psicoUsuario?.user;
    if (!u) throw new Error("sin sesión");
    const ficha = await a.crearMiFicha(u, nombre, grupo);
    avisar({ user: u, uid: u.uid, correo: u.email ?? "", nombre: ficha.nombre, grupo: ficha.grupo, ficha: true, activo: true });
  };
  w.guardarPsico = async (d: Record<string, unknown>) => {
    const u = w.psicoUsuario;
    if (!firebaseConfigurado() || !u?.ficha) throw new Error("sin sesión");
    await addDoc(collection(db(), "psicometrico"), {
      ...d, uid: u.uid, nombre: u.nombre, grupo: u.grupo, enviado: serverTimestamp(),
    });
  };

  document.addEventListener("astro:page-load", async () => {
    if (!document.getElementById("psico-app")) return;
    if (!firebaseConfigurado()) { avisar({ sinFirebase: true }); return; }
    const a = await alumno();
    a.sesionPorRedireccion();
    quitar?.();
    quitar = a.observarSesion(async (u) => {
      if (!u) { avisar(null); return; }
      avisar({ cargando: true });
      try {
        let f = await a.fichaDe(u.uid);
        if (!f) {
          const prev = await a.datosDelDiagnostico(u);
          if (prev && prev.nombre && prev.grupo) f = await a.crearMiFicha(u, prev.nombre, prev.grupo);
        }
        avisar(f
          ? { user: u, uid: u.uid, correo: u.email ?? "", nombre: f.nombre, grupo: f.grupo, ficha: true, activo: f.activo }
          : { user: u, uid: u.uid, correo: u.email ?? "", ficha: false });
      } catch (e) {
        console.error(e);
        avisar({ user: u, uid: u.uid, correo: u.email ?? "", ficha: false, error: true });
      }
    });
  });
  document.addEventListener("astro:before-swap", () => { quitar?.(); quitar = null; });
</script>

