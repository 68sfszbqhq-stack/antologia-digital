#psico .btn{font-weight:800;font-size:14px;padding:13px 19px;border-radius:10px;border:0;background:#fbbf24;color:#101827;cursor:pointer}
#psico .btn:hover{background:#fde68a}
#psico .ghost{font-weight:700;font-size:14px;padding:12px 18px;border-radius:10px;border:1px solid #48566c;background:transparent;color:#f1f5f9;cursor:pointer}
#psico .btn:focus-visible,#psico .ghost:focus-visible,#psico input[type=text]:focus-visible{outline:3px solid #fcd34d;outline-offset:3px}
#psico .row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
#psico .foot{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-top:20px}
#psico input[type=text]{font:inherit;font-size:15px;padding:12px;border:1px solid #64748b;border-radius:8px;background:#0d1523;color:#fff;width:100%;max-width:420px}
#psico .secs{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px}
#psico .sec{border:1px solid var(--line);background:#0f1726;border-radius:12px;padding:14px;display:flex;flex-direction:column;gap:6px}
#psico .sec b{font-size:1.05rem;color:#f8fafc}#psico .sec .t{font:600 .78rem var(--mono);color:var(--omr)}
#psico .datos{display:grid;grid-template-columns:2fr 1fr 1.3fr;gap:12px}#psico .datos>div{display:flex;flex-direction:column;gap:6px;min-width:0}#psico .err{color:var(--bad);font-size:.9rem;min-height:1.2em}#psico .envio{font-size:.95rem;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
#psico .login{display:flex;flex-direction:column;gap:12px;align-items:flex-start;padding:16px;border:1px solid var(--line);border-radius:12px;background:#0f1726}
#psico .google{font-weight:700;font-size:14px;padding:12px 18px;border-radius:10px;border:0;background:#fff;color:#1f2937;cursor:pointer}
#psico .quien{font-size:.95rem}#psico .link{background:none;border:0;color:#fcd34d;text-decoration:underline;cursor:pointer;font-size:.85rem;margin-left:6px}
#psico .btn:disabled{opacity:.45;cursor:not-allowed}
#psico .item.falta{background:rgba(248,113,113,.08);box-shadow:inset 3px 0 0 var(--bad);border-radius:8px;padding-left:8px}
#psico .aviso{margin-top:16px;padding:16px;border:1px solid var(--bad);border-radius:12px;background:rgba(248,113,113,.08);display:flex;flex-direction:column;gap:12px}
#psico .note{font-size:.88rem;color:var(--muted);border-left:3px solid #fbbf24;padding-left:12px}
#psico .verdict{border:2px solid var(--v);border-radius:14px;padding:20px;display:flex;flex-direction:column;gap:8px}
#psico .verdict .score{font-weight:900;font-size:3.4rem;line-height:1;color:var(--v)}
#psico .bars{display:flex;flex-direction:column;gap:14px}
#psico .br{display:grid;grid-template-columns:10rem 1fr 3.2rem;gap:10px;align-items:center}
#psico .br .tr{height:12px;background:#0b1220;border-radius:6px;overflow:hidden}#psico .br .fl{height:100%;border-radius:6px}
#psico .br .pc{font:600 .9rem var(--mono);text-align:right;font-variant-numeric:tabular-nums}
#psico .disc-res{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
#psico .disc-res div{border:1px solid var(--line);border-radius:10px;padding:10px;text-align:center}
#psico .disc-res div.top{border-color:var(--omr)}#psico .disc-res b{display:block;font-size:1.5rem;font-weight:900;color:#f8fafc}
#psico .disc-res span{font:500 .7rem var(--mono);color:var(--muted)}
#psico .rev{display:flex;flex-direction:column;gap:10px}#psico .rev div{font-size:.92rem;padding:10px 12px;border-radius:8px;background:#0f1726}
#psico .ok{color:var(--good);font-weight:700}#psico .no{color:var(--bad);font-weight:700}
#psico ul.tips{margin:0;padding-left:1.2rem;list-style:disc;display:flex;flex-direction:column;gap:8px}
#psico details summary{cursor:pointer;font-weight:700;color:#fcd34d}
#psico textarea{background:#0d1523;color:#fff;border:1px solid #64748b;border-radius:8px;padding:10px;font:inherit;font-size:14px}
@media(max-width:560px){#psico .datos{grid-template-columns:1fr}#psico .br{grid-template-columns:1fr 3rem}#psico .br .n{grid-column:1/-1}#psico .disc-res{grid-template-columns:repeat(2,1fr)}#psico .item{grid-template-columns:minmax(0,1fr)}#psico .num{line-height:1}}
</style>

<script>
  // Puente entre el simulador (is:inline, no puede importar) y Firebase.
  // Igual que los módulos: el alumno entra con Google y se usa su ficha de
  // /alumnos. Si no tiene ficha, se busca en su diagnóstico de inicio; si
  // tampoco, el simulador le pide nombre y grupo una sola vez.
  import { addDoc, collection, serverTimestamp } from "firebase/firestore";
  import { db, firebaseConfigurado } from "../../lib/firebase";

  const w = window as any;
  const alumno = () => import("../../lib/alumno");
  let quitar: null | (() => void) = null;

  function avisar(estado: any) {
    w.psicoUsuario = estado;
    document.dispatchEvent(new CustomEvent("psico:sesion"));
  }

  w.psicoEntrar = async () => {
    const { entrarConGoogle } = await alumno();
    await entrarConGoogle();
  };
  w.psicoSalir = async () => {
    const { salir } = await alumno();
    await salir();
  };
  w.psicoCrearFicha = async (nombre: string, grupo: string) => {
    const a = await alumno();
    const u = w.psicoUsuario?.user;
    if (!u) throw new Error("sin sesión");
    const ficha = await a.crearMiFicha(u, nombre, grupo);
    avisar({ user: u, uid: u.uid, correo: u.email ?? "", nombre: ficha.nombre, grupo: ficha.grupo, ficha: true, activo: true });
  };
  w.guardarPsico = async (d: Record<string, unknown>) => {
    const u = w.psicoUsuario;
    if (!firebaseConfigurado() || !u?.ficha) throw new Error("sin sesión");
    await addDoc(collection(db(), "psicometrico"), {
      ...d, uid: u.uid, nombre: u.nombre, grupo: u.grupo, enviado: serverTimestamp(),
    });
  };

  document.addEventListener("astro:page-load", async () => {
    if (!document.getElementById("psico-app")) return;
    if (!firebaseConfigurado()) { avisar({ sinFirebase: true }); return; }
    const a = await alumno();
    a.sesionPorRedireccion();
    quitar?.();
    quitar = a.observarSesion(async (u) => {
      if (!u) { avisar(null); return; }
      avisar({ cargando: true });
      try {
        let f = await a.fichaDe(u.uid);
        if (!f) {
          const prev = await a.datosDelDiagnostico(u);
          if (prev && prev.nombre && prev.grupo) f = await a.crearMiFicha(u, prev.nombre, prev.grupo);
        }
        avisar(f
          ? { user: u, uid: u.uid, correo: u.email ?? "", nombre: f.nombre, grupo: f.grupo, ficha: true, activo: f.activo }
          : { user: u, uid: u.uid, correo: u.email ?? "", ficha: false });
      } catch (e) {
        console.error(e);
        avisar({ user: u, uid: u.uid, correo: u.email ?? "", ficha: false, error: true });
      }
    });
  });
  document.addEventListener("astro:before-swap", () => { quitar?.(); quitar = null; });
</script>

<script is:inline define:vars={{ PSICO }}>
(function(){
function iniciarPsico(){
if(!document.getElementById('psico-app')||document.getElementById('psico-app').dataset.listo)return;
document.getElementById('psico-app').dataset.listo='1';

const {SECS,DISC,DISC_INFO,RAZ,INT,LIK,SIT}=PSICO;

const fresh=()=>({stage:'inicio',revisar:{},nombre:'',grupo:'',celular:'',envio:'',disc:{},raz:{},int:{},sit:{},left:SECS.map(s=>s.min*60)});
let S=fresh();
const app=document.getElementById('psico-app');
let tick=null;
const esc=t=>String(t).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const L='ABCD';
const fmt=s=>`${Math.floor(s/60)}:${String(s%60).padStart(2,'0')}`;

function bar(){
  const i=typeof S.stage==='number'?S.stage:-1;
  const steps=SECS.map((s,k)=>`<span class="${k===i?'on':k<i||S.stage==='res'?'done':''}">${k+1} ${s.nombre.split(' ')[0]}</span>`).join('');
  const clk=i>=0?`<span class="clock ${S.left[i]<=60?'low':''}" id="clk" aria-live="off">⏱ ${fmt(S.left[i])}</span>`:'';
  return `<div class="bar"><div class="steps">${steps}</div>${clk}</div>`;
}

function listo(){const u=window.psicoUsuario;return !!(u&&u.user&&(u.ficha?u.activo!==false:true));}
function puerta(){
  const u=window.psicoUsuario;
  const nota='<p class="muted" style="font-size:.85rem">Al terminar, tus respuestas le llegan a tu profesor.</p>';
  if(u===undefined||(u&&u.cargando))return '<p class="muted">Verificando tu cuenta…</p>';
  if(u&&u.sinFirebase)return '<p class="no">El simulador no puede guardar resultados en este momento. Avísale a tu profesor.</p>';
  if(!u)return `<div class="login"><p>Para que tus respuestas le lleguen a tu profesor, entra con la <strong>misma cuenta de Google</strong> que usas en la Antología.</p>
    <button class="google" id="entrar" type="button">Entrar con Google</button></div>`;
  if(u.ficha&&u.activo===false)return '<p class="no">Tu cuenta está desactivada en la Antología. Habla con tu profesor.</p>';
  if(u.ficha)return `<p class="quien">Entraste como <strong>${esc(u.nombre)}</strong> · ${esc(u.grupo)} <button class="link" id="salir" type="button">No soy yo</button></p>${nota}`;
  return `<p class="quien">Entraste con <strong>${esc(u.correo)}</strong>. Es tu primera vez: escribe tu nombre y tu grupo. <button class="link" id="salir" type="button">Usar otra cuenta</button></p>
    <div class="datos"><div><label for="nom" class="lbl">Nombre completo</label>
    <input type="text" id="nom" autocomplete="name" placeholder="Nombre y apellidos" value="${esc(S.nombre)}"></div>
    <div><label for="gru" class="lbl">Grupo</label>
    <input type="text" id="gru" maxlength="12" placeholder="Ej. 5.º A" value="${esc(S.grupo)}"></div></div>${nota}`;
}
function inicio(){
  return `${bar()}<div class="sheet stack">
      <h2 class="ps-h1">Antes de empezar</h2>
   <div class="secs">${SECS.map((s,k)=>`<div class="sec"><span class="lbl">Sección ${k+1}</span><b>${s.nombre}</b><span class="muted" style="font-size:.85rem">${s.estilo}</span><span class="t">${s.min} min</span></div>`).join('')}</div>
${puerta()}
   <p class="err" id="errdatos" role="alert"></p>
   <div class="row"><button class="btn" id="go" ${listo()?"":"disabled"}>Empezar</button><span class="muted" style="font-size:.88rem">Cada sección tiene su propio tiempo. Al terminarse, pasa sola a la siguiente.</span></div>
   <p class="note">Es una práctica con preguntas de ejemplo. No es una prueba oficial y no sustituye una evaluación psicológica.</p>
  </div>`;
}

function seccion(i){
  const s=SECS[i]; let body='';
  if(s.id==='disc'){
    body=DISC.map((g,gi)=>`<div class="item" id="it-disc-${gi}"><span class="num">${String(gi+1).padStart(2,'0')}</span><div class="q">
      <table class="disc"><thead><tr><th>Palabra</th><th>Más</th><th>Menos</th></tr></thead><tbody>
      ${g.map((w,wi)=>`<tr><td class="w">${w[0]}</td>
        <td><label class="cell"><input type="radio" id="dm${gi}_${wi}" name="dm${gi}" data-k="disc" data-g="${gi}" data-t="mas" value="${wi}" ${S.disc[gi]?.mas==wi?'checked':''} aria-label="Más: ${w[0]}"><span class="o">+</span></label></td>
        <td><label class="cell"><input type="radio" id="dn${gi}_${wi}" name="dn${gi}" data-k="disc" data-g="${gi}" data-t="menos" value="${wi}" ${S.disc[gi]?.menos==wi?'checked':''} aria-label="Menos: ${w[0]}"><span class="o">−</span></label></td></tr>`).join('')}
      </tbody></table></div></div>`).join('');
  } else if(s.id==='int'){
    body=INT.map((it,qi)=>`<div class="item" id="it-int-${qi}"><span class="num">${String(qi+1).padStart(2,'0')}</span><div class="q"><p>${it.q}</p>
      <div class="lik" role="radiogroup" aria-label="Pregunta ${qi+1}">${LIK.map((l,v)=>`<label><input type="radio" id="i${qi}_${v}" name="i${qi}" data-k="int" data-g="${qi}" value="${v+1}" ${S.int[qi]==v+1?'checked':''}><span class="o">${v+1}</span>${l}</label>`).join('')}</div></div></div>`).join('');
  } else {
    const data=s.id==='raz'?RAZ:SIT;
    body=data.map((it,qi)=>`<div class="item" id="it-${s.id}-${qi}"><span class="num">${String(qi+1).padStart(2,'0')}</span><div class="q"><p>${it.q}</p>
      ${it.big?`<p class="big">${it.big}</p>`:''}
      <div class="opts">${it.o.map((o,oi)=>`<label class="opt"><input type="radio" id="${s.id}${qi}_${oi}" name="${s.id}${qi}" data-k="${s.id}" data-g="${qi}" value="${oi}" ${S[s.id][qi]==oi?'checked':''}><span class="o">${L[oi]}</span><span>${o}</span></label>`).join('')}</div></div></div>`).join('');
  }
  const total=s.id==='disc'?DISC.length:s.id==='raz'?RAZ.length:s.id==='int'?INT.length:SIT.length;
  return `${bar()}<div class="sheet"><div class="head"><span class="lbl">Sección ${i+1} de 4 · ${s.estilo}</span><h2>${s.nombre}</h2><p class="muted">${s.instr}</p></div>
   <div style="margin-top:12px">${body}</div>
   <div class="foot"><span class="muted" id="cnt">${contestadas(s.id)} de ${total} contestadas</span>
   <button class="btn" id="next">${i<3?'Siguiente sección':'Terminar y entregar'}</button></div>
   <div class="aviso" id="aviso" role="alert" hidden><p data-n></p>
    <div class="row"><button class="btn" id="completar" type="button">Completar lo que falta</button><button class="ghost" id="seguir" type="button">${i<3?'Continuar así':'Entregar así'}</button></div></div></div>`;
}

function hecho(id,qi){
  if(id==='disc'){const g=S.disc[qi];return !!(g&&g.mas!=null&&g.menos!=null);}
  return S[id][qi]!=null;
}
function totalDe(id){return {disc:DISC.length,raz:RAZ.length,int:INT.length,sit:SIT.length}[id];}
function marcarFaltantes(){
  const i=S.stage; if(typeof i!=='number'||!S.revisar[i])return;
  const id=SECS[i].id;
  for(let qi=0;qi<totalDe(id);qi++){const el=document.getElementById(`it-${id}-${qi}`);if(el)el.classList.toggle('falta',!hecho(id,qi));}
  const av=document.getElementById('aviso'),n=totalDe(id)-contestadas(id);
  if(av){
    if(n===0){av.hidden=true;return;}
    av.hidden=false;
    av.querySelector('[data-n]').textContent=id==='disc'
      ?`Te faltan ${n} ${n===1?'renglón':'renglones'}. En cada uno marca una palabra en MÁS y otra distinta en MENOS. Están marcados en rojo.`
      :`Te ${n===1?'falta':'faltan'} ${n} ${n===1?'pregunta':'preguntas'} por contestar. Están marcadas en rojo; las que dejes en blanco cuentan como error.`;
  }
}
function contestadas(id){
  if(id==='disc')return Object.values(S.disc).filter(g=>g.mas!=null&&g.menos!=null).length;
  return Object.keys(S[id]).length;
}

function calc(){
  const prof={D:0,I:0,S:0,C:0};
  DISC.forEach((g,gi)=>{const a=S.disc[gi]||{};if(a.mas!=null)prof[g[a.mas][1]]++;if(a.menos!=null)prof[g[a.menos][1]]--;});
  const discOk=contestadas('disc');
  const top=Object.entries(prof).sort((a,b)=>b[1]-a[1])[0][0];
  const raz=RAZ.filter((q,i)=>S.raz[i]==q.a).length;
  let ip=0,lie=0,iAns=0;
  INT.forEach((it,i)=>{const v=S.int[i];if(v==null)return;
    if(it.k==='L'){if(v>=4)lie++;return;}
    iAns++;ip+=it.k==='+'?(v-1)/4:(5-v)/4;});
  const nI=INT.filter(x=>x.k!=='L').length;
  let intP=Math.round(ip/nI*100);
  if(lie>=2)intP=Math.max(0,intP-15);
  const sit=SIT.filter((q,i)=>S.sit[i]==q.a).length;
  const razP=Math.round(raz/RAZ.length*100), sitP=Math.round(sit/SIT.length*100), discP=Math.round(discOk/DISC.length*100);
  const total=Math.round(razP*.35+sitP*.30+intP*.25+discP*.10);
  return {prof,top,discOk,discP,raz,razP,intP,lie,sit,sitP,total};
}

function nivel(p){return p>=80?['Vas muy bien','var(--good)']:p>=60?['Vas bien, con detalles por pulir','var(--warn)']:['Te conviene practicar más','var(--bad)'];}

function estadoEnvio(){
  if(S.envio==='ok')return '<span class="ok">✓ Tus respuestas ya le llegaron a tu profesor.</span>';
  if(S.envio==='enviando')return '<span class="muted">Enviando tus respuestas a tu profesor… No cierres esta página.</span>';
  if(S.envio==='error')return '<span class="no">No se pudieron enviar tus respuestas. Revisa tu internet.</span> <button class="ghost" id="reenviar">Intentar de nuevo</button>';
  return '';
}
async function enviar(){
  if(S.envio==='ok'||S.envio==='enviando')return;
  const r=calc(); S.envio='enviando'; pintarEnvio();
  try{
    if(typeof window.guardarPsico!=='function')throw new Error('sin conexión');
    const arr=(id,n,f)=>Array.from({length:n},(_,qi)=>f(qi));
    const resp={
      discMas:arr('disc',DISC.length,qi=>S.disc[qi]&&S.disc[qi].mas!=null?S.disc[qi].mas:-1),
      discMenos:arr('disc',DISC.length,qi=>S.disc[qi]&&S.disc[qi].menos!=null?S.disc[qi].menos:-1),
      raz:arr('raz',RAZ.length,qi=>S.raz[qi]!=null?S.raz[qi]:-1),
      int:arr('int',INT.length,qi=>S.int[qi]!=null?S.int[qi]:0),
      sit:arr('sit',SIT.length,qi=>S.sit[qi]!=null?S.sit[qi]:-1)};
    const tiempos=SECS.map((x,k)=>Math.max(0,Math.round(x.min*60-S.left[k])));
    await window.guardarPsico({celular:'',resp,tiempos,
      total:r.total,raz:r.raz,sit:r.sit,intP:r.intP,mentira:r.lie,discOk:r.discOk,perfil:r.top});
    S.envio='ok';
  }catch(err){console.error(err);S.envio='error';}
  pintarEnvio();
}
function pintarEnvio(){const e=document.getElementById('envio');if(e)e.innerHTML=estadoEnvio();}

function resultado(){
  const n=window.psicoUsuario&&window.psicoUsuario.nombre;
  return `${bar()}<div class="sheet stack">
   <span class="lbl">Prueba terminada</span>
   <h2>¡Listo${n?', '+esc(n.split(' ')[0]):''}!</h2>
   <p class="envio" id="envio">${estadoEnvio()}</p>
   <p>Tu profesor revisará tus respuestas y te dará tu resultado.</p>
  </div>`;
}

function render(){
  clearInterval(tick);
  if(S.stage==='inicio')app.innerHTML=inicio();
  else if(S.stage==='res'){app.innerHTML=resultado();if(!S.envio)enviar();}
  else{app.innerHTML=seccion(S.stage);marcarFaltantes();startClock();}
  if(S.stage!=='inicio')document.getElementById('psico').scrollIntoView({block:'start'});
}

function startClock(){
  tick=setInterval(()=>{
    const i=S.stage; if(typeof i!=='number')return;
    S.left[i]=Math.max(0,S.left[i]-1);
    const c=document.getElementById('clk');
    if(c){c.textContent='⏱ '+fmt(S.left[i]);c.classList.toggle('low',S.left[i]<=60);}
    if(S.left[i]===0)avanzar();
  },1000);
}
function avanzar(){S.stage=S.stage<3?S.stage+1:'res';render();}

app.addEventListener('change',e=>{
  const t=e.target; if(!t.dataset.k)return;
  const k=t.dataset.k,g=+t.dataset.g,v=+t.value;
  if(k==='disc'){
    const a=S.disc[g]||(S.disc[g]={});
    a[t.dataset.t]=v;
    const other=t.dataset.t==='mas'?'menos':'mas';
    if(a[other]===v){delete a[other];const o=document.getElementById((other==='mas'?'dm':'dn')+g+'_'+v);if(o)o.checked=false;}
  } else S[k][g]=v;
  const c=document.getElementById('cnt');
  const tot={disc:DISC.length,raz:RAZ.length,int:INT.length,sit:SIT.length}[k];
  if(c)c.textContent=`${contestadas(k)} de ${tot} contestadas`;
  marcarFaltantes();
});
app.addEventListener('input',e=>{const t=e.target;
  if(t.id==='nom')S.nombre=t.value.trim();
  if(t.id==='gru')S.grupo=t.value.trim();
});
app.addEventListener('click',e=>{
  const id=e.target.id;
  if(id==='go'){
    const m=document.getElementById('errdatos'),u=window.psicoUsuario;
    if(!listo()){m.textContent='Primero entra con tu cuenta de Google.';return;}
    if(!u.ficha){
      if(S.nombre.length<5||S.nombre.indexOf(' ')<0){m.textContent='Escribe tu nombre completo, con apellidos.';return;}
      if(!S.grupo){m.textContent='Escribe tu grupo.';return;}
      e.target.disabled=true;m.textContent='';
      window.psicoCrearFicha(S.nombre,S.grupo).then(()=>{S.stage=0;render();})
        .catch(err=>{console.error(err);e.target.disabled=false;m.textContent='No se pudo guardar tu nombre. Revisa tu internet e intenta de nuevo.';});
      return;
    }
    S.stage=0;render();}
  else if(id==='entrar'){window.psicoEntrar().catch(err=>{console.error(err);const m=document.getElementById('errdatos');if(m)m.textContent='No se pudo entrar con Google. Intenta de nuevo.';});}
  else if(id==='salir'){window.psicoSalir();}
  else if(id==='reenviar')enviar();
  else if(id==='next'){
    const i=S.stage,sid=SECS[i].id;
    if(contestadas(sid)<totalDe(sid)){S.revisar[i]=true;marcarFaltantes();document.getElementById('aviso').scrollIntoView({block:'center'});return;}
    avanzar();}
  else if(id==='seguir')avanzar();
  else if(id==='completar'){const f=document.querySelector('#psico .item.falta');if(f)f.scrollIntoView({block:'center'});}
});


document.addEventListener('astro:before-swap',()=>clearInterval(tick),{once:true});
document.addEventListener('psico:sesion',()=>{if(S.stage==='inicio'&&document.getElementById('psico-app'))render();});
render();
}
document.addEventListener('astro:page-load',iniciarPsico);
})();
</script>
