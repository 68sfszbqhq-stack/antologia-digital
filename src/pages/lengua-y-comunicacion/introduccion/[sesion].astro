---
// Presentación de una sesión del Máster en Comunicación Consciente, para
// proyectar. El contenido vive en src/data/lengua/master.ts.
//
// Dos modos, y el sitio decide solo cuál:
//
//   · EN VIVO: el profesor entró con su cuenta de Google. Al llegar a una
//     diapositiva de votación, la pregunta aparece sola en los celulares; al
//     salir, se cierra. Las barras se revelan con un botón, para que el grupo
//     no vote copiando lo que ya ve (eso sería prueba social, justo lo que se
//     enseña en la sesión 2).
//   · A MANO ALZADA: sin sesión de profesor o sin Firebase. La presentación
//     funciona igual; solo no cuenta votos ni abre quizzes.
//
// Teclado: flechas o espacio para avanzar, F para pantalla completa.
// El script se cuelga de astro:page-load (View Transitions).
import QRCode from "qrcode";
import Layout from "../../../layouts/Layout.astro";
import { u } from "../../../lib/url";
import { SESIONES_MASTER, QUIZZES, FUENTES_MASTER } from "../../../data/lengua/master";

export function getStaticPaths() {
  return SESIONES_MASTER.map((sesion) => ({ params: { sesion: sesion.slug }, props: { sesion } }));
}

const { sesion } = Astro.props;
const urlVivo = new URL(u("/en-vivo/"), Astro.site).href;
const urlCorta = urlVivo.replace(/^https?:\/\//, "").replace(/\/$/, "");
// Se parte en dos renglones por la diagonal, no a media palabra.
const [urlHost, ...urlResto] = urlCorta.split("/");
const urlRuta = "/" + urlResto.join("/");
const qr = await QRCode.toString(urlVivo, { type: "svg", margin: 1, color: { dark: "#0a0a0f", light: "#ffffff" } });
const letras = ["A", "B", "C", "D", "E", "F"];
---

<Layout title={`${sesion.modulo} · ${sesion.titulo}`} description={`Máster en Comunicación Consciente. ${sesion.resumen}`}>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,800;1,600&display=swap" />

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <nav class="text-xs font-mono-tech text-slate-500 mb-5">
      <a href={u("/")} class="hover:text-amber-300 transition">Inicio</a>
      <span class="mx-2">/</span>
      <a href={u("/lengua-y-comunicacion")} class="hover:text-amber-300 transition">Lengua y Comunicación</a>
      <span class="mx-2">/</span>
      <a href={u("/lengua-y-comunicacion/introduccion")} class="hover:text-amber-300 transition">Máster</a>
      <span class="mx-2">/</span>
      <span class="text-slate-400">{sesion.modulo}</span>
    </nav>

    <div data-deck data-sesion={sesion.numero} class="deck">

      {sesion.diapositivas.map((d, i) => (
        <article class="slide" data-slide data-tipo={d.tipo}
          data-voto={d.tipo === "voto" ? d.pregunta.id : undefined}
          data-opciones={d.tipo === "voto" ? d.pregunta.opciones.length : undefined}
          data-correcta={d.tipo === "voto" && d.pregunta.correcta !== undefined ? d.pregunta.correcta : undefined}
          data-quiz={d.tipo === "quiz" ? d.quiz : undefined}
        >

          {d.tipo === "portada" && (
            <div class="centro">
              <p class="kicker">Máster en Comunicación Consciente</p>
              <div class="filete"></div>
              <p class="modulo">{d.modulo}</p>
              <h1 class="titulo-xl">{d.titulo}</h1>
              <p class="subtitulo">{d.subtitulo}</p>
            </div>
          )}

          {d.tipo === "frase" && (
            <div class="centro">
              <p class="frase">«{d.frase}»</p>
              {d.detalle && <><div class="filete"></div><p class="subtitulo">{d.detalle}</p></>}
            </div>
          )}

          {d.tipo === "conectar" && (
            <div class="grid md:grid-cols-[1fr_auto] gap-[4cqw] items-center h-full">
              <div>
                <p class="kicker">Saca tu celular</p>
                <h2 class="titulo">Esta clase se vota</h2>
                <p class="texto mt-[2cqw]">Escanea el código o entra a:</p>
                <p class="url"><span class="whitespace-nowrap">{urlHost}</span><wbr /><span class="whitespace-nowrap">{urlRuta}</span></p>
                <p class="texto-chico mt-[2cqw]">Entra con la cuenta de Google de tu evaluación diagnóstica. Deja la página abierta: las preguntas te llegan solas.</p>
                <p data-estado-profe class="texto-chico mt-[2cqw] text-amber-300/80"></p>
              </div>
              <div class="qr" set:html={qr} />
            </div>
          )}

          {d.tipo === "voto" && (
            <div class="flex flex-col h-full">
              <p class="kicker">{d.kicker}</p>
              {d.contexto && <p class="contexto">{d.contexto}</p>}
              <h2 class="pregunta">{d.pregunta.texto}</h2>
              <ol class="opciones">
                {d.pregunta.opciones.map((o, j) => (
                  <li class="opcion" data-opcion={j}>
                    <span class="letra">{letras[j]}</span>
                    <span class="flex-1 relative z-10">{o}</span>
                    <span class="cuenta relative z-10" data-cuenta></span>
                    <span class="barra" data-barra></span>
                  </li>
                ))}
              </ol>
              {d.pregunta.explicacion && (
                <p class="explicacion" data-explicacion hidden>{d.pregunta.explicacion}</p>
              )}
              <div class="mando">
                <span data-votos class="texto-chico"></span>
                <button type="button" class="boton-oro" data-revelar>
                  {d.pregunta.correcta !== undefined ? "Revelar respuesta" : "Ver resultados"}
                </button>
                <button type="button" class="boton-fantasma" data-reabrir hidden>Reabrir votación</button>
              </div>
            </div>
          )}

          {d.tipo === "ciencia" && (
            <div class="flex flex-col h-full">
              <p class="kicker">{d.kicker}</p>
              <h2 class="titulo">{d.titulo}</h2>
              {d.ruiz && <p class="cita-ruiz">Ruiz: «{d.ruiz}»</p>}
              <div class="grid md:grid-cols-2 gap-[2cqw] mt-[2cqw] items-start">
                <div class="panel">
                  <p class="etiqueta">El experimento</p>
                  <p class="texto-chico text-white/60 mt-[0.6cqw]">{d.estudio.quien}</p>
                  <p class="texto mt-[0.8cqw]">{d.estudio.hicieron}</p>
                  <p class="texto mt-[0.8cqw] text-white"><strong class="text-amber-300">Resultado:</strong> {d.estudio.encontraron}</p>
                  <p class="fuente">({d.estudio.clave})</p>
                </div>
                <div class="flex flex-col gap-[2cqw]">
                  {d.veredicto && (
                    <div class="panel panel-oro">
                      <p class="etiqueta">{d.veredicto.etiqueta}</p>
                      <p class="texto mt-[0.8cqw] text-white">{d.veredicto.texto}</p>
                    </div>
                  )}
                  <div class="panel">
                    <p class="etiqueta">En tu vida</p>
                    <p class="texto mt-[0.8cqw] text-white">{d.enTuVida}</p>
                  </div>
                </div>
              </div>
              {d.parejas && <p class="parejas">{d.parejas}</p>}
            </div>
          )}

          {d.tipo === "tarjetas" && (
            <div class="flex flex-col h-full justify-center">
              <p class="kicker">{d.kicker}</p>
              <h2 class="titulo">{d.titulo}</h2>
              <div class="grid md:grid-cols-3 gap-[2cqw] mt-[3cqw]">
                {d.tarjetas.map((t) => (
                  <div class="panel">
                    <p class="etiqueta">{t.titulo}</p>
                    <p class="texto mt-[0.8cqw] text-white">{t.texto}</p>
                  </div>
                ))}
              </div>
              {d.pie && <p class="texto-chico mt-[2.5cqw]">{d.pie}</p>}
            </div>
          )}

          {d.tipo === "caza" && (
            <div class="flex flex-col h-full">
              <p class="kicker">{d.kicker}</p>
              <h2 class="titulo">{d.titulo}</h2>
              <p class="texto-chico mt-[0.6cqw]">¿Qué principio usa cada mensaje? Anótenlo en su cuaderno.</p>
              <div class="grid md:grid-cols-3 gap-[1.5cqw] mt-[2cqw]">
                {d.casos.map((c, j) => (
                  <div class="panel">
                    <p class="texto text-white">{j + 1}. {c.mensaje}</p>
                    <p class="respuesta-caza" data-respuesta-caza hidden>→ {c.respuesta}</p>
                  </div>
                ))}
              </div>
              <div class="mando">
                <button type="button" class="boton-oro" data-revelar-caza>Revelar respuestas</button>
              </div>
            </div>
          )}

          {d.tipo === "lectura" && (
            <div class="flex flex-col h-full justify-center">
              <p class="kicker">Para leer · la respuesta está en el libro</p>
              <h2 class="titulo">Lo que no te voy a contar</h2>
              <div class="grid md:grid-cols-3 gap-[2cqw] mt-[3cqw]">
                {d.ganchos.map((g) => (
                  <div class="panel">
                    <p class="etiqueta">{g.libro}</p>
                    <p class="texto mt-[0.8cqw] text-white">{g.pregunta}</p>
                    <p class="texto-chico mt-[1cqw]">📖 {g.donde}</p>
                  </div>
                ))}
              </div>
              <p class="texto-chico mt-[2.5cqw]">Consejo: lee en papel o sin notificaciones. En pantalla, los textos largos se entienden peor (Delgado et al., 2018).</p>
            </div>
          )}

          {d.tipo === "reto" && (
            <div class="flex flex-col h-full justify-center">
              <p class="kicker">Llamado a la acción</p>
              <h2 class="titulo">{d.titulo}</h2>
              <p class="texto mt-[1cqw]">Hay dos tipos de personas que salen de este salón: las que dicen «qué interesante» y las que hacen algo.</p>
              <div class="grid md:grid-cols-3 gap-[2cqw] mt-[2.5cqw]">
                {d.niveles.map((n) => (
                  <div class="panel">
                    <p class="etiqueta">{n.nombre}</p>
                    <p class="texto mt-[0.8cqw] text-white">{n.texto}</p>
                  </div>
                ))}
              </div>
              <p class="texto-chico mt-[2.5cqw]">Lo revisamos al inicio de la siguiente clase.</p>
            </div>
          )}

          {d.tipo === "quiz" && (
            <div class="grid md:grid-cols-[1fr_auto] gap-[4cqw] items-center h-full">
              <div>
                <p class="kicker">Evaluación · cuenta para tu calificación</p>
                <h2 class="titulo">Quiz {d.quiz}: {QUIZZES[d.quiz].titulo}</h2>
                <p class="texto mt-[1.5cqw]">{QUIZZES[d.quiz].preguntas.length} preguntas · un solo intento · al terminar ves por qué acertaste o fallaste.</p>
                <p class="url"><span class="whitespace-nowrap">{urlHost}</span><wbr /><span class="whitespace-nowrap">{urlRuta}</span></p>
                <div class="mando justify-start">
                  <button type="button" class="boton-oro" data-abrir-quiz>Abrir quiz</button>
                  <button type="button" class="boton-fantasma" data-cerrar-quiz hidden>Cerrar quiz</button>
                  <span data-entregas class="texto-chico"></span>
                </div>
              </div>
              <div class="qr" set:html={qr} />
            </div>
          )}

          {d.tipo === "fuentes" && (
            <div class="flex flex-col h-full justify-center">
              <p class="kicker">Fuentes</p>
              <h2 class="titulo">No me creas: compruébalo</h2>
              <ul class="mt-[2cqw] space-y-[1cqw]">
                {d.claves.map((c) => {
                  const f = FUENTES_MASTER[c];
                  return (
                    <li class="referencia">
                      {f.cita}{f.url && <> <a href={f.url} target="_blank" rel="noopener" class="text-amber-300/80 hover:text-amber-300 break-all">{f.url}</a></>}
                    </li>
                  );
                })}
              </ul>
            </div>
          )}

          <span class="folio">{i + 1}</span>
        </article>
      ))}

      <div class="controles">
        <button type="button" data-conectar class="en-vivo" title="Votación en vivo">
          <span class="punto"></span><span data-en-vivo-texto>A mano alzada</span>
        </button>
        <button type="button" data-anterior class="boton" aria-label="Diapositiva anterior">←</button>
        <span data-contador class="font-mono-tech text-xs text-white/50 min-w-[3.5rem] text-center">1 / 1</span>
        <button type="button" data-siguiente class="boton" aria-label="Diapositiva siguiente">→</button>
        <button type="button" data-completa class="boton" aria-label="Pantalla completa" title="Pantalla completa (F)">⛶</button>
      </div>
      <div class="progreso"><div data-progreso></div></div>
    </div>

    <p class="text-xs text-slate-500 mt-4 text-center">
      Flechas o espacio para avanzar · <b>F</b> pantalla completa · Para votar en vivo, toca «A mano alzada» y entra con tu cuenta de profesor.
    </p>
  </section>
</Layout>

<style>
  .deck {
    --oro: #e2c275;
    --oro-fuerte: #f5d78e;
    position: relative; aspect-ratio: 16 / 9; overflow: hidden;
    container-type: inline-size;
    border-radius: 1.25rem; border: 1px solid rgba(226, 194, 117, 0.18);
    background:
      radial-gradient(ellipse 80% 60% at 85% 0%, rgba(226, 194, 117, 0.10), transparent 60%),
      radial-gradient(ellipse 60% 50% at 0% 100%, rgba(226, 194, 117, 0.05), transparent 60%),
      #07070b;
    color: rgba(255, 255, 255, 0.78);
  }
  .deck:fullscreen { aspect-ratio: auto; width: 100vw; height: 100vh; border-radius: 0; border: 0; }

  .slide {
    position: absolute; inset: 0; display: none; flex-direction: column;
    padding: 4.5cqw 6cqw 6.5cqw; overflow-y: auto;
  }
  .slide.activa { display: flex; animation: entra 0.45s ease-out; }
  .slide > div { flex: 1; min-height: 0; }
  @keyframes entra { from { opacity: 0; transform: translateY(0.8cqw); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .slide.activa { animation: none; } }

  .centro { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; height: 100%; }
  .kicker { color: var(--oro); font-size: clamp(0.65rem, 1.05cqw, 1rem); font-weight: 700; letter-spacing: 0.28em; text-transform: uppercase; }
  .filete { width: 6cqw; height: 1px; background: var(--oro); margin: 2cqw auto; opacity: 0.7; }
  .modulo { color: var(--oro); font-family: "Playfair Display", serif; font-style: italic; font-size: clamp(1rem, 2.2cqw, 2.2rem); }
  .titulo-xl { font-family: "Playfair Display", serif; font-weight: 800; color: #fff; font-size: clamp(2.2rem, 7.5cqw, 7rem); line-height: 1.02; margin-top: 0.6cqw; }
  .titulo { font-family: "Playfair Display", serif; font-weight: 800; color: #fff; font-size: clamp(1.6rem, 4.3cqw, 4rem); line-height: 1.08; margin-top: 0.8cqw; }
  .subtitulo { font-size: clamp(1rem, 2cqw, 1.9rem); color: rgba(255,255,255,0.7); margin-top: 1.2cqw; max-width: 60cqw; }
  .frase { font-family: "Playfair Display", serif; font-style: italic; color: #fff; font-size: clamp(1.6rem, 4.6cqw, 4.4rem); line-height: 1.15; max-width: 75cqw; }
  .texto { font-size: clamp(0.95rem, 1.65cqw, 1.6rem); line-height: 1.45; }
  .texto-chico { font-size: clamp(0.8rem, 1.2cqw, 1.15rem); color: rgba(255,255,255,0.55); line-height: 1.4; }
  .etiqueta { color: var(--oro); font-size: clamp(0.65rem, 1cqw, 0.95rem); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }
  .panel { border: 1px solid rgba(255,255,255,0.09); border-radius: 1.2cqw; padding: 1.8cqw 2cqw; background: rgba(255,255,255,0.025); }
  .panel-oro { border-color: rgba(226,194,117,0.45); background: rgba(226,194,117,0.06); }
  .fuente { font-size: clamp(0.7rem, 1cqw, 0.95rem); color: rgba(255,255,255,0.4); margin-top: 1cqw; font-family: "Roboto Mono", monospace; }
  .cita-ruiz { font-family: "Playfair Display", serif; font-style: italic; font-size: clamp(1rem, 1.9cqw, 1.8rem); color: rgba(255,255,255,0.85); margin-top: 0.8cqw; }
  .parejas { margin-top: 1.6cqw; font-size: clamp(0.9rem, 1.45cqw, 1.4rem); color: var(--oro-fuerte); }
  .url { font-family: "Roboto Mono", monospace; color: var(--oro-fuerte); font-size: clamp(0.9rem, 2cqw, 1.9rem); margin-top: 0.8cqw; overflow-wrap: anywhere; }
  .qr { width: clamp(9rem, 24cqw, 26rem); background: #fff; border-radius: 1.2cqw; padding: 1cqw; }
  .qr :global(svg) { display: block; width: 100%; height: auto; }

  .contexto { font-size: clamp(0.95rem, 1.6cqw, 1.55rem); line-height: 1.45; margin-top: 1cqw; max-width: 80cqw; }
  .pregunta { font-family: "Playfair Display", serif; font-weight: 800; color: #fff; font-size: clamp(1.3rem, 3.1cqw, 3rem); line-height: 1.12; margin-top: 1.2cqw; }
  .opciones { display: grid; gap: 1cqw; margin-top: 2cqw; list-style: none; padding: 0; }
  .opcion {
    position: relative; overflow: hidden; display: flex; align-items: center; gap: 1.4cqw;
    border: 1px solid rgba(255,255,255,0.12); border-radius: 1cqw; padding: 1cqw 1.6cqw;
    font-size: clamp(0.95rem, 1.7cqw, 1.65rem); color: #fff; transition: border-color .3s, opacity .3s;
  }
  .letra { position: relative; z-index: 1; flex-shrink: 0; width: 2.6cqw; min-width: 1.8rem; aspect-ratio: 1; border-radius: 999px; display: grid; place-items: center; font-weight: 800; color: #07070b; background: var(--oro); font-size: 0.8em; }
  .barra { position: absolute; inset: 0 auto 0 0; width: 0; background: rgba(226,194,117,0.16); transition: width .7s ease; }
  .cuenta { font-family: "Roboto Mono", monospace; color: var(--oro-fuerte); font-size: 0.85em; }
  .deck:not(.revelado-global) .opcion .cuenta:empty { display: none; }
  .opcion.correcta { border-color: var(--oro); box-shadow: 0 0 0 1px var(--oro) inset; }
  .opcion.correcta .barra { background: rgba(226,194,117,0.32); }
  .opcion.apagada { opacity: 0.45; }
  .explicacion { margin-top: 1.6cqw; padding: 1.2cqw 1.6cqw; border-left: 3px solid var(--oro); background: rgba(226,194,117,0.06); color: #fff; font-size: clamp(0.95rem, 1.55cqw, 1.5rem); line-height: 1.4; }
  .respuesta-caza { margin-top: 0.8cqw; color: var(--oro-fuerte); font-weight: 700; font-size: clamp(0.9rem, 1.5cqw, 1.45rem); }
  .referencia { padding-left: 2em; text-indent: -2em; font-size: clamp(0.75rem, 1.2cqw, 1.1rem); line-height: 1.45; }

  .mando { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 1cqw; margin-top: auto; padding-top: 1.5cqw; }
  .boton-oro, .boton-fantasma {
    border-radius: 999px; padding: 0.7cqw 1.8cqw; font-weight: 700; font-size: clamp(0.8rem, 1.15cqw, 1.1rem);
    min-height: 2.25rem; transition: filter .2s, background .2s;
  }
  .boton-oro { background: var(--oro); color: #07070b; }
  .boton-oro:hover { filter: brightness(1.1); }
  .boton-fantasma { border: 1px solid rgba(226,194,117,0.5); color: var(--oro-fuerte); }
  .boton-fantasma:hover { background: rgba(226,194,117,0.1); }

  .folio { position: absolute; left: 2.2cqw; bottom: 1.8cqw; font-family: "Roboto Mono", monospace; font-size: 0.7rem; color: rgba(255,255,255,0.25); }
  .controles { position: absolute; right: 1.5cqw; bottom: 1.4cqw; z-index: 10; display: flex; align-items: center; gap: 0.5rem; }
  .boton { width: 2.4rem; height: 2.4rem; border-radius: 0.7rem; border: 1px solid rgba(255,255,255,0.14); background: rgba(7,7,11,0.85); color: #e5e5e5; }
  .boton:hover { border-color: var(--oro); color: var(--oro); }
  .boton:disabled { opacity: 0.3; cursor: default; }
  .en-vivo { display: inline-flex; align-items: center; gap: 0.45rem; height: 2.4rem; padding: 0 0.9rem; border-radius: 999px; border: 1px solid rgba(255,255,255,0.14); background: rgba(7,7,11,0.85); font-size: 0.72rem; font-family: "Roboto Mono", monospace; color: rgba(255,255,255,0.6); }
  .en-vivo .punto { width: 0.5rem; height: 0.5rem; border-radius: 999px; background: rgba(255,255,255,0.35); }
  .en-vivo.activo { color: #86efac; border-color: rgba(134,239,172,0.4); cursor: default; }
  .en-vivo.activo .punto { background: #4ade80; box-shadow: 0 0 0 3px rgba(74,222,128,0.25); animation: late 1.6s infinite; }
  @keyframes late { 50% { box-shadow: 0 0 0 6px rgba(74,222,128,0.05); } }
  .progreso { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: rgba(255,255,255,0.05); }
  .progreso > div { height: 100%; width: 0; background: var(--oro); transition: width .35s; }

  /* En el teléfono el 16:9 no alcanza: cada diapositiva crece con su texto. */
  @media (max-width: 767px) {
    .deck:not(:fullscreen) { aspect-ratio: auto; }
    .deck:not(:fullscreen) .slide { position: relative; inset: auto; min-height: 75vh; padding: 1.5rem 1.25rem 1.5rem; }
    .deck:not(:fullscreen) .controles { position: static; justify-content: center; flex-wrap: wrap; padding: 0.75rem 0 1.25rem; }
    .deck:not(:fullscreen) .folio { display: none; }
  }
</style>

<script>
  import type { Unsubscribe } from "firebase/firestore";
  import { firebaseConfigurado } from "../../../lib/firebase-config";

  let actual = 0;
  let enVivo = false;
  let votoAbierto: { slide: HTMLElement; clave: string } | null = null;
  let quitarVotos: Unsubscribe | null = null;
  let quitarEntregas: Unsubscribe | null = null;
  let quitarSesion: (() => void) | null = null;
  let quitarConfig: Unsubscribe | null = null;
  let quizzesAbiertos: number[] = [];

  // Firebase se carga solo si hace falta: la presentación a mano alzada no
  // debe esperar a nadie.
  const vivo = () => import("../../../lib/lyc-vivo");
  const alumno = () => import("../../../lib/alumno");

  function deck() { return document.querySelector<HTMLElement>("[data-deck]"); }
  function slides(d: HTMLElement) { return [...d.querySelectorAll<HTMLElement>("[data-slide]")]; }

  // ─── Navegar ───────────────────────────────────────────────────────────────

  async function mostrar(d: HTMLElement, i: number) {
    const todas = slides(d);
    const antes = todas[actual];
    actual = Math.max(0, Math.min(i, todas.length - 1));
    const ahora = todas[actual];
    todas.forEach((s) => s.classList.toggle("activa", s === ahora));
    d.querySelector("[data-contador]")!.textContent = `${actual + 1} / ${todas.length}`;
    (d.querySelector("[data-progreso]") as HTMLElement).style.width = `${((actual + 1) / todas.length) * 100}%`;
    (d.querySelector("[data-anterior]") as HTMLButtonElement).disabled = actual === 0;
    (d.querySelector("[data-siguiente]") as HTMLButtonElement).disabled = actual === todas.length - 1;
    ahora.scrollTop = 0;

    if (antes !== ahora) await alSalir(antes);
    await alEntrar(ahora);
  }

  async function alSalir(s: HTMLElement) {
    if (s.dataset.tipo === "voto" && votoAbierto?.slide === s) await cerrarVoto();
    if (s.dataset.tipo === "quiz") { quitarEntregas?.(); quitarEntregas = null; }
  }

  async function alEntrar(s: HTMLElement) {
    if (!enVivo) return;
    // La pregunta se abre sola al llegar: el profesor no tiene que acordarse
    // de ningún botón. Si ya se votó en esta visita, no se reabre.
    if (s.dataset.tipo === "voto" && !s.dataset.clave) await abrirVoto(s);
    if (s.dataset.tipo === "quiz") seguirEntregas(s);
  }

  // ─── Votaciones ────────────────────────────────────────────────────────────

  async function abrirVoto(s: HTMLElement) {
    const { abrirVotacion, observarVotos } = await vivo();
    try {
      const clave = await abrirVotacion(s.dataset.voto!);
      s.dataset.clave = clave;
      votoAbierto = { slide: s, clave };
      limpiarResultados(s);
      quitarVotos?.();
      quitarVotos = observarVotos(clave, Number(s.dataset.opciones), (conteo, total) => pintarVotos(s, conteo, total));
      (s.querySelector("[data-reabrir]") as HTMLElement).hidden = true;
    } catch {
      avisar(s, "No se pudo abrir la votación. Sigue a mano alzada.");
    }
  }

  async function cerrarVoto() {
    quitarVotos?.(); quitarVotos = null;
    const s = votoAbierto?.slide;
    votoAbierto = null;
    try { (await vivo()).cerrarVotacion(); } catch { /* se cierra al abrir la siguiente */ }
    if (s) (s.querySelector("[data-reabrir]") as HTMLElement).hidden = !enVivo;
  }

  function pintarVotos(s: HTMLElement, conteo: number[], total: number) {
    const etiqueta = s.querySelector("[data-votos]")!;
    etiqueta.textContent = `${total} ${total === 1 ? "voto" : "votos"}`;
    s.dataset.conteo = JSON.stringify(conteo);
    if (s.dataset.revelado) pintarBarras(s);
  }

  function pintarBarras(s: HTMLElement) {
    const conteo: number[] = s.dataset.conteo ? JSON.parse(s.dataset.conteo) : [];
    const total = conteo.reduce((a, b) => a + b, 0);
    s.querySelectorAll<HTMLElement>("[data-opcion]").forEach((op, j) => {
      const n = conteo[j] ?? 0;
      const pct = total ? Math.round((n / total) * 100) : 0;
      (op.querySelector("[data-barra]") as HTMLElement).style.width = `${pct}%`;
      op.querySelector("[data-cuenta]")!.textContent = total ? `${pct}% · ${n}` : "";
    });
  }

  function revelar(s: HTMLElement) {
    s.dataset.revelado = "1";
    const correcta = s.dataset.correcta;
    s.querySelectorAll<HTMLElement>("[data-opcion]").forEach((op) => {
      if (correcta === undefined) return;
      const esta = op.dataset.opcion === correcta;
      op.classList.toggle("correcta", esta);
      op.classList.toggle("apagada", !esta);
    });
    const exp = s.querySelector<HTMLElement>("[data-explicacion]");
    if (exp) exp.hidden = false;
    if (enVivo) pintarBarras(s);
  }

  function limpiarResultados(s: HTMLElement) {
    delete s.dataset.revelado;
    delete s.dataset.conteo;
    s.querySelector("[data-votos]")!.textContent = "0 votos";
    s.querySelectorAll<HTMLElement>("[data-opcion]").forEach((op) => {
      op.classList.remove("correcta", "apagada");
      (op.querySelector("[data-barra]") as HTMLElement).style.width = "0";
      op.querySelector("[data-cuenta]")!.textContent = "";
    });
    const exp = s.querySelector<HTMLElement>("[data-explicacion]");
    if (exp) exp.hidden = true;
  }

  function avisar(s: HTMLElement, texto: string) {
    const etiqueta = s.querySelector("[data-votos], [data-entregas]");
    if (etiqueta) etiqueta.textContent = texto;
  }

  // ─── Quizzes ───────────────────────────────────────────────────────────────

  function seguirEntregas(s: HTMLElement) {
    const n = Number(s.dataset.quiz);
    pintarQuiz(s);
    vivo().then(({ observarEntregasDeHoy }) => {
      quitarEntregas?.();
      quitarEntregas = observarEntregasDeHoy(n, (c) => {
        s.querySelector("[data-entregas]")!.textContent = `${c} ${c === 1 ? "entrega" : "entregas"} hoy`;
      });
    });
  }

  function pintarQuiz(s: HTMLElement) {
    const n = Number(s.dataset.quiz);
    const abierto = quizzesAbiertos.includes(n);
    (s.querySelector("[data-abrir-quiz]") as HTMLElement).hidden = abierto;
    (s.querySelector("[data-cerrar-quiz]") as HTMLElement).hidden = !abierto;
  }

  async function alternarQuiz(s: HTMLElement, abrir: boolean) {
    if (!enVivo) { await conectar(); if (!enVivo) return; }
    const n = Number(s.dataset.quiz);
    const { abrirQuiz, cerrarQuiz } = await vivo();
    try { abrir ? await abrirQuiz(n) : await cerrarQuiz(n); }
    catch { avisar(s, "No se pudo cambiar el quiz. Revisa tu conexión."); }
  }

  // ─── Modo en vivo ──────────────────────────────────────────────────────────

  function pintarEnVivo(d: HTMLElement, texto?: string) {
    const b = d.querySelector<HTMLElement>("[data-conectar]")!;
    b.classList.toggle("activo", enVivo);
    d.querySelector("[data-en-vivo-texto]")!.textContent = texto ?? (enVivo ? "En vivo" : "A mano alzada");
    d.querySelectorAll<HTMLElement>("[data-estado-profe]").forEach((p) => {
      p.textContent = enVivo ? "✓ Votación en vivo conectada." : "";
    });
  }

  async function conectar() {
    const d = deck();
    if (!d || enVivo || !firebaseConfigurado()) return;
    const { entrarConGoogle } = await alumno();
    pintarEnVivo(d, "Conectando…");
    try { await entrarConGoogle(); }
    catch { pintarEnVivo(d); }
  }

  async function seguirSesion(d: HTMLElement) {
    if (!firebaseConfigurado()) return;
    const { observarSesion, esProfesor, sesionPorRedireccion } = await alumno();
    sesionPorRedireccion();
    quitarSesion?.();
    quitarSesion = observarSesion(async (u) => {
      const eraVivo = enVivo;
      enVivo = esProfesor(u);
      pintarEnVivo(d, u && !enVivo ? "Esa cuenta no es de profesor" : undefined);
      if (enVivo && !eraVivo) {
        const { observarConfig } = await vivo();
        quitarConfig?.();
        quitarConfig = observarConfig((c) => {
          quizzesAbiertos = c.quizzes;
          d.querySelectorAll<HTMLElement>("[data-tipo='quiz']").forEach(pintarQuiz);
        });
        await alEntrar(slides(d)[actual]);
      }
    });
  }

  function completa(d: HTMLElement) {
    if (document.fullscreenElement) document.exitFullscreen();
    else d.requestFullscreen?.().catch(() => {});
  }

  // ─── Arranque ──────────────────────────────────────────────────────────────

  document.addEventListener("astro:page-load", () => {
    const d = deck();
    if (!d) return;
    actual = 0;
    enVivo = false;
    mostrar(d, 0);
    pintarEnVivo(d);

    d.querySelector("[data-anterior]")!.addEventListener("click", () => mostrar(d, actual - 1));
    d.querySelector("[data-siguiente]")!.addEventListener("click", () => mostrar(d, actual + 1));
    d.querySelector("[data-completa]")!.addEventListener("click", () => completa(d));
    d.querySelector("[data-conectar]")!.addEventListener("click", conectar);

    for (const s of slides(d)) {
      s.querySelector("[data-revelar]")?.addEventListener("click", () => revelar(s));
      s.querySelector("[data-reabrir]")?.addEventListener("click", () => abrirVoto(s));
      s.querySelector("[data-abrir-quiz]")?.addEventListener("click", () => alternarQuiz(s, true));
      s.querySelector("[data-cerrar-quiz]")?.addEventListener("click", () => alternarQuiz(s, false));
      s.querySelector("[data-revelar-caza]")?.addEventListener("click", () => {
        s.querySelectorAll<HTMLElement>("[data-respuesta-caza]").forEach((r) => (r.hidden = false));
      });
    }

    seguirSesion(d);
  });

  // Al irse de la página: no dejar una votación abierta en los celulares.
  document.addEventListener("astro:before-swap", () => {
    if (votoAbierto) cerrarVoto();
    quitarVotos?.(); quitarEntregas?.(); quitarConfig?.(); quitarSesion?.();
    quitarVotos = quitarEntregas = quitarConfig = null; quitarSesion = null;
  });

  // Una sola vez para todo el sitio; solo actúa si la página tiene presentación.
  document.addEventListener("keydown", (e) => {
    const d = deck();
    if (!d || e.metaKey || e.ctrlKey || e.altKey) return;
    if ((e.target as HTMLElement).closest("input, textarea, select, [contenteditable]")) return;
    if (["ArrowRight", "PageDown", " "].includes(e.key)) { e.preventDefault(); mostrar(d, actual + 1); }
    else if (["ArrowLeft", "PageUp"].includes(e.key)) { e.preventDefault(); mostrar(d, actual - 1); }
    else if (e.key === "Home") mostrar(d, 0);
    else if (e.key === "End") mostrar(d, Infinity);
    else if (e.key === "f" || e.key === "F") completa(d);
  });
</script>
