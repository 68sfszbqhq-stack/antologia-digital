                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- ── FUENTES VERIFICABLES ── -->
      {lecturas.length > 0 && (
        <div class="glass-card rounded-2xl p-6 sm:p-8 border border-white/10">
          <div class="flex items-center justify-between flex-wrap gap-2 mb-2">
            <h3 class="text-xl font-bold text-white flex items-center gap-2">📚 Fuentes y lecturas</h3>
            <span class="text-xs font-mono-tech text-slate-500">// {lecturas.length} fuentes primarias</span>
          </div>
          <p class="text-xs text-slate-400 mb-6">
            Todas las cifras citadas en esta clase salen de aquí. Si vas a usarlas en tu tarea, cítalas desde la fuente original.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {lecturas.map((l) => (
              <a
                href={l.url}
                target="_blank"
                rel="noopener noreferrer"
                class="p-5 rounded-2xl bg-white/5 border border-white/10 hover:border-cyan-400/40 transition-all duration-300 group block"
              >
                <div class="flex items-start justify-between gap-3 mb-2">
                  <h4 class="text-sm font-bold text-white group-hover:text-cyan-400 transition-colors leading-snug">{l.titulo}</h4>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-500 group-hover:text-cyan-400 flex-shrink-0 mt-0.5">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </div>
                <p class="text-xs text-slate-400 leading-relaxed">{l.descripcion}</p>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="text-center pt-4">
        <button class="btn-primary px-8 py-3.5 text-sm font-semibold" data-action="step" data-step="4">
          Ir a la línea del tiempo →
        </button>
      </div>
    </div>

    <!-- ================================================================= -->
    <!-- PASO 4 · LÍNEA DEL TIEMPO                                          -->
    <!-- ================================================================= -->
    <div id="step-4" class="step-content hidden">
      <div class="glass-card rounded-2xl p-6 sm:p-8 border border-white/10">

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 pb-6 border-b border-white/10">
          <div>
            <span class="text-xs font-mono-tech text-amber-400 bg-amber-500/10 border border-amber-500/30 px-3 py-1 rounded-full uppercase tracking-widest inline-block mb-3">
              Fase 4 de 5 · Contexto histórico
            </span>
            <h2 class="text-2xl sm:text-3xl font-black text-white">{cont.hitosTitulo}</h2>
            <p class="text-sm text-slate-400 mt-1 max-w-2xl">{cont.hitosSubtitulo}</p>
          </div>

          <div class="flex flex-wrap gap-2 font-mono-tech text-xs">
            <button class="tl-filter px-3 py-1.5 rounded-lg bg-cyan-500/20 text-cyan-400 border border-cyan-400/40 font-bold" data-action="filter" data-filter="all">Todos</button>
            {catsTimeline.map((c) => (
              <button class="tl-filter px-3 py-1.5 rounded-lg bg-white/5 text-slate-400 border border-white/10 hover:text-white" data-action="filter" data-filter={c}>{c}</button>
            ))}
          </div>
        </div>

        <div class="relative border-l-2 border-cyan-500/30 ml-4 sm:ml-8 pl-6 sm:pl-10 space-y-8 font-mono-tech">
          {cont.hitos.map((hito, hi) => (
            <div id={`hito-${hi}`} class="timeline-item relative group text-xs text-slate-300 scroll-mt-24 rounded-xl transition-all duration-300" data-cat={hito.categoria}>
              <div class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-5 h-5 rounded-full bg-slate-950 border-2 border-cyan-400 group-hover:bg-cyan-400 group-hover:shadow-lg group-hover:shadow-cyan-500/50 transition-all duration-300 flex items-center justify-center">
                <div class="w-1.5 h-1.5 rounded-full bg-cyan-400 group-hover:bg-black"></div>
              </div>

              <div class="glass-card rounded-2xl p-5 border border-white/10 hover:border-cyan-400/40 transition-all duration-300 space-y-2">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-3 flex-wrap">
                    <span class="text-base font-black text-white font-mono-tech">{hito.year}</span>
                    <span class={`tag-badge border ${ac(hito.acento).border} ${ac(hito.acento).text} ${ac(hito.acento).bg}`}>
                      {hito.categoria}
                    </span>
                  </div>
                  <span class="text-[10px] text-slate-500 bg-white/5 px-2.5 py-1 rounded">{hito.era}</span>
                </div>

                <h4 class="text-base font-bold text-white font-sans">{hito.titulo}</h4>
                <div class="text-xs text-cyan-400/90 font-sans font-medium">👤 <strong>Protagonistas:</strong> {hito.pioneros}</div>
                <p class="text-xs text-slate-400 font-sans leading-relaxed">{hito.resumen}</p>

                <div class="text-[11px] font-sans text-slate-300 bg-white/5 p-3 rounded-xl border border-white/5 mt-2">
                  🌍 <strong>Por qué importa:</strong> {hito.impacto}
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="text-center pt-10">
          <button class="btn-primary px-8 py-3.5 text-sm font-semibold" data-action="step" data-step="5">
            Ir a la actividad de evaluación →
          </button>
        </div>
      </div>
    </div>

    <!-- ================================================================= -->
    <!-- PASO 5 · TAREA Y EVALUACIÓN                                        -->
    <!-- ================================================================= -->
    <div id="step-5" class="step-content hidden">
      <div class="glass-card rounded-2xl p-6 sm:p-8 border border-emerald-500/30 bg-emerald-500/5">
        <div class="flex items-center gap-3 mb-4 flex-wrap">
          <span class="tag-badge bg-emerald-500/20 text-emerald-400 border border-emerald-500/40">Actividad de evaluación</span>
          <span class="text-xs font-mono-tech text-slate-500">{modulo.modulo}</span>
        </div>

        <h2 class="text-2xl sm:text-3xl font-black text-white mb-3">{cont.tarea.titulo}</h2>
        <p class="text-sm text-slate-300 leading-relaxed max-w-3xl mb-8">{cont.tarea.descripcion}</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div class="glass-card rounded-xl p-5 border border-white/10 space-y-3 text-xs">
            <h4 class="font-bold text-sm font-mono-tech text-cyan-400">📋 Requisitos de la entrega</h4>
            <ul class="space-y-2 text-slate-300">
              {cont.tarea.requisitos.map((r) => (
                <li class="flex items-start gap-2">
                  <span class="text-cyan-400 mt-0.5 flex-shrink-0">▸</span>
                  <span class="leading-relaxed">{r}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="glass-card rounded-xl p-5 border border-white/10 space-y-3 text-xs">
            <h4 class="font-bold text-sm font-mono-tech text-purple-400">🎯 Rúbrica de evaluación</h4>
            <ul class="space-y-2 text-slate-300">
              {cont.tarea.rubrica.map((r, i) => (
                <li class={`flex justify-between gap-4 ${i < cont.tarea.rubrica.length - 1 ? "border-b border-white/5 pb-1.5" : ""}`}>
                  <span class="leading-relaxed">{r.criterio}</span>
                  <span class="font-mono-tech text-purple-400 font-bold flex-shrink-0">{r.peso} %</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="glass-card rounded-2xl p-6 border border-cyan-500/30 bg-cyan-500/5 mb-8">
          <h3 class="text-sm font-mono-tech text-cyan-400 uppercase tracking-widest mb-2">🛠️ {cont.tarea.simuladorTitulo}</h3>
          <p class="text-xs text-slate-400 mb-4">{cont.tarea.simuladorAyuda}</p>

          <div class="flex flex-col sm:flex-row gap-3 mb-4">
            <input
              type="text"
              id="sim-clave-input"
              placeholder={cont.tarea.phClave}
              class="bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 text-xs font-mono-tech text-white focus:border-cyan-400 focus:outline-none w-full sm:w-52"
            />
            <input
              type="text"
              id="sim-texto-input"
              placeholder={cont.tarea.phTexto}
              class="bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 text-xs text-white focus:border-cyan-400 focus:outline-none flex-1"
            />
            <button class="btn-primary text-xs font-mono-tech px-5 py-2.5 flex-shrink-0" data-action="add-sim">
              + Agregar
            </button>
          </div>

          <div id="sim-list" class="space-y-2 font-mono-tech text-xs">
            {cont.tarea.ejemplos.map((e) => (
              <div class="p-3 rounded-lg bg-white/5 border border-white/5 flex items-center justify-between gap-3 text-slate-300">
                <span><strong class="text-cyan-400">{e.clave}:</strong> {e.texto}</span>
                <span class="text-[10px] text-slate-500 flex-shrink-0">Ejemplo</span>
              </div>
            ))}
          </div>
        </div>

        <div class="text-center pt-2">
          <button class="btn-primary px-8 py-3.5 text-sm font-semibold" data-action="guardar">
            💾 Guardar borrador
          </button>
          <p id="save-status" class="hidden text-xs font-mono-tech text-emerald-400 mt-4"></p>
        </div>
      </div>
    </div>

    <!-- ─── NAVEGACIÓN ENTRE MÓDULOS ─── -->
    <div class="flex flex-col sm:flex-row items-stretch justify-between gap-4 mt-12">
      {prevModulo ? (
        <a href={u(`/sesion/${prevModulo.dia}`)} class="glass-card rounded-2xl p-5 border border-white/10 hover:border-cyan-400/40 transition-all duration-300 flex-1 group">
          <span class="text-[10px] font-mono-tech text-slate-500 uppercase tracking-widest block mb-1">← Módulo anterior</span>
          <span class="text-sm font-bold text-white group-hover:text-cyan-400 transition-colors">{prevModulo.modulo}: {prevModulo.titulo}</span>
        </a>
      ) : <div class="flex-1"></div>}

      {nextModulo ? (
        <a href={u(`/sesion/${nextModulo.dia}`)} class="glass-card rounded-2xl p-5 border border-white/10 hover:border-cyan-400/40 transition-all duration-300 flex-1 text-right group">
          <span class="text-[10px] font-mono-tech text-slate-500 uppercase tracking-widest block mb-1">Módulo siguiente →</span>
          <span class="text-sm font-bold text-white group-hover:text-cyan-400 transition-colors">{nextModulo.modulo}: {nextModulo.titulo}</span>
        </a>
      ) : <div class="flex-1"></div>}
    </div>

    <!-- Configuración del cuestionario. Vive en el DOM para que sobreviva
         a la navegación con view transitions del ClientRouter. -->
    <script
      type="application/json"
      id="modulo-config"
      set:html={JSON.stringify({ respuestasCorrectas, categoriasPorPregunta, nombresEjes, totalPreguntas, repasoPorEje, preguntasRepaso, tituloTarea })}
    />

  </div>
</Layout>

<script is:inline>
  // Un solo listener delegado en document. Se registra una vez por pestaña y
  // sobrevive a la navegación con view transitions; el estado se reinicia en
  // cada carga de página leyendo #modulo-config desde el DOM nuevo.
  (function () {
    if (window.__antologiaSesionInit) return;
    window.__antologiaSesionInit = true;

    let cfg = { respuestasCorrectas: [], categoriasPorPregunta: [], nombresEjes: [], totalPreguntas: 0 };
    let currentQIndex = 0;
    let userAnswers = {};
    // Candado de entrega: impide mandar el mismo diagnóstico dos veces por
    // carga de página (p. ej. al volver a abrir la pestaña de resultados).
    let yaEntregado = false;
    // Verdadero cuando las respuestas vienen de un intento ya guardado: se
    // muestra el análisis y el consejo, pero no se entrega nada.
    let modoRevision = false;

    function leerConfig() {
      const el = document.getElementById("modulo-config");
      if (!el) return false;
      try {
        cfg = JSON.parse(el.textContent);
      } catch (e) {
        return false;
      }
      currentQIndex = 0;
      userAnswers = {};
      yaEntregado = false;
      modoRevision = false;
      return true;
    }

    function claseTab(activo, esUltimo) {
      const extra = esUltimo ? " col-span-2 sm:col-span-1" : "";
      return activo
        ? "step-tab flex items-center justify-center gap-2 py-3.5 px-3 rounded-xl border transition-all duration-300 bg-cyan-500/20 text-cyan-400 border-cyan-400/50 font-bold shadow-lg shadow-cyan-500/10" + extra
        : "step-tab flex items-center justify-center gap-2 py-3.5 px-3 rounded-xl border border-white/5 bg-white/5 text-slate-400 hover:text-white transition-all duration-300" + extra;
    }

    // `sinSubir`: no regresar al inicio de la página. Lo usa el consejo, que
    // después baja a una tarjeta; dos desplazamientos suaves seguidos compiten
    // y la página se queda a medio camino.
    function switchStep(stepNum, sinSubir) {
      for (let i = 1; i <= 5; i++) {
        const stepEl = document.getElementById("step-" + i);
        const tabEl = document.getElementById("tab-btn-" + i);
        if (stepEl) stepEl.classList.toggle("hidden", i !== stepNum);
        if (tabEl) {
          tabEl.className = claseTab(i === stepNum, i === 5);
          const badge = tabEl.querySelector("span");
          if (badge) {
            badge.className = i === stepNum
              ? "w-5 h-5 rounded-full bg-cyan-400 text-black flex items-center justify-center text-[10px] font-black"
              : "w-5 h-5 rounded-full bg-white/10 text-slate-400 flex items-center justify-center text-[10px]";
          }
        }
      }
      if (stepNum === 2) calculateResults();
      if (!sinSubir) window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function selectAnswer(qIdx, optIdx) {
      userAnswers[qIdx] = optIdx;
      const correcta = cfg.respuestasCorrectas[qIdx];
      const acerto = optIdx === correcta;

      document.querySelectorAll(".opt-btn-" + qIdx).forEach(function (btn, idx) {
        const base = "opt-btn-" + qIdx + " text-left p-4 rounded-xl border ";
        if (idx === optIdx) {
          btn.className = base + (acerto ? "border-emerald-400/60 bg-emerald-500/20" : "border-red-400/60 bg-red-500/20") + " text-white font-medium flex items-start gap-3";
        } else if (idx === correcta && !acerto) {
          btn.className = base + "border-emerald-400/40 bg-emerald-500/10 text-slate-200 flex items-start gap-3";
        } else {
          btn.className = base + "border-white/5 bg-white/5 opacity-50 text-slate-400 flex items-start gap-3";
        }
      });

      const feedbackEl = document.getElementById("feedback-" + qIdx);
      if (feedbackEl) {
        feedbackEl.classList.remove("hidden");
        feedbackEl.className = acerto
          ? "p-4 rounded-xl border border-emerald-500/30 bg-emerald-500/10 text-emerald-300 text-xs font-mono-tech"
          : "p-4 rounded-xl border border-red-500/30 bg-red-500/10 text-red-300 text-xs font-mono-tech";
        feedbackEl.innerHTML = acerto
          ? "\u2705 <strong>Correcto.</strong>"
          : "\u274C <strong>Incorrecto.</strong> La respuesta correcta est\u00E1 marcada en verde.";
      }

      const explicaEl = document.getElementById("explica-" + qIdx);
      if (explicaEl) explicaEl.classList.remove("hidden");
    }

    function navigateQuiz(dir) {
      const total = cfg.totalPreguntas;
      const nextIdx = currentQIndex + dir;
      if (nextIdx < 0 || nextIdx >= total) return;

      const actual = document.getElementById("q-card-" + currentQIndex);
      const siguiente = document.getElementById("q-card-" + nextIdx);
      if (!actual || !siguiente) return;

      actual.classList.add("hidden");
      siguiente.classList.remove("hidden");
      currentQIndex = nextIdx;

      const progreso = document.getElementById("quiz-progress-text");
      if (progreso) progreso.innerText = "Pregunta " + (currentQIndex + 1) + " de " + total;

      const prevBtn = document.getElementById("prev-q-btn");
      if (prevBtn) prevBtn.disabled = currentQIndex === 0;

      const nextBtn = document.getElementById("next-q-btn");
      if (nextBtn) {
        const ultima = currentQIndex === total - 1;
        nextBtn.innerText = ultima ? "Ver resultados \uD83D\uDCCA" : "Siguiente pregunta \u2192";
        nextBtn.setAttribute("data-action", ultima ? "step" : "nav");
        if (ultima) {
          nextBtn.setAttribute("data-step", "2");
          nextBtn.removeAttribute("data-dir");
        } else {
          nextBtn.setAttribute("data-dir", "1");
          nextBtn.removeAttribute("data-step");
        }
      }
    }

    function calculateResults() {
      const total = cfg.totalPreguntas;
      let score = 0;
      let contestadas = 0;
      const porEje = {};
      cfg.nombresEjes.forEach(function (n) { porEje[n] = { ok: 0, total: 0 }; });

      for (let i = 0; i < total; i++) {
        const cat = cfg.categoriasPorPregunta[i];
        if (porEje[cat]) porEje[cat].total++;
        if (userAnswers[i] !== undefined) contestadas++;
        if (userAnswers[i] === cfg.respuestasCorrectas[i]) {
          score++;
          if (porEje[cat]) porEje[cat].ok++;
        }
      }

      const pct = total > 0 ? Math.round((score / total) * 100) : 0;
      const set = function (id, txt) { const el = document.getElementById(id); if (el) el.innerText = txt; };

      set("user-score-display", score + " / " + total);
      set("user-score-pct", pct + " % de aciertos");
      set("user-answered", contestadas + " / " + total);
      set("user-answered-note", contestadas === total
        ? "Cuestionario completo"
        : "Faltan " + (total - contestadas) + " por contestar");

      const levelBadge = document.getElementById("user-level-badge");
      if (levelBadge) {
        let texto, clase;
        if (contestadas === 0) { texto = "Sin contestar"; clase = "text-slate-400"; }
        else if (pct >= 80)    { texto = "\uD83C\uDF1F Avanzado"; clase = "text-emerald-400"; }
        else if (pct >= 50)    { texto = "\u26A1 Intermedio"; clase = "text-cyan-400"; }
        else                   { texto = "\uD83D\uDCD8 En aprendizaje"; clase = "text-amber-400"; }
        levelBadge.innerText = texto;
        levelBadge.className = "text-lg font-bold " + clase + " font-mono-tech mt-2";
      }

      setTimeout(function () {
        cfg.nombresEjes.forEach(function (nombre, i) {
          const d = porEje[nombre] || { ok: 0, total: 0 };
          const valor = d.total > 0 ? Math.round((d.ok / d.total) * 100) : 0;
          const bar = document.getElementById("bar-" + i);
          const val = document.getElementById("chart-val-" + i);
          if (bar) bar.style.width = valor + "%";
          if (val) val.innerText = valor + " %  (" + d.ok + "/" + d.total + ")";
        });
      }, 100);

      // Solo se entrega con el cuestionario completo. Las pestañas se pueden
      // tocar en cualquier momento, y antes bastaba con abrir "Resultados" a
      // medio contestar para mandar el intento incompleto —y como es de un solo
      // intento, el alumno ya no podía terminarlo. En modo revisión (alguien
      // que ya entregó) no se entrega nada: solo se vuelve a mostrar.
      if (contestadas === total || modoRevision) {
        pintarConsejo(total, pct, porEje);
        entregarDiagnostico(score, total, pct, porEje);
      } else {
        esperarConsejo(total - contestadas, contestadas === 0);
      }
    }

    // ─── Consejo para mejorar ────────────────────────────────────────────────
    //
    // Sale de las respuestas reales, sin nada inventado: el eje más bajo, las
    // preguntas que falló (con la respuesta correcta y su porqué, que ya vienen
    // en los datos del módulo) y los conceptos, hitos o recursos que el propio
    // módulo tiene para ese eje (campo `repasar`).

    function nodo(tag, clase, texto) {
      const n = document.createElement(tag);
      if (clase) n.className = clase;
      if (texto != null) n.textContent = texto;
      return n;
    }

    function esperarConsejo(faltan, nada) {
      const caja = document.getElementById("consejo");
      const aviso = document.getElementById("consejo-incompleto");
      if (caja) caja.classList.add("hidden");
      if (!aviso) return;
      aviso.textContent = nada
        ? "Primero contesta el diagnóstico del paso 1. Con tus respuestas se arma aquí tu consejo para mejorar."
        : "Te " + (faltan === 1 ? "falta 1 pregunta" : "faltan " + faltan + " preguntas") +
          ". Cuando contestes todas aparecerá aquí tu consejo para mejorar.";
      aviso.classList.remove("hidden");
    }

    function pintarConsejo(total, pct, porEje) {
      const caja = document.getElementById("consejo");
      if (!caja) return;
      const aviso = document.getElementById("consejo-incompleto");
      if (aviso) aviso.classList.add("hidden");

      // Del eje más flojo al más fuerte. En empate, primero el que tiene más
      // preguntas falladas (ahí hay más que ganar) y luego el orden del módulo.
      const flojos = cfg.nombresEjes
        .map(function (nombre, i) {
          const d = porEje[nombre] || { ok: 0, total: 0 };
          return { nombre: nombre, i: i, ok: d.ok, total: d.total };
        })
        .filter(function (e) { return e.total > 0 && e.ok < e.total; })
        .sort(function (a, b) {
          return (a.ok / a.total) - (b.ok / b.total) || (b.total - b.ok) - (a.total - a.ok) || a.i - b.i;
        });

      const set = function (id, txt) { const el = document.getElementById(id); if (el) el.textContent = txt; };
      const foco = flojos[0];
      const segundo = flojos[1];

      if (!foco) {
        set("consejo-titular", "Acertaste las " + total + ": dominas este módulo.");
        set("consejo-texto", "No te quedes solo con el diagnóstico. En la clase busca el dato que no conocías y en la actividad apunta a cumplir la rúbrica completa.");
        set("consejo-cierre", "Tu reto: explícale a un compañero el tema que a él le costó. Enseñarlo es la mejor prueba de que lo entendiste.");
      } else {
        const detalle = "acertaste " + foco.ok + " de " + foco.total;
        const luego = segundo ? " Después sigue con «" + segundo.nombre + "»." : "";
        if (pct >= 80) {
          set("consejo-titular", "Vas muy bien. Para cerrar el módulo, afina «" + foco.nombre + "».");
          set("consejo-texto", (flojos.length === 1 ? "Es lo único que se te escapó: " : "Ahí ") + detalle + ". Repasa lo de abajo y lo tienes.");
        } else if (pct >= 50) {
          set("consejo-titular", "Tienes buena base. Tu siguiente paso es reforzar «" + foco.nombre + "».");
          set("consejo-texto", "Ahí " + detalle + "." + luego + " Empieza por lo de abajo antes de pasar a la actividad.");
        } else {
          set("consejo-titular", "Este tema es nuevo para ti, y está bien: para eso es la clase.");
          set("consejo-texto", "Empieza por «" + foco.nombre + "», donde " + detalle + "." + luego + " No intentes verlo todo de golpe: un tema a la vez.");
        }
        set("consejo-cierre", "Cuando hagas la actividad «" + cfg.tituloTarea + "», pon especial atención en «" + foco.nombre + "»: es donde más puedes subir.");
      }

      pintarRepaso(foco ? cfg.repasoPorEje[foco.i] : []);
      pintarErrores(flojos, foco);
      caja.classList.remove("hidden");
    }

    function pintarRepaso(items) {
      const bloque = document.getElementById("consejo-repaso");
      const lista = document.getElementById("consejo-repaso-lista");
      if (!bloque || !lista) return;
      lista.textContent = "";
      const ICONO = { concepto: "📘 ", hito: "🕰️ ", lectura: "📄 ", video: "▶️ " };
      const clase = "text-left text-xs px-3 py-2 rounded-lg border border-amber-400/30 bg-amber-400/5 text-amber-100 hover:bg-amber-400/15 hover:border-amber-400/60 transition";
      (items || []).forEach(function (it) {
        let n;
        if (it.url) {
          n = nodo("a", clase, ICONO[it.tipo] + it.titulo + " ↗");
          n.href = it.url;
          n.target = "_blank";
          n.rel = "noopener noreferrer";
        } else {
          n = nodo("button", clase, ICONO[it.tipo] + it.titulo);
          n.type = "button";
          n.setAttribute("data-action", "ir-repaso");
          n.setAttribute("data-paso", String(it.paso));
          n.setAttribute("data-destino", it.destino);
        }
        lista.appendChild(n);
      });
      bloque.classList.toggle("hidden", !lista.children.length);
    }

    // Las del eje en foco van a la vista; las demás, plegadas, para no
    // enterrar al alumno bajo diez explicaciones de golpe.
    function pintarErrores(flojos, foco) {
      const bloque = document.getElementById("consejo-errores");
      const lista = document.getElementById("consejo-errores-lista");
      if (!bloque || !lista) return;
      lista.textContent = "";

      const fallos = function (eje) {
        const out = [];
        for (let i = 0; i < cfg.totalPreguntas; i++) {
          if (cfg.categoriasPorPregunta[i] === eje && userAnswers[i] !== cfg.respuestasCorrectas[i]) out.push(i);
        }
        return out;
      };
      const tarjeta = function (i) {
        const p = cfg.preguntasRepaso[i];
        const t = nodo("div", "rounded-xl bg-black/20 border border-white/5 p-4");
        t.appendChild(nodo("p", "text-sm text-white font-semibold leading-snug mb-2", p.pregunta));
        t.appendChild(nodo("p", "text-xs text-emerald-300 mb-1",
          (userAnswers[i] === undefined ? "No la contestaste. " : "") + "Respuesta correcta: " + p.correcta));
        t.appendChild(nodo("p", "text-xs text-slate-400 leading-relaxed", p.explicacion));
        return t;
      };

      if (foco) fallos(foco.nombre).forEach(function (i) { lista.appendChild(tarjeta(i)); });

      const otras = [];
      flojos.slice(1).forEach(function (e) { fallos(e.nombre).forEach(function (i) { otras.push(i); }); });
      if (otras.length) {
        const plegado = nodo("details", "rounded-xl border border-white/5 bg-white/[0.02]");
        plegado.appendChild(nodo("summary", "cursor-pointer text-xs font-mono-tech text-slate-400 hover:text-white px-4 py-3",
          "Ver " + (otras.length === 1 ? "la otra pregunta" : "las otras " + otras.length + " preguntas") + " que fallaste"));
        const dentro = nodo("div", "space-y-3 px-4 pb-4");
        otras.forEach(function (i) { dentro.appendChild(tarjeta(i)); });
        plegado.appendChild(dentro);
        lista.appendChild(plegado);
      }
      bloque.classList.toggle("hidden", !lista.children.length);
    }

    // Lleva a la tarjeta del concepto (paso 3) o al hito (paso 4) y la resalta
    // un momento, para que el alumno no tenga que buscarla.
    function irARepaso(paso, destinoId) {
      // Sin subir al inicio: se baja directo a la tarjeta con UN solo
      // desplazamiento. El pequeño retraso deja que el paso recién mostrado
      // tome su altura real antes de medir a dónde bajar.
      switchStep(paso, true);
      if (paso === 4) {
        const todos = document.querySelector('.tl-filter[data-filter="all"]');
        if (todos) filterTimeline("all", todos);
      }
      setTimeout(function () {
        const destino = document.getElementById(destinoId);
        if (!destino) return;
        destino.scrollIntoView({ behavior: "smooth", block: "center" });
        destino.classList.add("ring-2", "ring-amber-400/70");
        setTimeout(function () { destino.classList.remove("ring-2", "ring-amber-400/70"); }, 2500);
      }, 60);
    }

    // Avisa que el diagnóstico terminó, para que AccesoAlumno lo guarde en
    // Firebase. Este script es `is:inline` y no puede importar módulos, así que
    // los dos lados se hablan con un evento del navegador.
    //
    // Solo se entrega una vez por carga de página (ver `yaEntregado` arriba):
    // sin ese candado, volver a abrir la pestaña de resultados dispararía
    // envíos repetidos.
    function entregarDiagnostico(score, total, pct, porEje) {
      if (yaEntregado) return;
      yaEntregado = true;

      // userAnswers es un objeto disperso; se aplana a lista. -1 = sin contestar.
      const respuestas = [];
      for (let i = 0; i < total; i++) {
        respuestas.push(userAnswers[i] === undefined ? -1 : userAnswers[i]);
      }

      document.dispatchEvent(new CustomEvent("antologia:diagnostico-terminado", {
        detail: {
          aciertos: score,
          total: total,
          porcentaje: pct,
          porEje: porEje,
          respuestas: respuestas,
        },
      }));
    }

    function filterTimeline(cat, btn) {
      document.querySelectorAll(".timeline-item").forEach(function (item) {
        const visible = cat === "all" || item.getAttribute("data-cat") === cat;
        item.style.display = visible ? "block" : "none";
      });
      document.querySelectorAll(".tl-filter").forEach(function (b) {
        b.className = b === btn
          ? "tl-filter px-3 py-1.5 rounded-lg bg-cyan-500/20 text-cyan-400 border border-cyan-400/40 font-bold"
          : "tl-filter px-3 py-1.5 rounded-lg bg-white/5 text-slate-400 border border-white/10 hover:text-white";
      });
    }

    function addSimEntry() {
      const claveInput = document.getElementById("sim-clave-input");
      const textoInput = document.getElementById("sim-texto-input");
      const list = document.getElementById("sim-list");
      if (!claveInput || !textoInput || !list) return;

      const clave = claveInput.value.trim();
      const texto = textoInput.value.trim();
      if (!clave || !texto) return;

      const div = document.createElement("div");
      div.className = "p-3 rounded-lg bg-white/5 border border-cyan-400/30 flex items-center justify-between gap-3 text-slate-200";
      const strong = document.createElement("strong");
      strong.className = "text-cyan-400";
      strong.textContent = clave + ":";
      const span = document.createElement("span");
      span.appendChild(strong);
      span.appendChild(document.createTextNode(" " + texto));
      const tag = document.createElement("span");
      tag.className = "text-[10px] text-emerald-400 flex-shrink-0";
      tag.textContent = "Nuevo";
      div.appendChild(span);
      div.appendChild(tag);
      list.appendChild(div);

      claveInput.value = "";
      textoInput.value = "";
    }

    function guardarBorrador() {
      const status = document.getElementById("save-status");
      if (!status) return;
      status.classList.remove("hidden");
      status.innerText = "\u2705 Borrador registrado en esta sesi\u00F3n. Recuerda subir tu entrega final al portal del alumno.";
    }

    document.addEventListener("click", function (ev) {
      const btn = ev.target.closest("[data-action]");
      if (!btn) return;
      const accion = btn.getAttribute("data-action");

      if (accion === "step") {
        switchStep(parseInt(btn.getAttribute("data-step"), 10));
      } else if (accion === "answer") {
        selectAnswer(parseInt(btn.getAttribute("data-q"), 10), parseInt(btn.getAttribute("data-opt"), 10));
      } else if (accion === "nav") {
        navigateQuiz(parseInt(btn.getAttribute("data-dir"), 10));
      } else if (accion === "filter") {
        filterTimeline(btn.getAttribute("data-filter"), btn);
      } else if (accion === "add-sim") {
        addSimEntry();
      } else if (accion === "guardar") {
        guardarBorrador();
      } else if (accion === "ir-conceptos") {
        const destino = document.getElementById("conceptos-clave");
        if (destino) destino.scrollIntoView({ behavior: "smooth" });
      } else if (accion === "ir-repaso") {
        irARepaso(parseInt(btn.getAttribute("data-paso"), 10), btn.getAttribute("data-destino"));
      }
    });

    // Quien ya entregó: AccesoAlumno manda las respuestas guardadas para que la
    // pestaña de resultados muestre su análisis y su consejo. Se marca como ya
    // entregado para que abrir esa pestaña no intente guardar otra vez.
    document.addEventListener("antologia:intento-previo", function (ev) {
      const r = ev.detail && ev.detail.respuestas;
      if (!Array.isArray(r) || r.length !== cfg.totalPreguntas) return;
      userAnswers = {};
      r.forEach(function (v, i) { if (typeof v === "number" && v >= 0) userAnswers[i] = v; });
      yaEntregado = true;
      modoRevision = true;
    });

    leerConfig();
    document.addEventListener("astro:page-load", leerConfig);
  })();
</script>
