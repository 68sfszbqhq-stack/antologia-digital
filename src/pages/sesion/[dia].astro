            <div class="glass-card rounded-2xl p-6 border border-white/10 hover:border-cyan-400/40 transition-all duration-300">
              <div class="w-full h-36 rounded-xl bg-slate-950 border border-white/10 mb-4 flex items-center justify-center p-3 relative overflow-hidden">
                <svg width="120" height="90" viewBox="0 0 120 90" fill="none">
                  <rect x="30" y="25" width="25" height="40" rx="12" fill="#1e293b" stroke="#f43f5e" stroke-width="2"/>
                  <line x1="42.5" y1="25" x2="42.5" y2="40" stroke="#f43f5e" stroke-width="1.5"/>
                  <circle cx="42.5" cy="35" r="2.5" fill="#f43f5e"/>
                  <rect x="65" y="30" width="35" height="30" rx="3" fill="#1e293b" stroke="#f43f5e" stroke-width="1.5"/>
                  <rect x="70" y="35" width="5" height="5" fill="#f43f5e" opacity="0.6"/>
                  <rect x="78" y="35" width="5" height="5" fill="#f43f5e" opacity="0.6"/>
