---
import Layout from "../../layouts/Layout.astro";
import AccesoAlumno from "../../components/AccesoAlumno.astro";
import sesiones from "../../data/sesiones.json";
import contenido from "../../data/contenido";
import { u } from "../../lib/url";
import { firebaseConfigurado } from "../../lib/firebase-config";

export async function getStaticPaths() {
  return sesiones.map((s) => ({
    params: { dia: String(s.dia) },
    props: { modulo: s },
  }));
}

interface Recurso {
  tipo: string;
  titulo: string;
  url: string;
  descripcion: string;
  canal?: string;
  duracion?: string;
  paginas?: number;
}

interface Modulo {
  dia: number;
  modulo: string;
  titulo: string;
  categoria: string;
  materia: string;
  proposito: string;
  duracion: string;
  temas: string[];
  fases: string[];
  recursos: Recurso[];
}

interface Props {
  modulo: Modulo;
}

const { modulo } = Astro.props;
const cont = contenido[modulo.dia];

const allDays = sesiones.map((s) => s.dia);
const currentIdx = allDays.indexOf(modulo.dia);
const prevModulo = currentIdx > 0 ? sesiones[currentIdx - 1] : null;
const nextModulo = currentIdx < sesiones.length - 1 ? sesiones[currentIdx + 1] : null;

const videos = modulo.recursos.filter((r) => r.tipo === "YouTube");
const lecturas = modulo.recursos.filter((r) => r.tipo === "Lectura");

// Categorías presentes en la línea del tiempo de este módulo (para los filtros)
const catsTimeline = [...new Set(cont.hitos.map((h) => h.categoria))];

// Mapa de acentos. Las clases se escriben completas para que Tailwind las detecte.
const ACENTO: Record<string, { text: string; border: string; bg: string; grad: string; dot: string }> = {
  cyan:    { text: "text-cyan-400",    border: "border-cyan-500/40",    bg: "bg-cyan-500/10",    grad: "from-cyan-500 to-blue-500",      dot: "bg-cyan-400"    },
  violet:  { text: "text-violet-400",  border: "border-violet-500/40",  bg: "bg-violet-500/10",  grad: "from-violet-500 to-purple-500",  dot: "bg-violet-400"  },
  amber:   { text: "text-amber-400",   border: "border-amber-500/40",   bg: "bg-amber-500/10",   grad: "from-amber-500 to-orange-500",   dot: "bg-amber-400"   },
  emerald: { text: "text-emerald-400", border: "border-emerald-500/40", bg: "bg-emerald-500/10", grad: "from-emerald-500 to-teal-500",   dot: "bg-emerald-400" },
  rose:    { text: "text-rose-400",    border: "border-rose-500/40",    bg: "bg-rose-500/10",    grad: "from-rose-500 to-pink-500",      dot: "bg-rose-400"    },
  teal:    { text: "text-teal-400",    border: "border-teal-500/40",    bg: "bg-teal-500/10",    grad: "from-teal-500 to-cyan-500",      dot: "bg-teal-400"    },
  blue:    { text: "text-blue-400",    border: "border-blue-500/40",    bg: "bg-blue-500/10",    grad: "from-blue-500 to-indigo-500",    dot: "bg-blue-400"    },
  purple:  { text: "text-purple-400",  border: "border-purple-500/40",  bg: "bg-purple-500/10",  grad: "from-purple-500 to-fuchsia-500", dot: "bg-purple-400"  },
  indigo:  { text: "text-indigo-400",  border: "border-indigo-500/40",  bg: "bg-indigo-500/10",  grad: "from-indigo-500 to-blue-500",    dot: "bg-indigo-400"  },
  sky:     { text: "text-sky-400",     border: "border-sky-500/40",     bg: "bg-sky-500/10",     grad: "from-sky-500 to-cyan-500",       dot: "bg-sky-400"     },
};
const ac = (k: string) => ACENTO[k] ?? ACENTO.cyan;

const categoryColors: Record<string, { border: string; text: string; bg: string }> = {
  "Hardware & Software":      { border: "border-cyan-500/40",    text: "text-cyan-400",    bg: "bg-cyan-500/10"    },
  "Licencias & Redes":        { border: "border-violet-500/40",  text: "text-violet-400",  bg: "bg-violet-500/10"  },
  "Sociedad & Ética":         { border: "border-amber-500/40",   text: "text-amber-400",   bg: "bg-amber-500/10"   },
  "Software Libre":           { border: "border-emerald-500/40", text: "text-emerald-400", bg: "bg-emerald-500/10" },
  "Seguridad & IA":           { border: "border-rose-500/40",    text: "text-rose-400",    bg: "bg-rose-500/10"    },
  "Ciudadanía Digital":       { border: "border-teal-500/40",    text: "text-teal-400",    bg: "bg-teal-500/10"    },
  "Pensamiento Algorítmico":  { border: "border-blue-500/40",    text: "text-blue-400",    bg: "bg-blue-500/10"    },
  "Lógica de Programación":   { border: "border-purple-500/40",  text: "text-purple-400",  bg: "bg-purple-500/10"  },
};
const color = categoryColors[modulo.categoria] ?? { border: "border-cyan-500/40", text: "text-cyan-400", bg: "bg-cyan-500/10" };

// Mientras no haya Firebase configurado, nada se guarda: el aviso al alumno
// tiene que decir la verdad en cada caso, no prometer un registro que no ocurre.
const seRegistra = firebaseConfigurado();

// Datos que necesita el script del navegador
const respuestasCorrectas = cont.preguntas.map((p) => p.correcta);
const categoriasPorPregunta = cont.preguntas.map((p) => p.categoria);
const nombresEjes = cont.ejes.map((e) => e.nombre);
const totalPreguntas = cont.preguntas.length;

// Para el consejo: qué repasar en cada eje. Cada título se busca en los
// conceptos, la línea del tiempo y los recursos de este módulo, en ese orden.
// Si no aparece en ninguno el build truena aquí, con el nombre del eje, en vez
// de publicar un consejo que manda a un lugar que no existe.
const repasoPorEje = cont.ejes.map((eje) => {
  if (!eje.repasar?.length) {
    throw new Error(`Módulo ${modulo.dia}, eje «${eje.nombre}»: falta la lista "repasar".`);
  }
  return eje.repasar.map((titulo) => {
    const c = cont.conceptos.findIndex((k) => k.titulo === titulo);
    if (c >= 0) return { tipo: "concepto", paso: 3, destino: `concepto-${c}`, titulo };
    const h = cont.hitos.findIndex((k) => k.titulo === titulo);
    if (h >= 0) return { tipo: "hito", paso: 4, destino: `hito-${h}`, titulo };
    const r = modulo.recursos.find((k) => k.titulo === titulo && (k.tipo === "Lectura" || k.tipo === "YouTube"));
    if (r) return { tipo: r.tipo === "YouTube" ? "video" : "lectura", url: r.url, titulo };
    throw new Error(`Módulo ${modulo.dia}, eje «${eje.nombre}»: "${titulo}" no es un concepto, hito ni recurso de este módulo.`);
  });
});

const preguntasRepaso = cont.preguntas.map((p) => ({
  pregunta: p.pregunta,
  correcta: p.opciones[p.correcta],
  explicacion: p.explicacion,
}));
const tituloTarea = cont.tarea.titulo;
---

<Layout
  title={`${modulo.modulo}: ${modulo.titulo}`}
  description={modulo.proposito}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">

    <!-- ─── BREADCRUMB ─── -->
    <nav class="flex items-center gap-2 text-xs font-mono-tech text-slate-500 mb-8" aria-label="Navegación de migas de pan">
      <a href={u("/cultura-digital")} class="hover:text-cyan-400 transition-colors">Cultura Digital</a>
      <span class="text-slate-700">/</span>
      <span class="text-slate-400">Presentaciones de Clase</span>
      <span class="text-slate-700">/</span>
      <span class={color.text}>{modulo.modulo}</span>
    </nav>

    <!-- ─── ENCABEZADO Y NAVEGACIÓN POR PASOS ─── -->
    <div class="glass-card rounded-2xl p-5 sm:p-8 mb-10 border border-cyan-500/20" style="box-shadow: 0 0 35px rgba(0, 245, 255, 0.06);">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-8 pb-6 border-b border-white/10">
        <div>
          <div class="flex items-center gap-3 mb-3 flex-wrap">
            <span class={`font-black font-mono-tech text-xs px-3.5 py-1 rounded-md border ${color.bg} ${color.text} ${color.border}`}>
              {modulo.modulo}
            </span>
            <span class="text-xs font-mono-tech text-cyan-400 uppercase tracking-widest bg-cyan-500/10 border border-cyan-500/30 px-3 py-1 rounded-md">
              Cultura Digital · Bachillerato
            </span>
            <span class="text-xs font-mono-tech text-slate-400 bg-white/5 border border-white/10 px-3 py-1 rounded-md">
              {modulo.duracion}
            </span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">{modulo.titulo}</h1>
        </div>
        <div class="flex items-center gap-2 text-xs font-mono-tech text-slate-400 bg-white/5 p-3.5 rounded-xl border border-white/5 flex-shrink-0">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Secuencia Didáctica Activa</span>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 font-mono-tech text-xs">
        {cont.pasos.map((etiqueta, i) => (
          <button
            id={`tab-btn-${i + 1}`}
            class={
              i === 0
                ? "step-tab flex items-center justify-center gap-2 py-3.5 px-3 rounded-xl border transition-all duration-300 bg-cyan-500/20 text-cyan-400 border-cyan-400/50 font-bold shadow-lg shadow-cyan-500/10"
                : `step-tab flex items-center justify-center gap-2 py-3.5 px-3 rounded-xl border border-white/5 bg-white/5 text-slate-400 hover:text-white transition-all duration-300 ${i === 4 ? "col-span-2 sm:col-span-1" : ""}`
            }
            data-action="step"
            data-step={i + 1}
          >
            <span class={i === 0
              ? "w-5 h-5 rounded-full bg-cyan-400 text-black flex items-center justify-center text-[10px] font-black"
              : "w-5 h-5 rounded-full bg-white/10 text-slate-400 flex items-center justify-center text-[10px]"}>
              {i + 1}
            </span>
            {etiqueta}
          </button>
        ))}
      </div>
    </div>

    <!-- ================================================================= -->
    <!-- PASO 1 · EVALUACIÓN DIAGNÓSTICA                                    -->
    <!-- ================================================================= -->
    <div id="step-1" class="step-content">

      <!-- Identifica al alumno y decide si puede contestar. Mientras no lo
           resuelva, #step-1-quiz permanece oculto. -->
      <AccesoAlumno dia={modulo.dia} />

      <div id="step-1-quiz" class="hidden glass-card rounded-2xl p-6 sm:p-8 border border-white/10 mb-8">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8 pb-4 border-b border-white/5">
          <div>
            <span class="text-xs font-mono-tech text-cyan-400 uppercase tracking-widest block mb-1">// Evaluación diagnóstica inicial</span>
            <h2 class="text-2xl font-bold text-white">Prueba de conocimientos previos</h2>
            <p class="text-xs sm:text-sm text-slate-400 mt-1">
              {totalPreguntas} preguntas sobre {modulo.titulo}. {seRegistra
                ? "Tienes un solo intento y tu resultado queda registrado para tu profesor, así que tómate tu tiempo."
                : "Responde con honestidad: es para saber de dónde partimos."}
            </p>
          </div>
          <span id="quiz-progress-text" class="text-xs font-mono-tech text-cyan-400 bg-cyan-500/10 border border-cyan-500/30 px-3.5 py-2 rounded-xl flex-shrink-0">
            Pregunta 1 de {totalPreguntas}
          </span>
        </div>

        <div id="quiz-container">
          {cont.preguntas.map((q, qIndex) => (
            <div id={`q-card-${qIndex}`} class={`quiz-q-card ${qIndex === 0 ? "block" : "hidden"} space-y-6`}>
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-400/30 text-cyan-400 flex items-center justify-center font-black font-mono-tech text-sm flex-shrink-0">
                  {qIndex + 1}
                </div>
                <div class="flex-1">
                  <span class="text-[11px] font-mono-tech text-purple-400 bg-purple-500/10 border border-purple-500/20 px-2.5 py-0.5 rounded-md uppercase tracking-wider mb-2 inline-block">
                    {q.categoria}
                  </span>
                  <h3 class="text-lg sm:text-xl font-bold text-white leading-snug">{q.pregunta}</h3>
                </div>
              </div>

              <div class="grid grid-cols-1 gap-3 pt-2">
                {q.opciones.map((opt, optIndex) => (
                  <button
                    class={`opt-btn-${qIndex} text-left p-4 rounded-xl border border-white/10 bg-white/5 hover:bg-cyan-500/10 hover:border-cyan-400/40 transition-all duration-200 flex items-start gap-3 group`}
                    data-action="answer"
                    data-q={qIndex}
                    data-opt={optIndex}
                  >
                    <span class="w-6 h-6 rounded-lg border border-white/20 bg-white/5 text-xs font-mono-tech flex items-center justify-center text-slate-400 group-hover:border-cyan-400 group-hover:text-cyan-400 flex-shrink-0 mt-0.5">
                      {String.fromCharCode(65 + optIndex)}
                    </span>
                    <span class="text-sm text-slate-300 group-hover:text-white font-medium">{opt}</span>
                  </button>
                ))}
              </div>

              <div id={`feedback-${qIndex}`} class="hidden p-4 rounded-xl border text-sm leading-relaxed"></div>
              <div id={`explica-${qIndex}`} class="hidden text-xs text-slate-400 font-sans leading-relaxed px-4 py-3 rounded-xl bg-white/5 border border-white/5">
                <strong class="text-slate-200">Por qué:</strong> {q.explicacion}
              </div>
            </div>
          ))}
        </div>

        <div class="flex items-center justify-between pt-8 mt-8 border-t border-white/10">
          <button
            id="prev-q-btn"
            class="px-5 py-2.5 rounded-xl border border-white/10 bg-white/5 text-slate-400 hover:text-white hover:border-white/20 transition-all text-xs font-mono-tech disabled:opacity-30 disabled:cursor-not-allowed"
            data-action="nav" data-dir="-1"
            disabled
          >
            ← Pregunta anterior
          </button>
          <button id="next-q-btn" class="btn-primary text-xs font-mono-tech px-6 py-2.5" data-action="nav" data-dir="1">
            Siguiente pregunta →
          </button>
        </div>
      </div>
    </div>

    <!-- ================================================================= -->
    <!-- PASO 2 · RESULTADOS DEL DIAGNÓSTICO                                -->
    <!-- ================================================================= -->
    <div id="step-2" class="step-content hidden">
      <div class="glass-card rounded-2xl p-6 sm:p-8 border border-white/10 mb-8">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="text-xs font-mono-tech text-purple-400 bg-purple-500/10 border border-purple-500/30 px-3 py-1 rounded-full uppercase tracking-widest inline-block mb-3">
            Análisis diagnóstico
          </span>
          <h2 class="text-3xl font-black text-white">Resultados de la evaluación</h2>
          <p class="text-sm text-slate-400 mt-2">
            Tu dominio calculado por cada eje de conocimiento de este módulo. Las barras salen de tus respuestas reales.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-10">
          <div class="glass-card p-6 rounded-2xl border border-cyan-500/30 text-center bg-cyan-500/5">
            <span class="text-xs font-mono-tech text-slate-400 uppercase tracking-widest block mb-1">Tu puntaje</span>
            <div id="user-score-display" class="text-4xl font-black text-cyan-400 font-mono-tech">0 / {totalPreguntas}</div>
            <span id="user-score-pct" class="text-xs font-mono-tech text-cyan-300/70 mt-1 block">0 % de aciertos</span>
          </div>

          <div class="glass-card p-6 rounded-2xl border border-purple-500/30 text-center bg-purple-500/5">
            <span class="text-xs font-mono-tech text-slate-400 uppercase tracking-widest block mb-1">Preguntas contestadas</span>
            <div id="user-answered" class="text-4xl font-black text-purple-400 font-mono-tech">0 / {totalPreguntas}</div>
            <span id="user-answered-note" class="text-xs font-mono-tech text-purple-300/70 mt-1 block">Contéstalas todas para un diagnóstico válido</span>
          </div>

          <div class="glass-card p-6 rounded-2xl border border-emerald-500/30 text-center bg-emerald-500/5">
            <span class="text-xs font-mono-tech text-slate-400 uppercase tracking-widest block mb-1">Nivel diagnóstico</span>
            <div id="user-level-badge" class="text-lg font-bold text-emerald-400 font-mono-tech mt-2">Sin contestar</div>
            <span class="text-xs font-mono-tech text-slate-500 mt-1 block">Punto de partida, no calificación</span>
          </div>
        </div>

        <div class="glass-card rounded-2xl p-6 border border-white/10 mb-8">
          <div class="flex items-center justify-between mb-6 flex-wrap gap-2">
            <h3 class="text-sm font-mono-tech text-cyan-400 uppercase tracking-widest flex items-center gap-2">
              📊 Dominio por eje de conocimiento
            </h3>
            <span class="text-xs font-mono-tech text-slate-500">{modulo.modulo}</span>
          </div>

          <div class="space-y-5">
            {cont.ejes.map((eje, i) => (
              <div>
                <div class="flex justify-between text-xs font-mono-tech mb-1.5 gap-3">
                  <span class="text-slate-300 font-semibold">{i + 1}. {eje.nombre}</span>
                  <span id={`chart-val-${i}`} class={`${ac(eje.acento).text} font-bold flex-shrink-0`}>0 %</span>
                </div>
                <div class="w-full h-4 bg-white/5 rounded-full overflow-hidden p-0.5 border border-white/5">
                  <div id={`bar-${i}`} class={`h-full bg-gradient-to-r ${ac(eje.acento).grad} rounded-full transition-all duration-1000`} style="width: 0%;"></div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- ── CONSEJO PARA MEJORAR ──
             Lo llena el script de abajo con las respuestas reales: el eje más
             bajo, las preguntas que falló y qué repasar de este mismo módulo.
             Solo aparece con el cuestionario completo. -->
        <div id="consejo-incompleto" class="hidden rounded-2xl p-5 border border-white/10 bg-white/[0.03] text-sm text-slate-400 text-center mb-8"></div>

        <div id="consejo" class="hidden glass-card rounded-2xl p-6 sm:p-8 border border-amber-500/30 bg-amber-500/5 mb-8">
          <h3 class="text-sm font-mono-tech text-amber-400 uppercase tracking-widest mb-4">
            💡 Tu consejo para mejorar
          </h3>
          <p id="consejo-titular" class="text-lg sm:text-xl text-white font-bold leading-snug mb-2"></p>
          <p id="consejo-texto" class="text-sm text-slate-300 leading-relaxed"></p>

          <div id="consejo-repaso" class="hidden mt-6">
            <span class="text-[11px] font-mono-tech text-slate-500 uppercase tracking-widest block mb-3">Qué repasar</span>
            <div id="consejo-repaso-lista" class="flex flex-wrap gap-2"></div>
          </div>

          <div id="consejo-errores" class="hidden mt-6">
            <span class="text-[11px] font-mono-tech text-slate-500 uppercase tracking-widest block mb-3">Lo que se te escapó</span>
            <div id="consejo-errores-lista" class="space-y-3"></div>
          </div>

          <p id="consejo-cierre" class="text-sm text-slate-300 leading-relaxed mt-6 pt-4 border-t border-white/10"></p>
        </div>

        <div class="text-center pt-4">
          <button class="btn-primary px-8 py-3.5 text-sm font-semibold" data-action="step" data-step="3">
            Ir a la clase completa →
          </button>
        </div>
      </div>
    </div>

    <!-- ================================================================= -->
    <!-- PASO 3 · LA CLASE (keynote + conceptos + videos)                   -->
    <!-- ================================================================= -->
    <div id="step-3" class="step-content hidden space-y-10">

      <!-- ── APERTURA EN MODO KEYNOTE ── -->
      <div class="glass-card rounded-2xl p-6 sm:p-10 border border-cyan-500/30 bg-cyan-500/5 relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full opacity-20 pointer-events-none" style="background: radial-gradient(circle, #00f5ff 0%, transparent 70%); filter: blur(60px);"></div>

        <div class="relative max-w-4xl">
          <span class="inline-flex items-center gap-2 text-[11px] font-mono-tech text-cyan-400 uppercase tracking-widest mb-5 px-3 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-400/30">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
            Modo keynote · Apertura de la sesión
          </span>

          <h2 class="text-2xl sm:text-4xl lg:text-[2.75rem] font-black text-white leading-[1.15] mb-6 tracking-tight">
            {cont.keynote.gancho}
          </h2>

          <p class="text-sm sm:text-lg text-slate-300 leading-relaxed font-light mb-10">
            {cont.keynote.parrafo}
          </p>

          <!-- Cifras duras -->
          <span class="text-[11px] font-mono-tech text-slate-500 uppercase tracking-widest block mb-3">// Los números sobre la mesa</span>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
            {cont.keynote.datos.map((d) => (
              <div class="p-5 rounded-2xl bg-black/30 border border-white/10 hover:border-cyan-400/30 transition-colors duration-300">
                <div class="text-2xl sm:text-3xl font-black gradient-text font-mono-tech leading-none mb-2">{d.cifra}</div>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">{d.etiqueta}</p>
                <p class="text-[10px] font-mono-tech text-slate-500 mt-2.5 pt-2.5 border-t border-white/5">Fuente: {d.fuente}</p>
              </div>
            ))}
          </div>

          <!-- Momento de atención -->
          <div class="p-5 sm:p-6 rounded-2xl bg-amber-500/10 border border-amber-500/30 mb-8">
            <span class="text-[11px] font-mono-tech text-amber-400 uppercase tracking-widest block mb-2">😏 Pausa para que nadie se duerma</span>
            <p class="text-sm sm:text-base text-amber-100/90 leading-relaxed italic">{cont.keynote.chiste}</p>
          </div>

          <!-- Llamado a la acción -->
          <div class="p-5 sm:p-6 rounded-2xl bg-emerald-500/10 border border-emerald-500/30">
            <span class="text-[11px] font-mono-tech text-emerald-400 uppercase tracking-widest block mb-2">⚡ {cont.keynote.ctaTitulo}</span>
