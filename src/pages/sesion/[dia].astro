                  <line x1="20" y1="45" x2="10" y2="45" stroke="#818cf8" stroke-width="2"/>
                  <line x1="20" y1="65" x2="10" y2="65" stroke="#818cf8" stroke-width="2"/>
                  <line x1="80" y1="25" x2="90" y2="25" stroke="#818cf8" stroke-width="2"/>
                  <line x1="80" y1="45" x2="90" y2="45" stroke="#818cf8" stroke-width="2"/>
                  <line x1="80" y1="65" x2="90" y2="65" stroke="#818cf8" stroke-width="2"/>
                </svg>
                <span class="absolute bottom-2 right-2 text-[10px] font-mono-tech text-indigo-400 bg-indigo-500/10 px-2 py-0.5 rounded">Procesamiento</span>
              </div>
