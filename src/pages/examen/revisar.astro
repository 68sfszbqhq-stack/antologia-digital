---
// Lado del profesor del examen de parcial: abrirlo, ver quién entregó o
// canceló, calificar los textos y descargar el CSV para iDoceo. La seguridad
// está en firestore.rules: con otra cuenta no llega ni un dato.
import Layout from "../../layouts/Layout.astro";
import RevisarExamen from "../../components/RevisarExamen.jsx";
import { u } from "../../lib/url";
---

<Layout title="Revisar examen" description="Calificar el examen del parcial.">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-12">
    <nav class="text-xs font-mono-tech text-slate-500 mb-8">
      <a href={u("/")} class="hover:text-cyan-400 transition">Inicio</a>
      <span class="mx-2">/</span>
      <span class="text-slate-400">Revisar examen</span>
    </nav>
    <RevisarExamen client:only="react" />
  </div>
</Layout>
